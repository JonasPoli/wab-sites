{# E-mail ao jornalista quando a situação muda (App\Service\JournalistNotifier). case: aprovado, reativado, recusado ou suspenso. #}
<!DOCTYPE html>
<html lang="pt-BR">
<body style="margin:0;padding:24px;background:#f5f5f5;font-family:Arial,Helvetica,sans-serif;color:#1f1f1f;font-size:15px;line-height:1.6">
<div style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:8px;padding:28px">
    <p style="margin:0 0 16px">Olá, {{ name }}.</p>
    {% if case == 'aprovado' %}
        <p style="margin:0 0 16px">Seu cadastro como jornalista no portal <strong>{{ site }}</strong> foi aprovado.</p>
    {% elseif case == 'reativado' %}
        <p style="margin:0 0 16px">Seu acesso de jornalista ao portal <strong>{{ site }}</strong> foi reativado.</p>
    {% elseif case == 'recusado' %}
        <p style="margin:0 0 16px">Seu cadastro como jornalista no portal <strong>{{ site }}</strong> não foi aprovado pela administração.</p>
    {% else %}
        <p style="margin:0 0 16px">Seu acesso de jornalista ao portal <strong>{{ site }}</strong> foi suspenso pela administração. Enquanto estiver suspenso, você não consegue entrar nem publicar.</p>
    {% endif %}
    {% if case in ['aprovado', 'reativado'] %}
        <p style="margin:0 0 16px">Para publicar, entre com o seu e-mail (<strong>{{ loginEmail }}</strong>) e a senha que você escolheu no cadastro:</p>
        <p style="margin:0 0 20px"><a href="{{ loginUrl }}" style="display:inline-block;background:{{ color }};color:#ffffff;text-decoration:none;font-weight:bold;padding:12px 20px;border-radius:6px">Entrar no portal</a></p>
        <p style="margin:0 0 16px;font-size:13px;color:#555">Ou copie este endereço: {{ loginUrl }}</p>
        <p style="margin:0 0 16px">Depois de entrar, você vai para a área do jornalista, onde cria e publica as suas notícias.</p>
    {% endif %}
    <p style="margin:0">Equipe do portal {{ site }}</p>
</div>
</body>
</html>
