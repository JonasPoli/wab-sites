<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Página não encontrada — {% if currentTenant is defined and currentTenant %}{{ currentTenant.name }}{% else %}WAB Sites{% endif %}</title>
    <meta name="robots" content="noindex, nofollow">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=optional" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    {% if currentTenant is defined and currentTenant and currentTenant.favicon %}
        <link rel="icon" href="{{ asset('uploads/tenant/favicon/' ~ currentTenant.favicon) }}">
    {% endif %}

    {# Apply theme BEFORE paint to prevent flash #}
    <script>
    (function(){
        var saved = localStorage.getItem('wab-theme') || 'auto';
        var dark = saved === 'auto'
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
            : saved === 'dark';
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        if (dark) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    })();
    </script>

    {% if currentTenant is defined and currentTenant %}
        {{ tenant_css_vars()|raw }}
    {% else %}
    <style>
        :root {
            --color-primary: #7c3aed;
            --color-secondary: #a78bfa;
            --color-primary-rgb: 124,58,237;
            --color-secondary-rgb: 167,139,250;
        }
    </style>
    {% endif %}

    <style>
    /* ── Design Tokens ── */
    :root {
        --font: 'Outfit', system-ui, sans-serif;
        --radius: 16px;
        --ease: cubic-bezier(0.34, 1.56, 0.64, 1);
        --bg:         #ffffff;
        --bg-alt:     #f8fafc;
        --bg-card:    #ffffff;
        --text:       #0f172a;
        --text-muted: #64748b;
        --border:     rgba(0,0,0,.08);
        --header-bg:  rgba(255,255,255,.85);
        --header-border: rgba(0,0,0,.06);
    }
    [data-theme="dark"] {
        --bg:         #060612;
        --bg-alt:     #0d0f1e;
        --bg-card:    #131625;
        --bg-glass:   rgba(6,6,18,.7);
        --text:       #e2e8f0;
        --text-muted: rgba(255,255,255,.45);
        --border:     rgba(255,255,255,.07);
        --header-bg:  rgba(6,1,18,.7);
        --header-border: rgba(255,255,255,.06);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        font-family: var(--font);
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
        transition: background .25s, color .25s;
    }

    a { color: var(--color-secondary); text-decoration: none; }
    a:hover { opacity: .8; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }

    /* ── Mini Header ── */
    .err-header {
        position: fixed; top: 0; left: 0; right: 0; z-index: 100;
        background: var(--header-bg); backdrop-filter: blur(20px) saturate(180%);
        border-bottom: 1px solid var(--header-border);
        height: 70px;
        display: flex; align-items: center;
    }
    .err-header-inner {
        display: flex; align-items: center; justify-content: space-between;
        width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;
    }
    .err-logo-text {
        font-size: 1.4rem; font-weight: 900;
        background: linear-gradient(135deg, var(--color-secondary), var(--color-primary));
        -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .err-logo img { height: 40px; width: auto; object-fit: contain; }

    /* ── Hero Section ── */
    .err-hero {
        flex: 1;
        display: flex; align-items: center; justify-content: center;
        padding: 7rem 1.5rem 4rem;
        position: relative;
        overflow: hidden;
    }

    /* Animated background blobs */
    .err-hero::before,
    .err-hero::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: .25;
        animation: float 8s ease-in-out infinite;
    }
    .err-hero::before {
        width: 600px; height: 600px;
        background: radial-gradient(circle, rgba(var(--color-primary-rgb), .6), transparent 70%);
        top: -150px; left: -200px;
    }
    .err-hero::after {
        width: 500px; height: 500px;
        background: radial-gradient(circle, rgba(var(--color-secondary-rgb), .5), transparent 70%);
        bottom: -100px; right: -150px;
        animation-delay: -4s;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0) scale(1); }
        50% { transform: translateY(-30px) scale(1.05); }
    }

    .err-content {
        position: relative; z-index: 1;
        text-align: center;
        max-width: 640px;
    }

    /* Big 404 number */
    .err-code {
        font-size: clamp(8rem, 20vw, 14rem);
        font-weight: 900;
        line-height: 1;
        background: linear-gradient(135deg,
            rgba(var(--color-primary-rgb), .15) 0%,
            rgba(var(--color-secondary-rgb), .15) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        position: relative;
        display: inline-block;
        letter-spacing: -.05em;
        animation: pulse-glow 3s ease-in-out infinite;
        filter: drop-shadow(0 0 60px rgba(var(--color-primary-rgb), .3));
    }
    [data-theme="dark"] .err-code {
        background: linear-gradient(135deg,
            rgba(var(--color-secondary-rgb), .7) 0%,
            rgba(var(--color-primary-rgb), .9) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    @keyframes pulse-glow {
        0%, 100% { filter: drop-shadow(0 0 40px rgba(var(--color-primary-rgb), .3)); }
        50% { filter: drop-shadow(0 0 80px rgba(var(--color-secondary-rgb), .5)); }
    }

    /* Floating astronaut icon */
    .err-icon {
        font-size: 4rem;
        margin-bottom: 1.5rem;
        display: block;
        animation: float-icon 5s ease-in-out infinite;
        filter: drop-shadow(0 8px 24px rgba(var(--color-primary-rgb), .4));
    }
    @keyframes float-icon {
        0%, 100% { transform: translateY(0) rotate(-5deg); }
        50% { transform: translateY(-15px) rotate(5deg); }
    }

    .err-badge {
        display: inline-flex; align-items: center; gap: .5rem;
        background: linear-gradient(135deg,
            rgba(var(--color-secondary-rgb), .15),
            rgba(var(--color-primary-rgb), .1));
        border: 1px solid rgba(var(--color-secondary-rgb), .3);
        color: var(--color-secondary);
        font-size: .75rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: .1em;
        padding: .35rem 1rem; border-radius: 50px;
        margin-bottom: 1.5rem;
    }
    .glow-dot {
        width: 6px; height: 6px; border-radius: 50%;
        background: var(--color-secondary);
        box-shadow: 0 0 12px var(--color-secondary);
        display: inline-block;
        animation: blink 2s ease-in-out infinite;
    }
    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: .3; }
    }

    .err-title {
        font-size: clamp(1.6rem, 4vw, 2.5rem);
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 1rem;
        color: var(--text);
    }
    [data-theme="dark"] .err-title {
        background: linear-gradient(135deg, #fff 0%, color-mix(in srgb, var(--color-secondary) 60%, #fff) 100%);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }

    .err-desc {
        color: var(--text-muted);
        font-size: 1.05rem;
        margin-bottom: 2.5rem;
        line-height: 1.8;
    }

    .err-actions {
        display: flex; align-items: center; justify-content: center;
        gap: 1rem; flex-wrap: wrap;
    }

    .btn {
        display: inline-flex; align-items: center; gap: .5rem;
        padding: .85rem 2rem; border-radius: 50px; font-weight: 700; font-size: .95rem;
        cursor: pointer; border: none; transition: all .3s cubic-bezier(0.34, 1.56, 0.64, 1);
        letter-spacing: .02em; text-decoration: none;
    }
    .btn-primary {
        background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
        color: #fff;
        box-shadow: 0 8px 32px rgba(var(--color-primary-rgb), .4);
    }
    .btn-primary:hover {
        transform: translateY(-3px) scale(1.02);
        box-shadow: 0 16px 48px rgba(var(--color-primary-rgb), .5);
        opacity: 1;
    }
    .btn-ghost {
        background: var(--bg-card);
        color: var(--text);
        border: 1px solid var(--border);
    }
    .btn-ghost:hover { background: var(--bg-alt); opacity: 1; }

    /* ── Suggestions ── */
    .err-suggestions {
        padding: 3rem 1.5rem;
        background: var(--bg-alt);
        border-top: 1px solid var(--border);
    }
    .err-suggestions-inner {
        max-width: 800px; margin: 0 auto; text-align: center;
    }
    .err-suggestions h2 {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text-muted);
        margin-bottom: 1.5rem;
        text-transform: uppercase;
        letter-spacing: .08em;
    }
    .err-links {
        display: flex; flex-wrap: wrap; gap: .75rem; justify-content: center;
    }
    .err-link-chip {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .55rem 1.2rem; border-radius: 50px;
        background: var(--bg-card);
        border: 1px solid var(--border);
        color: var(--text);
        font-size: .88rem; font-weight: 500;
        transition: all .25s;
    }
    .err-link-chip:hover {
        border-color: var(--color-secondary);
        color: var(--color-secondary);
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(var(--color-secondary-rgb), .2);
        opacity: 1;
    }
    .err-link-chip i { font-size: .8rem; }

    /* ── Footer strip ── */
    .err-footer {
        padding: 1.5rem;
        text-align: center;
        color: var(--text-muted);
        font-size: .82rem;
        border-top: 1px solid var(--border);
    }

    /* ── Orbit decoration ── */
    .err-orbit {
        position: absolute;
        border-radius: 50%;
        border: 1px dashed rgba(var(--color-secondary-rgb), .2);
        animation: orbit-spin 20s linear infinite;
        pointer-events: none;
    }
    .err-orbit-1 {
        width: 300px; height: 300px;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
    }
    .err-orbit-2 {
        width: 500px; height: 500px;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        animation-direction: reverse;
        animation-duration: 30s;
    }
    @keyframes orbit-spin {
        from { transform: translate(-50%, -50%) rotate(0deg); }
        to   { transform: translate(-50%, -50%) rotate(360deg); }
    }

    /* small dot on orbit */
    .err-orbit-dot {
        position: absolute;
        width: 8px; height: 8px;
        border-radius: 50%;
        background: var(--color-secondary);
        box-shadow: 0 0 16px var(--color-secondary);
        top: 0; left: 50%;
        transform: translateX(-50%) translateY(-50%);
    }

    @media (max-width: 640px) {
        .err-orbit { display: none; }
        .err-actions { flex-direction: column; align-items: stretch; }
        .btn { justify-content: center; }
    }

    /* Theme toggle */
    #wab-theme-btn {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .4rem .9rem; border-radius: 50px; border: 1px solid var(--border);
        background: var(--bg-card); color: var(--text); font-size: .82rem;
        font-weight: 600; cursor: pointer; transition: all .2s; white-space: nowrap;
    }
    #wab-theme-btn:hover { border-color: var(--color-secondary); }
    </style>
</head>
<body>

{# ── Mini Header ── #}
<header class="err-header">
    <div class="err-header-inner">
        <a href="{{ path('pub_home') }}" class="err-logo" aria-label="Início">
            {% if currentTenant is defined and currentTenant and currentTenant.logo %}
                <img src="{{ vich_uploader_asset(currentTenant, 'logoFile') }}"
                     alt="{{ currentTenant.name }}"
                     height="40">
            {% else %}
                <span class="err-logo-text">
                    {% if currentTenant is defined and currentTenant %}{{ currentTenant.name }}{% else %}WAB Sites{% endif %}
                </span>
            {% endif %}
        </a>
        <button id="wab-theme-btn" onclick="cycleTheme()" title="Alternar tema">
            <i class="fa-solid fa-circle-half-stroke"></i> Auto
        </button>
    </div>
</header>

{# ── Main Hero ── #}
<section class="err-hero">
    {# Orbit rings decoration #}
    <div class="err-orbit err-orbit-1"><div class="err-orbit-dot"></div></div>
    <div class="err-orbit err-orbit-2"></div>

    <div class="err-content">
        <span class="err-icon">🚀</span>

        <div class="err-badge">
            <span class="glow-dot"></span>
            Erro 404
        </div>

        <div class="err-code" aria-hidden="true">404</div>

        <h1 class="err-title">Ops! Esta página não existe</h1>
        <p class="err-desc">
            Parece que você se aventurou em território desconhecido.<br>
            A página que você procura pode ter sido movida, renomeada ou simplesmente nunca existiu.
        </p>

        <div class="err-actions">
            <a href="{{ path('pub_home') }}" class="btn btn-primary" id="btn-voltar-inicio">
                <i class="fa-solid fa-house"></i>
                Voltar ao início
            </a>
            <button onclick="history.back()" class="btn btn-ghost" id="btn-pagina-anterior">
                <i class="fa-solid fa-arrow-left"></i>
                Página anterior
            </button>
        </div>
    </div>
</section>

{# ── Quick Links ── #}
<div class="err-suggestions">
    <div class="err-suggestions-inner">
        <h2>Talvez você esteja procurando</h2>
        <div class="err-links" id="err-links-container">
            <a href="{{ path('pub_home') }}" class="err-link-chip">
                <i class="fa-solid fa-house"></i> Página inicial
            </a>
            <a href="{{ path('pub_home') }}#contato" class="err-link-chip">
                <i class="fa-solid fa-envelope"></i> Contato
            </a>
            {% if currentTenant is defined and currentTenant and currentTenant.categories is defined %}
                {% for cat in currentTenant.categories|slice(0, 4) %}
                    {% if cat.active is not defined or cat.active %}
                        <a href="{{ path('pub_category', {slug: cat.slug}) }}" class="err-link-chip">
                            {% if cat.icon %}<i class="{{ cat.icon }}"></i>{% endif %}
                            {{ cat.name }}
                        </a>
                    {% endif %}
                {% endfor %}
            {% endif %}
        </div>
    </div>
</div>

{# ── Footer ── #}
<footer class="err-footer">
    &copy; {{ "now"|date("Y") }}
    {% if currentTenant is defined and currentTenant %}{{ currentTenant.name }}{% else %}WAB Sites{% endif %}
    &mdash; Todos os direitos reservados.
</footer>

<script>
// ── Theme Toggle ──────────────────────────────────────────────────────────────
const MODES = ['dark', 'light', 'auto'];
const MODE_LABELS = {
    dark:  '<i class="fa-solid fa-moon"></i> Escuro',
    light: '<i class="fa-solid fa-sun"></i> Claro',
    auto:  '<i class="fa-solid fa-circle-half-stroke"></i> Auto'
};

function applyTheme(mode) {
    const dark = mode === 'auto'
        ? window.matchMedia('(prefers-color-scheme: dark)').matches
        : mode === 'dark';
    document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
    if (dark) {
        document.documentElement.classList.add('dark');
    } else {
        document.documentElement.classList.remove('dark');
    }
    localStorage.setItem('wab-theme', mode);
    const btn = document.getElementById('wab-theme-btn');
    if (btn) btn.innerHTML = MODE_LABELS[mode];
}

function cycleTheme() {
    const cur = localStorage.getItem('wab-theme') || 'auto';
    const next = MODES[(MODES.indexOf(cur) + 1) % MODES.length];
    applyTheme(next);
}

document.addEventListener('DOMContentLoaded', () => {
    const cur = localStorage.getItem('wab-theme') || 'auto';
    const btn = document.getElementById('wab-theme-btn');
    if (btn) btn.innerHTML = MODE_LABELS[cur];
});

window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if ((localStorage.getItem('wab-theme') || 'auto') === 'auto') applyTheme('auto');
});
</script>
</body>
</html>
