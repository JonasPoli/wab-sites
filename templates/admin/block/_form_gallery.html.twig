<form method="post" action="{{ action }}" class="af" enctype="multipart/form-data">
    <input type="hidden" name="type" value="gallery">
    <div class="af-field">
        <label>Pré-título</label>
        <input type="text" name="preTitle" class="ai" value="{{ block.preTitle }}">
    </div>
    <div class="af-field">
        <label>Título <span class="req">*</span></label>
        <input type="text" name="title" class="ai" value="{{ block.title }}" required>
    </div>
    <div class="af-field">
        <label>Texto (opcional)</label>
        <textarea name="text" class="ate" rows="3">{{ block.text }}</textarea>
    </div>
    {% if block.id and block.galleryImages|length %}
    <div class="af-field">
        <label>Imagens atuais</label>
        <div style="display:flex;flex-wrap:wrap;gap:.75rem">
            {% for img in block.galleryImages %}
            <div style="position:relative">
                <img src="{{ asset('uploads/page_block_gallery/' ~ img.filename) }}" style="height:90px;width:90px;object-fit:cover;border-radius:8px;border:1px solid var(--border)">
                <label style="display:flex;align-items:center;gap:.3rem;font-size:.72rem;margin-top:.3rem;color:var(--muted)">
                    <input type="checkbox" name="delete_gallery[]" value="{{ img.id }}" style="accent-color:var(--danger)"> Remover
                </label>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}
    <div class="af-field">
        <label>Adicionar imagens</label>
        <input type="file" name="galleryFiles[]" multiple accept="image/*" class="ai" style="cursor:pointer">
        <p class="af-hint">Selecione múltiplos arquivos de uma vez</p>
    </div>
    <div class="af-actions">
        <button type="submit" class="btn btn-p"><sl-icon name="check-lg"></sl-icon> Salvar</button>
        <a href="{{ path('admin_block_index', {sectionId: block.section.id ?? section.id}) }}" class="btn btn-g">Cancelar</a>
    </div>
</form>
