<form method="post" action="{{ action }}" class="af">
    <input type="hidden" name="type" value="contact">
    
    <div class="af-field">
        <label>Pré-título</label>
        <input type="text" name="preTitle" class="ai" value="{{ block.preTitle }}">
    </div>
    
    <div class="af-field">
        <label>Título <span class="req">*</span></label>
        <input type="text" name="title" class="ai" value="{{ block.title }}" required>
    </div>
    
    <div class="af-field">
        <label>Texto de apoio (HTML / Parágrafo)</label>
        {{ include('admin/_rich_editor.html.twig', {
            field_id: 'block-text',
            field_name: 'text',
            content: block.text,
            height: 200
        }) }}
    </div>

    <div style="margin: 1.5rem 0; padding: 1rem; border-left: 4px solid var(--primary); background: rgba(79, 110, 247, 0.05); border-radius: 0 8px 8px 0;">
        <h4 style="margin: 0 0 0.5rem; font-weight: 700; color: var(--primary); font-size: 0.9rem;">
            <sl-icon name="info-circle" style="vertical-align: middle; margin-right: 0.25rem;"></sl-icon> Informações de Contato do Tenant
        </h4>
        <p style="margin: 0; font-size: 0.8rem; color: var(--muted); line-height: 1.4;">
            As informações de contato exibidas no bloco (Endereço, Telefone, WhatsApp, E-mail, Horários) são buscadas dinamicamente das configurações gerais do Tenant atual (cadastrados em <strong>/superadmin/tenant/{id}/edit</strong>).
        </p>
    </div>

    <div class="af-actions">
        <button type="submit" class="btn btn-p"><sl-icon name="check-lg"></sl-icon> Salvar</button>
        <a href="{{ path('admin_block_index', {sectionId: block.section.id ?? section.id}) }}" class="btn btn-g">Cancelar</a>
    </div>
</form>
