<form method="post" action="{{ action }}" class="af">
    <input type="hidden" name="type" value="newsletter">
    <div class="af-field">
        <label>Pré-título</label>
        <input type="text" name="preTitle" class="ai" value="{{ block.preTitle }}" placeholder="Fique por dentro">
    </div>
    <div class="af-field">
        <label>Título <span class="req">*</span></label>
        <input type="text" name="title" class="ai" value="{{ block.title }}" required placeholder="Assine nossa newsletter">
    </div>
    <div class="af-field">
        <label>Texto de apoio</label>
        <textarea name="text" class="ate" rows="3" placeholder="Receba novidades diretamente no seu e-mail.">{{ block.text }}</textarea>
    </div>
    <div style="margin:1rem 0 .5rem;font-size:.8rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em">Dois blorbs de destaque (opcional)</div>
    {% set cfg = block.config ?? {} %}
    {% for i in 0..1 %}
    {% set b = cfg.blorbs[i] ?? {} %}
    <div class="card" style="margin:0;padding:1rem">
        <div style="font-weight:600;font-size:.83rem;margin-bottom:.75rem">Blorb {{ i+1 }}</div>
        <div class="af-row">
            <div class="af-field">
                <label>Ícone (Font Awesome)</label>
                <div class="icon-picker-wrap">
                    <div class="icon-preview" id="blorb-prev-{{ i }}">{% if b.icon %}<i class="{{ b.icon }}"></i>{% endif %}</div>
                    <input type="text" id="blorb-icon-{{ i }}" name="config[blorbs][{{ i }}][icon]" class="ai" value="{{ b.icon }}" placeholder="fa-solid fa-star" style="flex:1">
                    <button type="button" class="btn btn-g btn-sm" onclick="openIconPicker('blorb-icon-{{ i }}','blorb-prev-{{ i }}')">Escolher</button>
                </div>
            </div>
            <div class="af-field">
                <label>Título do blorb</label>
                <input type="text" name="config[blorbs][{{ i }}][title]" class="ai" value="{{ b.title }}">
            </div>
        </div>
        <div class="af-field">
            <label>Texto do blorb</label>
            <input type="text" name="config[blorbs][{{ i }}][text]" class="ai" value="{{ b.text }}">
        </div>
    </div>
    {% endfor %}
    <div class="af-actions">
        <button type="submit" class="btn btn-p"><sl-icon name="check-lg"></sl-icon> Salvar</button>
        <a href="{{ path('admin_block_index', {sectionId: block.section.id ?? section.id}) }}" class="btn btn-g">Cancelar</a>
    </div>
</form>
