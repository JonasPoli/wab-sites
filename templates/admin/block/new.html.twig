{% extends 'admin/wab_base.html.twig' %}
{% block title %}Novo Bloco{% endblock %}{% block page_title %}Novo Bloco{% endblock %}
{% block body %}
<div class="ph" style="margin-bottom:2rem;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border);padding-bottom:1.5rem">
    <div>
        <h1 style="margin:0;font-size:1.6rem;font-weight:800">
            {% if type %}
                Criando Bloco: <span style="color:var(--primary)">{{ type|replace({'_': ' '})|title }}</span>
            {% else %}
                Escolha o Tipo de Bloco
            {% endif %}
        </h1>
        <div style="display:flex;align-items:center;gap:1rem;margin-top:.5rem;font-size:.85rem;color:var(--muted);flex-wrap:wrap">
            {% if section.page %}
                <span><sl-icon name="file-earmark-text" style="vertical-align:middle"></sl-icon> Página: <strong style="color:var(--text)">{{ section.page.title }}</strong></span>
            {% elseif section.category %}
                <span><sl-icon name="folder" style="vertical-align:middle"></sl-icon> Categoria: <strong style="color:var(--text)">{{ section.category.name }}</strong></span>
            {% endif %}
            <span style="color:var(--border)">|</span>
            <span><sl-icon name="grid-3x3-gap" style="vertical-align:middle"></sl-icon> Seção: <strong style="color:var(--text)">{{ (section.titlePart1 ~ ' ' ~ section.titlePart2)|trim ?: 'Seção #' ~ section.id }}</strong></span>
        </div>
    </div>
    <a href="{{ path('admin_block_index', {sectionId: section.id}) }}" class="btn btn-g"><sl-icon name="arrow-left"></sl-icon> Voltar para Seção</a>
</div>

{% if not type %}
    {# ── Seleção de tipo ── #}
    <div style="margin-bottom:1.5rem;font-size:.95rem;color:var(--muted)">Escolha o tipo de bloco que deseja adicionar nesta seção:</div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem">
        {% set types = [
            {key: 'banner',        label: 'Banner / Destaque',         icon: 'fa-solid fa-image',                desc: 'Banner de destaque com título, descrição, CTA e imagem de fundo'},
            {key: 'text_image',     label: 'Imagem + Texto',           icon: 'fa-solid fa-columns',              desc: 'Texto de um lado, imagem do outro'},
            {key: 'gallery',        label: 'Galeria de Imagens',        icon: 'fa-solid fa-images',               desc: 'Carrossel com múltiplas fotos'},
            {key: 'newsletter',     label: 'Newsletter',                icon: 'fa-solid fa-envelope-open-text',   desc: 'Captura de e-mail com blorbs'},
            {key: 'blurbs4',        label: 'Texto + 4 Blocos',          icon: 'fa-solid fa-th-large',             desc: 'Descrição com quatro ícones'},
            {key: 'stats',          label: 'Estatísticas',              icon: 'fa-solid fa-chart-bar',            desc: 'Números e indicadores'},
            {key: 'news_call',      label: 'Chamada de Notícias',       icon: 'fa-solid fa-newspaper',            desc: 'Exibe notícias recentes'},
            {key: 'map',            label: 'Mapa',                      icon: 'fa-solid fa-map-marker-alt',       desc: 'Embed do Google Maps'},
            {key: 'sub_categories', label: 'Subcategorias',             icon: 'fa-solid fa-sitemap',              desc: 'Grid de subcategorias'},
            {key: 'page_list',      label: 'Lista de Páginas',          icon: 'fa-solid fa-list',                 desc: 'Cards com páginas filtradas'},
            {key: 'testimonials',   label: 'Depoimentos',               icon: 'fa-solid fa-quote-left',           desc: 'Avaliações e depoimentos'},
            {key: 'partner_logos',  label: 'Logos de Parceiros',        icon: 'fa-solid fa-handshake',            desc: 'Linha/grid de logos'},
            {key: 'team',           label: 'Membros da Equipe',         icon: 'fa-solid fa-users',                desc: 'Cards com membros da sua equipe'},
            {key: 'contact',        label: 'Formulário de Contato',     icon: 'fa-solid fa-envelope',             desc: 'Exibe dados de contato e um formulário'},
        ] %}
        {% for t in types %}
        <a href="{{ path('admin_block_new', {sectionId: section.id}) }}?type={{ t.key }}"
           class="card" style="display:flex;flex-direction:column;align-items:center;gap:.75rem;padding:1.5rem 1rem;text-align:center;border:1px solid var(--border);border-radius:12px;transition:all .2s;cursor:pointer;text-decoration:none"
           onmouseover="this.style.borderColor='var(--primary)';this.style.background='rgba(79,110,247,.06)'"
           onmouseout="this.style.borderColor='var(--border)';this.style.background='var(--bg2)'">
            <div style="width:52px;height:52px;background:rgba(79,110,247,.12);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;color:var(--primary)">
                <i class="{{ t.icon }}"></i>
            </div>
            <div>
                <div style="font-weight:700;font-size:.9rem">{{ t.label }}</div>
                <div style="font-size:.75rem;color:var(--muted);margin-top:.25rem">{{ t.desc }}</div>
            </div>
        </a>
        {% endfor %}
    </div>

{% else %}
    {# ── Formulário do tipo selecionado ── #}
    <div class="card">
        {% include 'admin/block/_form_' ~ type ~ '.html.twig' with {
            block: block,
            section: section,
            action: path('admin_block_new', {sectionId: section.id}) ~ '?type=' ~ type,
            categories: categories
        } %}
    </div>
{% endif %}
{% endblock %}
