<form method="post" action="{{ action }}" class="af">
    <input type="hidden" name="type" value="stats">
    <div class="af-field">
        <label>Pré-título</label>
        <input type="text" name="preTitle" class="ai" value="{{ block.preTitle }}">
    </div>
    <div class="af-field">
        <label>Título <span class="req">*</span></label>
        <input type="text" name="title" class="ai" value="{{ block.title }}" required>
    </div>
    <div class="af-field">
        <label>Texto de apoio</label>
        <textarea name="text" class="ate" rows="2">{{ block.text }}</textarea>
    </div>
    <div style="margin:1rem 0 .5rem;font-size:.8rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em">Estatísticas (até 4)</div>
    {% set cfg = block.config ?? {} %}
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem">
    {% for i in 0..3 %}
    {% set s = {number: '', label: '', description: ''}|merge(cfg.stats[i] ?? {}) %}
    <div class="card" style="margin:0;padding:1rem">
        <div style="font-weight:600;font-size:.83rem;margin-bottom:.75rem">Stat {{ i+1 }}</div>
        <div class="af-field">
            <label>Número</label>
            <input type="text" name="config[stats][{{ i }}][number]" class="ai" value="{{ s.number }}" placeholder="1.500+">
        </div>
        <div class="af-field">
            <label>Rótulo</label>
            <input type="text" name="config[stats][{{ i }}][label]" class="ai" value="{{ s.label }}" placeholder="Alunos atendidos">
        </div>
        <div class="af-field">
            <label>Descrição (opcional)</label>
            <input type="text" name="config[stats][{{ i }}][description]" class="ai" value="{{ s.description }}">
        </div>
    </div>
    {% endfor %}
    </div>
    <div class="af-actions">
        <button type="submit" class="btn btn-p"><sl-icon name="check-lg"></sl-icon> Salvar</button>
        <a href="{{ path('admin_block_index', {sectionId: block.section.id ?? section.id}) }}" class="btn btn-g">Cancelar</a>
    </div>
</form>
