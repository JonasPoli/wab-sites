<form method="post" action="{{ action }}" class="af">
    <input type="hidden" name="type" value="page_list">
    <div class="af-field">
        <label>Pré-título</label>
        <input type="text" name="preTitle" class="ai" value="{{ block.preTitle }}">
    </div>
    <div class="af-field">
        <label>Título <span class="req">*</span></label>
        <input type="text" name="title" class="ai" value="{{ block.title }}" required>
    </div>
    <div class="af-field">
        <label>Texto de apoio</label>
        <textarea name="text" class="ate" rows="3">{{ block.text }}</textarea>
    </div>
    <div class="af-row">
        <div class="af-field">
            <label>Filtrar por categoria</label>
            <select name="relatedCategoryId" class="as">
                <option value="">— Todas as categorias —</option>
                {% for cat in categories %}
                <option value="{{ cat.id }}" {{ block.relatedCategory and block.relatedCategory.id == cat.id ? 'selected' }}>{{ cat.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="af-field">
            <label>Quantidade de páginas (0 = todas)</label>
            <input type="number" name="itemCount" class="ai" value="{{ block.itemCount ?? 0 }}" min="0" step="1">
        </div>
    </div>
    <div class="af-actions">
        <button type="submit" class="btn btn-p"><sl-icon name="check-lg"></sl-icon> Salvar</button>
        <a href="{{ path('admin_block_index', {sectionId: block.section.id ?? section.id}) }}" class="btn btn-g">Cancelar</a>
    </div>
</form>
