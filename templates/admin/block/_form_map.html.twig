<form method="post" action="{{ action }}" class="af">
    <input type="hidden" name="type" value="map">
    <div class="af-field">
        <label>Pré-título</label>
        <input type="text" name="preTitle" class="ai" value="{{ block.preTitle }}">
    </div>
    <div class="af-field">
        <label>Título</label>
        <input type="text" name="title" class="ai" value="{{ block.title }}">
    </div>
    <div class="af-field">
        <label>URL de incorporação do Google Maps <span class="req">*</span></label>
        <input type="url" name="embedUrl" class="ai" value="{{ block.embedUrl }}" required placeholder="https://www.google.com/maps/embed?pb=...">
        <p class="af-hint">No Google Maps: Compartilhar → Incorporar um mapa → copie o valor do atributo <code>src</code> do iframe</p>
    </div>
    <div class="af-actions">
        <button type="submit" class="btn btn-p"><sl-icon name="check-lg"></sl-icon> Salvar</button>
        <a href="{{ path('admin_block_index', {sectionId: block.section.id ?? section.id}) }}" class="btn btn-g">Cancelar</a>
    </div>
</form>
