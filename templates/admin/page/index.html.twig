{% extends 'admin/wab_base.html.twig' %}
{% block title %}Páginas{% endblock %}{% block page_title %}Páginas{% endblock %}
{% block body %}
<div class="ph"><h1>Páginas</h1><a href="{{ path('admin_page_new') }}" class="btn btn-p"><sl-icon name="plus-lg"></sl-icon> Nova Página</a></div>
<div class="card"><div class="tw"><table class="at">
    <thead><tr><th style="width:32px"></th><th>Título</th><th>Slug</th><th>Categoria</th><th>Header</th><th>Footer</th><th>Seções</th><th></th></tr></thead>
    <tbody id="pages-sortable">
    {% for page in pages %}
    <tr data-id="{{ page.id }}" style="cursor:grab">
        <td style="color:var(--muted);cursor:grab"><sl-icon name="grip-vertical"></sl-icon></td>
        <td style="font-weight:600">{{ page.title }}</td>
        <td><code style="background:var(--bg3);padding:.2rem .5rem;border-radius:4px;font-size:.8rem">{{ page.slug }}</code></td>
        <td>{% if page.category %}<span class="badge bg-inf">{{ page.category.name }}</span>{% else %}<span style="color:var(--muted);font-size:.8rem">—</span>{% endif %}</td>
        <td><span class="badge {{ page.showInHeader ? 'bg-ok' : 'bg-neu' }}">{{ page.showInHeader ? 'Sim' : 'Não' }}</span></td>
        <td><span class="badge {{ page.showInFooter ? 'bg-ok' : 'bg-neu' }}">{{ page.showInFooter ? 'Sim' : 'Não' }}</span></td>
        <td><span class="badge bg-inf">{{ page.sections|length }}</span></td>
        <td><div class="ta">
            <a href="{{ path('admin_section_index', {pageId: page.id}) }}" class="btn btn-g btn-sm" title="Seções"><sl-icon name="layout-text-sidebar-reverse"></sl-icon></a>
            <a href="{{ path('admin_page_edit', {id: page.id}) }}" class="btn btn-g btn-sm"><sl-icon name="pencil-fill"></sl-icon></a>
            <form action="{{ path('admin_page_duplicate', {id: page.id}) }}" method="post" style="display:inline">
                <input type="hidden" name="_token" value="{{ csrf_token('dup_page_' ~ page.id) }}">
                <button class="btn btn-g btn-sm" title="Duplicar"><sl-icon name="copy"></sl-icon></button>
            </form>
            <form action="{{ path('admin_page_delete', {id: page.id}) }}" method="post" onsubmit="return confirm('Remover página e todas as seções?')" style="display:inline">
                <input type="hidden" name="_token" value="{{ csrf_token('del_page_' ~ page.id) }}">
                <button class="btn btn-d btn-sm"><sl-icon name="trash-fill"></sl-icon></button>
            </form>
        </div></td>
    </tr>
    {% else %}<tr><td colspan="8" style="text-align:center;color:var(--muted);padding:2rem">Nenhuma página.</td></tr>{% endfor %}
    </tbody>
</table></div></div>
{% endblock %}
{% block javascripts %}{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.3/Sortable.min.js"></script>
<script>
const el = document.getElementById('pages-sortable');
if (el) {
    Sortable.create(el, {
        handle: '[name="grip-vertical"]',
        animation: 150,
        ghostClass: 'sortable-ghost',
        onEnd() {
            const ids = [...el.querySelectorAll('tr[data-id]')].map(r => r.dataset.id);
            fetch('{{ path("admin_page_reorder") }}', {
                method:'POST',
                headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
                body: JSON.stringify({ids})
            });
        }
    });
}
</script>
<style>.sortable-ghost{opacity:.4;background:var(--primary-soft)}</style>
{% endblock %}
