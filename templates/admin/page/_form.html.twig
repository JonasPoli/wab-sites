{# Macro: page form — inclui coverImage, categoria, SEO #}
{% macro page_form(page, action, categories) %}
<form action="{{ action }}" method="post" class="af" enctype="multipart/form-data">
    <div class="af-row">
        <div class="af-field"><label>Título <span class="req">*</span></label><input type="text" name="title" class="ai" value="{{ page.title }}" required></div>
        <div class="af-field"><label>Slug</label><input type="text" name="slug" class="ai" value="{{ page.slug }}" placeholder="gerado automaticamente"></div>
    </div>

    <div class="af-row">
        <div class="af-field">
            <label>Categoria</label>
            <select name="categoryId" class="as">
                <option value="">— Sem categoria —</option>
                {% for cat in categories %}
                <option value="{{ cat.id }}" {{ page.category and page.category.id == cat.id ? 'selected' }}>{{ cat.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="af-field">
            <label>Imagem de capa</label>
            <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
                {% if page.coverImage %}
                    <img src="{{ asset('uploads/page_cover/' ~ page.coverImage) }}" id="cover-prev" style="height:64px;border-radius:8px;object-fit:cover;max-width:120px">
                {% else %}
                    <div id="cover-prev" style="width:64px;height:64px;border-radius:8px;background:var(--bg3);border:1px dashed var(--border);display:flex;align-items:center;justify-content:center;color:var(--muted)"><sl-icon name="image"></sl-icon></div>
                {% endif %}
                <label for="cover-up" style="display:inline-flex;align-items:center;gap:.5rem;padding:.4rem 1rem;border-radius:8px;border:1px dashed var(--primary);color:var(--primary);font-size:.82rem;font-weight:600;cursor:pointer"><sl-icon name="upload"></sl-icon> Escolher</label>
                <input type="file" id="cover-up" name="coverImageFile" accept="image/*" style="display:none" onchange="prevCover(this)">
            </div>
        </div>
    </div>

    <div class="af-row">
        <div class="af-field" style="flex-direction:row;align-items:center;gap:.75rem;padding-top:1rem">
            <sl-switch name="showInHeader" value="1" {{ page.showInHeader ? 'checked' : '' }}></sl-switch>
            <label style="color:var(--text)">Exibir no menu de navegação</label>
        </div>
        <div class="af-field" style="flex-direction:row;align-items:center;gap:.75rem;padding-top:1rem">
            <sl-switch name="showInFooter" value="1" {{ page.showInFooter ? 'checked' : '' }}></sl-switch>
            <label style="color:var(--text)">Exibir no rodapé</label>
        </div>
        <div class="af-field" style="flex-direction:row;align-items:center;gap:.75rem;padding-top:1rem">
            <sl-switch name="showTitle" value="1" {{ (page.showTitle ?? true) ? 'checked' : '' }}></sl-switch>
            <label style="color:var(--text)">Exibir título da página (Hero banner)</label>
        </div>
    </div>

    <details>
        <summary style="cursor:pointer;font-weight:600;color:var(--muted);font-size:.85rem;margin-bottom:1rem">⚙ SEO</summary>
        <div class="af" style="margin-top:1rem">
            <div class="af-field"><label>SEO Title</label><input type="text" name="seoTitle" class="ai" value="{{ page.seoTitle }}"></div>
            <div class="af-field"><label>SEO Description</label><textarea name="seoDescription" class="ate" rows="3" style="min-height:70px">{{ page.seoDescription }}</textarea></div>
        </div>
    </details>

    <div class="af-actions">
        <button type="submit" class="btn btn-p"><sl-icon name="check-lg"></sl-icon> Salvar</button>
        <a href="{{ path('admin_page_index') }}" class="btn btn-g">Cancelar</a>
    </div>
</form>
<script>
function prevCover(input) {
    if (!input.files[0]) return;
    const r = new FileReader();
    r.onload = e => {
        let el = document.getElementById('cover-prev');
        if (el.tagName === 'DIV') { const img = document.createElement('img'); img.id='cover-prev'; img.style='height:64px;border-radius:8px;object-fit:cover;max-width:120px'; el.replaceWith(img); el=img; }
        el.src = e.target.result;
    };
    r.readAsDataURL(input.files[0]);
}
</script>
{% endmacro %}
