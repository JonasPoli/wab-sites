{% extends 'admin/wab_base.html.twig' %}
{% block title %}Configurações
{% endblock %}
{% block page_title %}Configurações do Site
{% endblock %}
{% block body %}
	<div class="ph">
		<h1>Configurações</h1>
	</div>
	<div class="card">
		<form
			action="{{ path('admin_settings') }}" method="post" class="af" enctype="multipart/form-data">

			{# ── Página Home ── #}
			<div style="margin:0 0 .75rem;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)">Página Inicial</div>
			<div class="af-field">
				<label>Página usada como Home do site</label>
				<select name="homePageId" class="as">
					<option value="">— Nenhuma (padrão do sistema) —</option>
					{% for page in pages %}
						<option value="{{ page.id }}" {% if tenant.homePage and tenant.homePage.id == page.id %} selected {% endif %}>
							{{ page.title }}
							{% if page.slug %}
								({{ page.slug }})
							{% endif %}
						</option>
					{% endfor %}
				</select>
				<p class="af-hint">Selecione qual página será exibida ao acessar a raiz do site.</p>
			</div>

			{# ── SEO ── #}
			<div style="margin:1.5rem 0 .75rem;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)">SEO e Meta Tags</div>
			<div class="af-field">
				<label>Título padrão do site
					<span class="af-hint" style="display:inline;margin-left:.5rem">(usado quando a página não tem título próprio)</span>
				</label>
				<input type="text" name="seoTitle" class="ai" value="{{ tenant.seoTitle }}" placeholder="Meu Site WAB">
			</div>
			<div class="af-field">
				<label>Meta description padrão</label>
				<textarea name="seoDescription" class="ate" rows="3" placeholder="Descrição do site para mecanismos de busca...">{{ tenant.seoDescription }}</textarea>
			</div>
			<div class="af-field">
				<label>Palavras-chave (meta keywords)</label>
				<input type="text" name="seoKeywords" class="ai" value="{{ tenant.seoKeywords }}" placeholder="palavra1, palavra2, palavra3">
			</div>
			<div class="af-field">
				<label>Open Graph Image (URL)
					<span class="af-hint" style="display:inline;margin-left:.5rem">(imagem usada ao compartilhar nas redes sociais)</span>
				</label>
				<input type="url" name="ogImage" class="ai" value="{{ tenant.ogImage }}" placeholder="https://exemplo.com/og-image.jpg">
			</div>

			{# ── Favicon ── #}
			<div style="margin:1.5rem 0 .75rem;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)">Favicon</div>
			<div class="af-field">
				<label>Favicon do site</label>
				<div style="display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap">
					{% if tenant.favicon %}
						<img id="favicon-prev" src="{{ asset('uploads/tenant/favicon/' ~ tenant.favicon) }}" alt="Favicon atual" style="height:48px;width:48px;object-fit:contain;border-radius:6px;border:1px solid var(--border)">
					{% else %}
						<div id="favicon-prev" style="width:48px;height:48px;border-radius:6px;border:1px dashed var(--border);display:flex;align-items:center;justify-content:center;color:var(--muted)">
							<sl-icon name="image" style="font-size:1.4rem"></sl-icon>
						</div>
					{% endif %}
					<div>
						<label for="favicon-upload" style="display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1.1rem;border-radius:8px;border:1px dashed var(--primary);color:var(--primary);font-size:.85rem;font-weight:600;cursor:pointer">
							<sl-icon name="upload"></sl-icon>
							Selecionar favicon
						</label>
						<input type="file" id="favicon-upload" name="faviconFile" accept="image/x-icon,image/png,image/svg+xml,image/webp" style="display:none" onchange="prevFavicon(this)">
						<p class="af-hint" style="margin-top:.4rem">Recomendado: 32×32 px · ICO, PNG ou SVG</p>
					</div>
				</div>
			</div>

			{# ── Contato ── #}
			<div style="margin:1.5rem 0 .75rem;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)">Contato</div>
			<div class="af-row">
				<div class="af-field">
					<label>E-mail de Contato</label>
					<input type="email" name="contactEmail" class="ai" value="{{ tenant.contactEmail }}" placeholder="contato@exemplo.com.br">
				</div>
				<div class="af-field">
					<label>Telefone</label>
					<input type="text" name="phone" class="ai" value="{{ tenant.phone }}" placeholder="(00) 0000-0000">
				</div>
			</div>
			<div class="af-field">
				<label>Endereço</label>
				<input type="text" name="address" class="ai" value="{{ tenant.address }}" placeholder="Rua Exemplo, 123 — Cidade/UF">
			</div>
			<div class="af-field">
				<label>Google Maps — URL de incorporação
					<span class="af-hint" style="display:inline;margin-left:.5rem">(src do iframe)</span>
				</label>
				<input type="url" name="mapsEmbedUrl" class="ai" value="{{ tenant.mapsEmbedUrl }}" placeholder="https://www.google.com/maps/embed?...">
				<p class="af-hint">No Google Maps: Compartilhar → Incorporar um mapa → copie apenas o valor do atributo
					<code>src</code>
				</p>
			</div>

			{# ── Redes Sociais ── #}
			<div style="margin:1.5rem 0 .75rem;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)">Redes Sociais</div>
			<div class="af-row">
				<div class="af-field">
					<label><twig:ux:icon name="fa6-brands:youtube" style="color:#ff0000;margin-right:.35rem;vertical-align:middle"/>YouTube</label>
					<input type="url" name="youtubeLink" class="ai" value="{{ tenant.youtubeLink }}" placeholder="https://youtube.com/@canal">
				</div>
				<div class="af-field">
					<label><twig:ux:icon name="fa6-brands:instagram" style="color:#e1306c;margin-right:.35rem;vertical-align:middle"/>Instagram</label>
					<input type="url" name="instagramLink" class="ai" value="{{ tenant.instagramLink }}" placeholder="https://instagram.com/perfil">
				</div>
			</div>
			<div class="af-row">
				<div class="af-field">
					<label><twig:ux:icon name="fa6-brands:facebook" style="color:#1877f2;margin-right:.35rem;vertical-align:middle"/>Facebook</label>
					<input type="url" name="facebookLink" class="ai" value="{{ tenant.facebookLink }}" placeholder="https://facebook.com/pagina">
				</div>
				<div class="af-field">
					<label><twig:ux:icon name="fa6-brands:linkedin" style="color:#0a66c2;margin-right:.35rem;vertical-align:middle"/>LinkedIn</label>
					<input type="url" name="linkedinLink" class="ai" value="{{ tenant.linkedinLink }}" placeholder="https://linkedin.com/in/perfil">
				</div>
			</div>
			<div class="af-row">
				<div class="af-field">
					<label><twig:ux:icon name="fa6-brands:whatsapp" style="color:#25d366;margin-right:.35rem;vertical-align:middle"/>WhatsApp</label>
					<input type="url" name="whatsappLink" class="ai" value="{{ tenant.whatsappLink }}" placeholder="https://wa.me/5511999999999">
					<p class="af-hint">Use o formato
						<code>https://wa.me/55DD9XXXXXXXX</code>
					</p>
				</div>
				<div class="af-field"></div>
			</div>

			<div class="af-actions">
				<button type="submit" class="btn btn-p">
					<sl-icon name="check-lg"></sl-icon>
					Salvar Configurações</button>
			</div>
		</form>
	</div>
{% endblock %}
{% block javascripts %}
	{{ parent() }}
	<script>
		function prevFavicon(input) {
if (! input.files || ! input.files[0]) 
return;



const reader = new FileReader();
reader.onload = e => {
let el = document.getElementById('favicon-prev');
if (el.tagName === 'DIV') {
const img = document.createElement('img');
img.id = 'favicon-prev';
img.style.cssText = 'height:48px;width:48px;object-fit:contain;border-radius:6px;border:1px solid var(--border)';
el.replaceWith(img);
el = img;
}
el.src = e.target.result;
};
reader.readAsDataURL(input.files[0]);
}
	</script>
{% endblock %}
