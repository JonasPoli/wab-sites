{#
  Seletor de ícones do painel (FontAwesome): modal com busca, abas e rolagem infinita.
  Uso: um campo de texto e uma prévia com id e um botão que chama
  openIconPicker('<id do campo>', '<id da prévia>'). Precisa do CSS do FontAwesome na página.
  Incluído em admin/wab_base.html.twig e em superadmin/tenant/edit.html.twig (botão flutuante).
#}
<style>
    /* Icon picker */
    .icon-picker-wrap{display:flex;align-items:center;gap:.75rem}
    .icon-preview{width:36px;height:36px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;color:var(--primary)}
    #icon-modal-overlay{display:none;position:fixed;inset:0;background:rgba(10,12,22,.85);backdrop-filter:blur(12px);z-index:9000;align-items:center;justify-content:center;transition:opacity .2s ease}
    #icon-modal-overlay.open{display:flex}
    #icon-modal{background:var(--bg2);border:1px solid rgba(255,255,255,.1);box-shadow:0 25px 60px rgba(0,0,0,.6), 0 0 80px rgba(79,110,247,.06);border-radius:20px;padding:1.75rem;width:min(720px,95vw);max-height:88vh;display:flex;flex-direction:column;gap:1.25rem;animation:modalScale .3s cubic-bezier(0.34, 1.56, 0.64, 1)}
    @keyframes modalScale {
        from { transform: scale(.92); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
    .icon-search-wrap{position:relative;display:flex;align-items:center}
    .icon-search-wrap sl-icon{position:absolute;left:14px;color:var(--muted);font-size:1.2rem}
    .icon-search-wrap input{padding-left:2.75rem;border-radius:12px;height:46px;font-size:.92rem}
    .icon-search-wrap input:focus{box-shadow:0 0 12px rgba(79,110,247,.25);border-color:var(--primary)}
    .icon-tabs{display:flex;gap:.5rem;overflow-x:auto;padding-bottom:.6rem;border-bottom:1px solid var(--border)}
    .icon-tab{padding:.5rem 1.15rem;border-radius:24px;font-size:.78rem;font-weight:600;background:rgba(255,255,255,.02);color:var(--muted);border:1px solid var(--border);cursor:pointer;white-space:nowrap;transition:all var(--ease);font-family:inherit}
    .icon-tab:hover{background:rgba(255,255,255,.06);color:var(--text)}
    .icon-tab.active{background:linear-gradient(135deg, rgba(79,110,247,.2), rgba(79,110,247,.05));color:#818cf8;border-color:var(--primary);box-shadow:0 4px 12px rgba(79,110,247,.15)}
    .icon-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(56px,1fr));gap:.65rem;overflow-y:auto;max-height:380px;padding-right:.25rem}
    /* Custom scrollbar */
    .icon-grid::-webkit-scrollbar{width:6px}
    .icon-grid::-webkit-scrollbar-track{background:transparent}
    .icon-grid::-webkit-scrollbar-thumb{background:rgba(255,255,255,.12);border-radius:10px}
    .icon-grid::-webkit-scrollbar-thumb:hover{background:rgba(255,255,255,.24)}
    .icon-grid button{width:56px;height:56px;background:var(--bg3);border:1px solid var(--border);border-radius:12px;cursor:pointer;color:var(--text);font-size:1.35rem;display:flex;align-items:center;justify-content:center;transition:all .18s cubic-bezier(0.175, 0.885, 0.32, 1.275)}
    .icon-grid button:hover{background:linear-gradient(135deg, var(--primary), #6366f1);border-color:var(--primary);color:#fff;transform:scale(1.15) rotate(3deg);box-shadow:0 6px 18px rgba(79,110,247,.35)}
</style>

{# ── Icon Picker Modal ── #}
<div id="icon-modal-overlay">
    <div id="icon-modal">
        <div style="display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);padding-bottom:.75rem">
            <div style="display:flex;align-items:center;gap:.6rem">
                <sl-icon name="star-fill" style="color:var(--primary);font-size:1.2rem;vertical-align:middle;filter:drop-shadow(0 0 8px rgba(79,110,247,0.4))"></sl-icon>
                <span style="font-weight:800;font-size:1.15rem;letter-spacing:-.01em">Escolher Ícone Font Awesome</span>
            </div>
            <button onclick="closeIconPicker()" style="background:none;border:none;cursor:pointer;color:var(--muted);font-size:1.4rem;display:flex;align-items:center;transition:color var(--ease)" onmouseover="this.style.color='var(--danger)'" onmouseout="this.style.color='var(--muted)'">✕</button>
        </div>
        <div class="icon-search-wrap">
            <sl-icon name="search"></sl-icon>
            <input type="text" id="icon-search" class="ai" placeholder="Pesquisar mais de 1.200 ícones... ex: home, school, facebook" oninput="filterIcons(this.value)">
        </div>
        <div class="icon-tabs" id="icon-tabs-container">
            <button class="icon-tab active" onclick="switchIconTab('all', this)">Todos</button>
            <button class="icon-tab" onclick="switchIconTab('edu', this)">Educação & Cursos</button>
            <button class="icon-tab" onclick="switchIconTab('biz', this)">Negócios & Web</button>
            <button class="icon-tab" onclick="switchIconTab('brands', this)">Marcas & Redes</button>
            <button class="icon-tab" onclick="switchIconTab('media', this)">Interface & Mídia</button>
            <button class="icon-tab" onclick="switchIconTab('health', this)">Saúde & Esporte</button>
            <button class="icon-tab" onclick="switchIconTab('arrows', this)">Setas & Navegação</button>
        </div>
        <div class="icon-grid" id="icon-grid-container"></div>
        
        <!-- Live Preview Pane -->
        <div id="icon-preview-pane" style="display:flex;align-items:center;gap:1.25rem;padding:0.85rem 1.15rem;background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:14px;margin-top:0.25rem;min-height:68px;transition:all var(--ease)">
            <div id="icon-preview-pane-icon" style="font-size:2rem;width:48px;height:48px;background:rgba(79,110,247,0.1);border:1px solid rgba(79,110,247,0.25);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--primary);transition:all .18s ease">
                <i class="fa-solid fa-face-smile"></i>
            </div>
            <div style="display:flex;flex-direction:column;gap:0.2rem">
                <span id="icon-preview-pane-name" style="font-size:0.9rem;font-weight:700;font-family:monospace;color:var(--text);letter-spacing:0.02em">fa-solid fa-face-smile</span>
                <span id="icon-preview-pane-desc" style="font-size:0.76rem;color:var(--muted)">Passe o mouse sobre qualquer ícone da lista para ver os detalhes em tempo real</span>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded',()=>{
    loadIconsFromStylesheets();
    
    // Configura o ouvinte de rolagem infinita (Infinite Scroll)
    const grid = document.getElementById('icon-grid-container');
    if (grid) {
        grid.addEventListener('scroll', function() {
            if (this.scrollTop + this.clientHeight >= this.scrollHeight - 40) {
                appendMoreIcons();
            }
        });
    }
});

