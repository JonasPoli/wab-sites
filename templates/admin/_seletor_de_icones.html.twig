        'cc-discover', 'cc-amex', 'cc-paypal', 'cc-stripe', 'cc-amazon-pay', 'cc-apple-pay',
        'google-wallet', 'btc', 'ethereum', 'bitcoin'
    ];
    if (brands.includes(iconName) || brands.some(b => iconName.startsWith(b + '-'))) {
        return 'fa-brands';
    }
    return 'fa-solid';
}

