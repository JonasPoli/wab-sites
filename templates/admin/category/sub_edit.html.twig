{% extends 'admin/wab_base.html.twig' %}
{% block title %}{{ subcategory.name }}{% endblock %}{% block page_title %}Editar Sub-categoria{% endblock %}
{% block body %}
<div class="ph">
    <h1>{{ subcategory.name }} <small style="color:var(--muted);font-weight:400;font-size:.7em">em {{ category.name }}</small></h1>
    <a href="{{ path('admin_subcategory_index', {id: category.id}) }}" class="btn btn-g"><sl-icon name="arrow-left"></sl-icon> Voltar</a>
</div>
<div class="card"><form action="{{ path('admin_subcategory_edit', {id: subcategory.id}) }}" method="post" class="af">
    <div class="af-group">
        <div class="af-field">
            <label>Nome <span class="req">*</span></label>
            <input type="text" name="name" class="ai" value="{{ subcategory.name }}" required autofocus>
        </div>
        <div class="af-field">
            <label>Slug</label>
            <input type="text" name="slug" class="ai" value="{{ subcategory.slug }}">
        </div>
    </div>
    <div class="af-group">
        <div class="af-field">
            <label>Pré-título</label>
            <input type="text" name="preTitle" class="ai" value="{{ subcategory.preTitle ?? '' }}" placeholder="Ex: Nossa">
        </div>
        <div class="af-field">
            <label>Descrição</label>
            <textarea name="description" class="ai" rows="3">{{ subcategory.description ?? '' }}</textarea>
        </div>
    </div>
    <div class="af-group af-group--inline">
        <label class="af-check">
            <input type="checkbox" name="showInHeader" value="1" {{ subcategory.showInHeader ? 'checked' : '' }}>
            <span>Aparece no menu do <strong>topo</strong></span>
        </label>
        <label class="af-check">
            <input type="checkbox" name="showInFooter" value="1" {{ subcategory.showInFooter ? 'checked' : '' }}>
            <span>Aparece no menu do <strong>rodapé</strong></span>
        </label>
    </div>
    <div class="af-actions"><button type="submit" class="btn btn-p"><sl-icon name="check-lg"></sl-icon> Salvar</button><a href="{{ path('admin_subcategory_index', {id: category.id}) }}" class="btn btn-g">Cancelar</a></div>
</form></div>
{% endblock %}
