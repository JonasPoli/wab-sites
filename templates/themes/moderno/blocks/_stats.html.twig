<div class="wab-block">
    {% if block.preTitle %}<div style="text-align:center"><span class="section-label"><span class="glow-dot"></span>{{ block.preTitle }}</span></div>{% endif %}
    {% if block.title %}<h2 class="section-heading" style="text-align:center;margin-bottom:.5rem">{{ block.title }}</h2>{% endif %}
    {% if block.text %}<p style="color:var(--text-muted);text-align:center;max-width:600px;margin:0 auto 3rem">{{ block.text }}</p>{% endif %}
    <div class="wab-stats">
        {% for i in 1..4 %}
        {% set num = attribute(block.config, 'stat' ~ i ~ '_number') ?? null %}
        {% set lbl = attribute(block.config, 'stat' ~ i ~ '_label') ?? null %}
        {% set desc = attribute(block.config, 'stat' ~ i ~ '_description') ?? null %}
        {% if num %}
        <div class="stat-card">
            <div class="stat-num">{{ num }}</div>
            {% if lbl %}<div class="stat-lbl">{{ lbl }}</div>{% endif %}
            {% if desc %}<div class="stat-desc">{{ desc }}</div>{% endif %}
        </div>
        {% endif %}
        {% endfor %}
    </div>
</div>
<style>
.wab-stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:2rem; text-align:center; }
.stat-card { padding:2rem 1rem; }
.stat-num { font-size:clamp(2rem,5vw,3.5rem); font-weight:900; color:var(--color-secondary); line-height:1; margin-bottom:.5rem; }
.stat-lbl { font-weight:700; color:var(--text); font-size:1rem; }
.stat-desc { color:var(--text-muted); font-size:.85rem; margin-top:.35rem; }
</style>
