{% if (block.config.active ?? '1') == '1' %}
<div class="wab-block banner-block" style="position:relative;border-radius:16px;overflow:hidden;min-height:350px;display:flex;align-items:center;padding:3rem 2rem;margin-bottom:3rem;border:1px solid var(--border);transition:transform .3s ease,box-shadow .3s ease">
    {# Background image with primary overlay #}
    {% if block.image %}
        <div style="position:absolute;inset:0;background-image:url('{{ asset('uploads/page_block/' ~ block.image) }}');background-size:cover;background-position:center;z-index:0;transition:transform .5s ease" class="banner-bg"></div>
        <div style="position:absolute;inset:0;background:var(--color-primary);opacity:.15;z-index:1"></div>
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.2) 0%,rgba(0,0,0,.7) 100%);z-index:1"></div>
    {% else %}
        <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(var(--color-primary-rgb),.15),rgba(var(--color-secondary-rgb),.1));z-index:0"></div>
    {% endif %}

    {# Content Area with Glassmorphism #}
    <div style="position:relative;z-index:2;max-width:800px;width:100%;margin:0 auto;text-align:center;color:#fff" class="banner-glass-card">
        {% if block.preTitle %}
            <span class="banner-pretitle" style="display:inline-block;text-transform:uppercase;letter-spacing:2px;font-size:.8rem;font-weight:700;margin-bottom:1rem;color:var(--color-secondary);background:rgba(0,0,0,.4);padding:.35rem 1rem;border-radius:50px;backdrop-filter:blur(4px)">
                {{ block.preTitle }}
            </span>
        {% endif %}

        <h2 class="banner-title" style="font-size:clamp(1.75rem,4vw,2.75rem);font-weight:900;line-height:1.2;margin-bottom:1rem;text-shadow:0 2px 10px rgba(0,0,0,.5);color:#ffffff">
            {{ block.title }}
        </h2>

        {% if block.text %}
            <p class="banner-text" style="font-size:clamp(1rem,2vw,1.15rem);opacity:.9;line-height:1.6;margin-bottom:2rem;text-shadow:0 1px 5px rgba(0,0,0,.4);color:#f1f5f9">
                {{ block.text }}
            </p>
        {% endif %}

        {% if block.config.ctaText ?? null %}
            <div class="banner-actions">
                <a href="{{ block.config.ctaLink ?? '#' }}" class="btn btn-primary banner-btn" style="padding:.8rem 2.2rem;font-weight:700;border-radius:8px;box-shadow:0 4px 15px rgba(var(--color-primary-rgb),.4)">
                    {{ block.config.ctaText }}
                </a>
            </div>
        {% endif %}
    </div>
</div>

<style>
.banner-block:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0,0,0,.15);
}
.banner-block:hover .banner-bg {
    transform: scale(1.03);
}
.banner-glass-card {
    background: rgba(15,23,42,.35);
    padding: 2.5rem;
    border-radius: 12px;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,.1);
}
@media (max-width:576px) {
    .banner-glass-card {
        padding: 1.5rem 1rem;
    }
}
</style>
{% endif %}
