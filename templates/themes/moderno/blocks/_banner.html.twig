{% if (block.config.active ?? '1') == '1' %}
{% set isFullWidth = (block.config.fullWidth ?? '0') == '1' %}
{% set isFullHeight = (block.config.fullHeight ?? '0') == '1' %}

{% set banners = [] %}
{% if block.config.banners is defined and block.config.banners is not empty %}
    {% for b in block.config.banners %}
        {% if (b.active ?? '1') == '1' %}
            {% set banners = banners|merge([b]) %}
        {% endif %}
    {% endfor %}
{% endif %}

{# Fallback to single banner properties if config banners are empty #}
{% if banners is empty and block.title is not empty %}
    {% set banners = [{
        'title': block.title,
        'text': block.text,
        'ctaText': block.config.ctaText ?? '',
        'ctaLink': block.config.ctaLink ?? '',
        'image': block.image
    }] %}
{% endif %}

{% if banners is not empty %}
    {% set bannerStyles = 'position:relative;overflow:hidden;transition:transform .3s ease,box-shadow .3s ease;' %}
    
    {% if isFullWidth %}
        {% set containerStyles = bannerStyles ~ ' width:100vw;position:relative;left:50%;right:50%;margin-left:-50vw;margin-right:-50vw;max-width:100vw;border-radius:0;border-left:none;border-right:none;' %}
    {% else %}
        {% set containerStyles = bannerStyles ~ ' border-radius:16px;border:1px solid var(--border);' %}
    {% endif %}

    {% if isFullHeight %}
        {% set containerStyles = containerStyles ~ ' min-height:100vh;padding:0;' %}
        {% set slideStyles = 'min-height:100vh;padding:6rem 2rem;' %}
    {% else %}
        {% set containerStyles = containerStyles ~ ' min-height:350px;padding:0;' %}
        {% set slideStyles = 'min-height:350px;padding:3rem 2rem;' %}
    {% endif %}

    {% if isFullWidth or isFullHeight %}
        {% set containerStyles = containerStyles ~ ' margin-bottom:0;' %}
    {% else %}
        {% set containerStyles = containerStyles ~ ' margin-bottom:3rem;' %}
    {% endif %}

    {% if banners|length == 1 %}
        {# Single Banner Template (Backward compatible, static layout) #}
        {% set b = banners[0] %}
        <div class="wab-block banner-block" style="{{ containerStyles }} display:flex;align-items:center;">
            {# Background image with primary overlay #}
            {% if b.image %}
                <div style="position:absolute;inset:0;background-image:url('{{ asset('uploads/page_block/' ~ b.image) }}');background-size:cover;background-position:center;z-index:0;transition:transform .5s ease" class="banner-bg"></div>
                <div style="position:absolute;inset:0;background:var(--color-primary);opacity:.15;z-index:1"></div>
                <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.2) 0%,rgba(0,0,0,.7) 100%);z-index:1"></div>
            {% else %}
                <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(var(--color-primary-rgb),.15),rgba(var(--color-secondary-rgb),.1));z-index:0"></div>
            {% endif %}

            {# Content Area with Glassmorphism #}
            <div style="position:relative;z-index:2;max-width:800px;width:100%;margin:0 auto;text-align:center;color:#fff;{{ slideStyles }}" class="banner-glass-card">
                {% if block.preTitle %}
                    <span class="banner-pretitle" style="display:inline-block;text-transform:uppercase;letter-spacing:2px;font-size:.8rem;font-weight:700;margin-bottom:1rem;color:var(--color-secondary);background:rgba(0,0,0,.4);padding:.35rem 1rem;border-radius:50px;backdrop-filter:blur(4px)">
                        {{ block.preTitle }}
                    </span>
                {% endif %}

                <h2 class="banner-title" style="font-size:clamp(1.75rem,4vw,2.75rem);font-weight:900;line-height:1.2;margin-bottom:1rem;text-shadow:0 2px 10px rgba(0,0,0,.5);color:#ffffff">
                    {{ b.title }}
                </h2>

                {% if b.text %}
                    <p class="banner-text" style="font-size:clamp(1rem,2vw,1.15rem);opacity:.9;line-height:1.6;margin-bottom:2rem;text-shadow:0 1px 5px rgba(0,0,0,.4);color:#f1f5f9">
                        {{ b.text }}
                    </p>
                {% endif %}

                {% if b.ctaText %}
                    <div class="banner-actions">
                        <a href="{{ b.ctaLink ?: '#' }}" class="btn btn-primary banner-btn" style="padding:.8rem 2.2rem;font-weight:700;border-radius:8px;box-shadow:0 4px 15px rgba(var(--color-primary-rgb),.4)">
                            {{ b.ctaText }}
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    {% else %}
        {# Multiple Banner Carousel (Swiper layout) #}
        <div class="wab-block banner-block swiper banner-swiper-{{ block.id }}" style="{{ containerStyles }}">
            <div class="swiper-wrapper">
                {% for b in banners %}
                    <div class="swiper-slide" style="position:relative;display:flex;align-items:center;justify-content:center;box-sizing:border-box;">
                        {# Background image with primary overlay #}
                        {% if b.image %}
                            <div style="position:absolute;inset:0;background-image:url('{{ asset('uploads/page_block/' ~ b.image) }}');background-size:cover;background-position:center;z-index:0;" class="banner-bg"></div>
                            <div style="position:absolute;inset:0;background:var(--color-primary);opacity:.15;z-index:1"></div>
                            <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.2) 0%,rgba(0,0,0,.7) 100%);z-index:1"></div>
                        {% else %}
                            <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(var(--color-primary-rgb),.15),rgba(var(--color-secondary-rgb),.1));z-index:0"></div>
                        {% endif %}

                        {# Content Area with Glassmorphism #}
                        <div style="position:relative;z-index:2;max-width:800px;width:100%;margin:0 auto;text-align:center;color:#fff;{{ slideStyles }}" class="banner-glass-card">
                            {% if block.preTitle %}
                                <span class="banner-pretitle" style="display:inline-block;text-transform:uppercase;letter-spacing:2px;font-size:.8rem;font-weight:700;margin-bottom:1rem;color:var(--color-secondary);background:rgba(0,0,0,.4);padding:.35rem 1rem;border-radius:50px;backdrop-filter:blur(4px)">
                                    {{ block.preTitle }}
                                </span>
                            {% endif %}

                            <h2 class="banner-title" style="font-size:clamp(1.75rem,4vw,2.75rem);font-weight:900;line-height:1.2;margin-bottom:1rem;text-shadow:0 2px 10px rgba(0,0,0,.5);color:#ffffff">
                                {{ b.title }}
                            </h2>

                            {% if b.text %}
                                <p class="banner-text" style="font-size:clamp(1rem,2vw,1.15rem);opacity:.9;line-height:1.6;margin-bottom:2rem;text-shadow:0 1px 5px rgba(0,0,0,.4);color:#f1f5f9">
                                    {{ b.text }}
                                </p>
                            {% endif %}

                            {% if b.ctaText %}
                                <div class="banner-actions">
                                    <a href="{{ b.ctaLink ?: '#' }}" class="btn btn-primary banner-btn" style="padding:.8rem 2.2rem;font-weight:700;border-radius:8px;box-shadow:0 4px 15px rgba(var(--color-primary-rgb),.4)">
                                        {{ b.ctaText }}
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>

            {# Swiper Pagination & Navigation #}
            <div class="swiper-pagination swiper-pagination-{{ block.id }}"></div>
            <div class="swiper-button-next swiper-button-next-{{ block.id }}"></div>
            <div class="swiper-button-prev swiper-button-prev-{{ block.id }}"></div>
        </div>

        <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof Swiper !== 'undefined') {
                new Swiper('.banner-swiper-{{ block.id }}', {
                    loop: true,
                    effect: 'fade',
                    fadeEffect: {
                        crossFade: true
                    },
                    autoplay: {
                        delay: 5000,
                        disableOnInteraction: false,
                    },
                    pagination: {
                        el: '.swiper-pagination-{{ block.id }}',
                        clickable: true,
                    },
                    navigation: {
                        nextEl: '.swiper-button-next-{{ block.id }}',
                        prevEl: '.swiper-button-prev-{{ block.id }}',
                    },
                });
            }
        });
        </script>
    {% endif %}

    <style>
    .banner-block:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 30px rgba(0,0,0,.15);
    }
    .banner-block:hover .banner-bg {
        transform: scale(1.03);
    }
    .banner-glass-card {
        background: rgba(15,23,42,.35);
        padding: 2.5rem;
        border-radius: 12px;
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.1);
    }
    .banner-swiper-{{ block.id }} .swiper-pagination-bullet {
        background: rgba(255,255,255,.5);
        opacity: 1;
        width: 10px;
        height: 10px;
        transition: all .3s ease;
    }
    .banner-swiper-{{ block.id }} .swiper-pagination-bullet-active {
        background: #ffffff;
        width: 24px;
        border-radius: 5px;
    }
    .banner-swiper-{{ block.id }} .swiper-button-next,
    .banner-swiper-{{ block.id }} .swiper-button-prev {
        color: #ffffff !important;
        background: rgba(0, 0, 0, 0.3);
        width: 44px;
        height: 44px;
        border-radius: 50%;
        backdrop-filter: blur(4px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: all 0.2s ease;
    }
    .banner-swiper-{{ block.id }} .swiper-button-next:hover,
    .banner-swiper-{{ block.id }} .swiper-button-prev:hover {
        background: rgba(0, 0, 0, 0.5);
        transform: scale(1.05);
    }
    .banner-swiper-{{ block.id }} .swiper-button-next::after,
    .banner-swiper-{{ block.id }} .swiper-button-prev::after {
        font-size: 1.1rem;
        font-weight: bold;
    }
    @media (max-width:576px) {
        .banner-glass-card {
            padding: 1.5rem 1rem;
        }
        .banner-swiper-{{ block.id }} .swiper-button-next,
        .banner-swiper-{{ block.id }} .swiper-button-prev {
            display: none;
        }
    }
    </style>
{% endif %}
{% endif %}
