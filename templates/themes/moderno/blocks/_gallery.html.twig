{% set images = block.galleryImages %}
{% if images|length > 0 %}
<div class="wab-block">
    {% if block.preTitle %}<span class="section-label"><span class="glow-dot"></span>{{ block.preTitle }}</span>{% endif %}
    {% if block.title %}<h2 class="section-heading">{{ block.title }}</h2>{% endif %}
    {% if block.text %}<p style="color:var(--text-muted);margin:.75rem 0 2rem">{{ block.text }}</p>{% endif %}
    <div class="wab-gallery" id="gallery-{{ block.id }}">
        <div class="wg-track">
            {% for img in images %}
            <div class="wg-slide" onclick="openLightbox('{{ block.id }}',{{ loop.index0 }})">
                <img src="{{ asset('uploads/page_block_gallery/' ~ img.filename) }}" alt="{{ img.caption }}" loading="lazy">
                {% if img.caption %}<p class="wg-caption">{{ img.caption }}</p>{% endif %}
            </div>
            {% endfor %}
        </div>
        {% if images|length > 1 %}
        <button class="wg-btn wg-prev" onclick="slideGallery('{{ block.id }}',-1)"><i class="fa-solid fa-chevron-left"></i></button>
        <button class="wg-btn wg-next" onclick="slideGallery('{{ block.id }}',1)"><i class="fa-solid fa-chevron-right"></i></button>
        <div class="wg-dots">{% for img in images %}<span class="wg-dot {{ loop.first ? 'active' : '' }}" onclick="goSlide('{{ block.id }}',{{ loop.index0 }})"></span>{% endfor %}</div>
        {% endif %}
    </div>
</div>
<div class="wab-lightbox" id="lb-{{ block.id }}" style="display:none" onclick="closeLightbox('{{ block.id }}')">
    <button onclick="closeLightbox('{{ block.id }}')" style="position:fixed;top:1rem;right:1.5rem;background:none;border:none;color:#fff;font-size:2rem;cursor:pointer">&times;</button>
    <img id="lb-img-{{ block.id }}" src="" style="max-width:90vw;max-height:88vh;border-radius:12px">
</div>
<style>
.wab-gallery { position:relative; overflow:hidden; border-radius:var(--radius-lg); }
.wg-track { display:flex; transition:transform .4s ease; }
.wg-slide { min-width:100%; cursor:zoom-in; }
.wg-slide img { width:100%; aspect-ratio:16/9; object-fit:cover; border-radius:var(--radius-lg); }
.wg-caption { text-align:center; font-size:.85rem; color:var(--text-muted); padding:.5rem 0; }
.wg-btn { position:absolute; top:50%; transform:translateY(-50%); background:var(--bg-glass);backdrop-filter:blur(8px); border:1px solid var(--border); border-radius:50%; width:44px;height:44px;display:flex;align-items:center;justify-content:center; color:var(--text); cursor:pointer; font-size:1rem; transition:.2s; }
.wg-prev { left:.75rem; } .wg-next { right:.75rem; }
.wg-btn:hover { background:var(--color-primary); color:#fff; }
.wg-dots { display:flex; justify-content:center; gap:.5rem; margin-top:1rem; }
.wg-dot { width:8px;height:8px;border-radius:50%;background:var(--border);cursor:pointer;transition:.2s; }
.wg-dot.active { background:var(--color-primary); }
.wab-lightbox { position:fixed;inset:0;background:rgba(0,0,0,.9);display:flex;align-items:center;justify-content:center;z-index:9999;cursor:zoom-out; }
</style>
<script>
(function(){
const galleries={};
function init(id){galleries[id]={idx:0,total:document.querySelectorAll('#gallery-'+id+' .wg-slide').length};}
window.slideGallery=function(id,dir){
    const g=galleries[id]||(galleries[id]={idx:0,total:document.querySelectorAll('#gallery-'+id+' .wg-slide').length});
    g.idx=(g.idx+dir+g.total)%g.total;
    document.querySelector('#gallery-'+id+' .wg-track').style.transform='translateX(-'+g.idx*100+'%)';
    document.querySelectorAll('#gallery-'+id+' .wg-dot').forEach((d,i)=>d.classList.toggle('active',i===g.idx));
};
window.goSlide=function(id,idx){galleries[id]={idx,total:document.querySelectorAll('#gallery-'+id+' .wg-slide').length};slideGallery(id,0);};
window.openLightbox=function(id,idx){
    const imgs=document.querySelectorAll('#gallery-'+id+' .wg-slide img');
    document.getElementById('lb-img-'+id).src=imgs[idx].src;
    document.getElementById('lb-'+id).style.display='flex';
};
window.closeLightbox=function(id){document.getElementById('lb-'+id).style.display='none';};
document.querySelectorAll('.wab-gallery').forEach(el=>init(el.id.replace('gallery-','')));
})();
</script>
{% endif %}
