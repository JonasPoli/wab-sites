{% extends 'themes/nepe/base.html.twig' %}

{% block title %}{{ study.title }}{% endblock %}

{% block meta_description %}
{% if study.description %}
<meta name="description" content="{{ study.description|striptags|slice(0,160) }}">
{% endif %}
{% endblock %}

{% block og_tags %}
{{ parent() }}
<meta property="og:title" content="{{ study.title }}">
{% if study.coverImage %}
<meta property="og:image" content="{{ absolute_url(asset('uploads/study_cover/' ~ study.coverImage)) }}">
{% endif %}
{% endblock %}

{% block body %}
<div class="container study-page">

    {# ── Cover Image ── #}
    {% if study.coverImage %}
    <div class="study-cover">
        <img src="{{ asset('uploads/study_cover/' ~ study.coverImage) }}"
             alt="{{ study.title }}"
             loading="lazy">
    </div>
    {% endif %}

    {# ── Header ── #}
    <div class="study-header">
        {% if study.category %}
            <span class="study-category">{{ study.category.name }}</span>
        {% endif %}
        <h1>{{ study.title }}</h1>
        <time datetime="{{ study.createdAt|date('Y-m-d') }}" class="study-date">
            {{ study.createdAt|date('d/m/Y') }}
        </time>
    </div>

    {# ── Bloco de Autoria ── #}
    {% if study.author %}
    <div class="authorship-block">
        <div class="authorship-inner">
            <div class="author-card author-card--primary">
                <div class="author-avatar">{{ study.author.name|first|upper }}</div>
                <div class="author-info">
                    <span class="author-role">Autor</span>
                    <span class="author-name">{{ study.author.name }}</span>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {% if study.description %}
    <div class="study-description prose">
        {{ study.description|raw }}
    </div>
    {% endif %}

    {% if study.materialsHtml %}
    <div class="study-materials">
        <h2>📚 Materiais e Referências</h2>
        <div class="prose">{{ study.materialsHtml|raw }}</div>
    </div>
    {% endif %}

    {# ── Arquivos para download ── #}
    {% if study.materials|length > 0 %}
    <div class="study-downloads">
        <h2>⬇️ Arquivos para Download</h2>
        <div class="downloads-grid">
            {% for mat in study.materials %}
            {% set icon = mat.extension in ['pdf'] ? '📄' : (mat.extension in ['xls','xlsx'] ? '📊' : (mat.extension in ['doc','docx'] ? '📝' : (mat.extension in ['png','jpg','jpeg'] ? '🖼️' : (mat.extension in ['csv','txt'] ? '📋' : '📎')))) %}
            <a href="{{ asset('uploads/study_material/' ~ mat.filename) }}" download class="download-card" title="{{ mat.label }}">
                <span class="dl-icon">{{ icon }}</span>
                <div class="dl-info">
                    <span class="dl-name">{{ mat.label }}</span>
                    <span class="dl-ext">{{ mat.extension|upper }}</span>
                </div>
                <span class="dl-arrow">⬇</span>
            </a>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <a href="{{ path('pub_studies') }}" class="btn btn-outline">← Voltar para Estudos</a>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.study-page { max-width: 900px; margin: 0 auto; padding: 3rem 1.5rem; }

/* Cover */
.study-cover {
    border-radius: var(--radius); overflow: hidden;
    aspect-ratio: 16/9; margin-bottom: 2.5rem;
    box-shadow: 0 16px 48px rgba(0,0,0,.12);
}
.study-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }

/* Header */
.study-category {
    display: inline-block; padding: 0.3rem 0.9rem; border-radius: 50px;
    background: color-mix(in srgb, var(--color-secondary) 20%, transparent);
    color: var(--color-primary); font-size: 0.8rem; font-weight: 600; margin-bottom: 1rem;
}
.study-header h1 { font-size: clamp(1.6rem, 3.5vw, 2.5rem); font-weight: 800; margin: 0.5rem 0 0.5rem; }
.study-date { color: #9ca3af; font-size: 0.85rem; display: block; }

/* ── Authorship block ── */
.authorship-block {
    margin: 1.75rem 0 2rem;
    padding: 1.25rem 1.5rem;
    border-radius: 14px;
    background: linear-gradient(135deg,
        color-mix(in srgb, var(--color-primary) 5%, white),
        color-mix(in srgb, var(--color-secondary) 5%, white));
    border: 1px solid color-mix(in srgb, var(--color-primary) 12%, transparent);
}
.authorship-inner {
    display: flex; align-items: center; flex-wrap: wrap; gap: 1rem;
}
.author-card {
    display: flex; align-items: center; gap: .85rem;
}
.author-avatar {
    width: 42px; height: 42px; border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    color: white; font-size: 1rem; font-weight: 800;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; box-shadow: 0 4px 12px rgba(var(--color-primary-rgb),.3);
}
.author-info { display: flex; flex-direction: column; gap: .1rem; }
.author-role {
    font-size: .65rem; font-weight: 800; text-transform: uppercase;
    letter-spacing: .09em; color: var(--color-primary); opacity: .8;
}
.author-name { font-size: .95rem; font-weight: 700; color: #1a1c2e; }

/* Materials */
.study-description { margin: 2rem 0; }
.study-materials {
    margin: 2.5rem 0; padding: 2rem; border-radius: var(--radius);
    background: linear-gradient(135deg, color-mix(in srgb, var(--color-primary) 5%, white), white);
    border: 1px solid color-mix(in srgb, var(--color-primary) 15%, transparent);
}
.study-materials h2 { font-size: 1.3rem; font-weight: 700; margin: 0 0 1.25rem; color: var(--color-primary); }

/* Downloads */
.study-downloads { margin: 2.5rem 0; }
.study-downloads h2 { font-size: 1.1rem; font-weight: 700; margin: 0 0 1rem; }
.downloads-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
.download-card {
    display: flex; align-items: center; gap: 1rem;
    padding: 1rem 1.25rem; border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
    background: color-mix(in srgb, var(--color-primary) 4%, white);
    text-decoration: none; color: #1a1c2e;
    transition: transform .2s, box-shadow .2s;
}
.download-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,.1); }
.dl-icon { font-size: 1.75rem; flex-shrink: 0; }
.dl-info { flex: 1; overflow: hidden; }
.dl-name { display: block; font-size: .9rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dl-ext  { display: block; font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--color-primary); margin-top: .15rem; }
.dl-arrow { color: var(--color-primary); font-size: 1rem; flex-shrink: 0; }
</style>
{% endblock %}
