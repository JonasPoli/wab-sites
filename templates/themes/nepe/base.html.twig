<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# ── SEO: title ── #}
    <title>{% block title %}{{ currentTenant ? currentTenant.name : 'NEPE Brasil' }}{% endblock %} | NEPE Brasil</title>

    {# ── SEO: meta description ── #}
    {% block meta_description %}{% endblock %}

    {# ── Open Graph ── #}
    {% block og_tags %}
    <meta property="og:site_name" content="{{ currentTenant ? currentTenant.name : 'NEPE Brasil' }}">
    <meta property="og:type" content="website">
    {% endblock %}

    {# ── Twitter Card ── #}
    <meta name="twitter:card" content="summary_large_image">

    {# ── Canonical ── #}
    {% block canonical %}{% endblock %}

    {# ── Robots ── #}
    {% block robots %}{% endblock %}

    {# ── Favicon ── #}
    {% if currentTenant and currentTenant.logo %}
        <link rel="icon" href="{{ vich_uploader_asset(currentTenant, 'logoFile') }}">
    {% endif %}

    {# ── Google Fonts ── #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    {# ── Tenant CSS custom properties ── #}
    {{ tenant_css_vars()|raw }}

    <style>
        *, *::before, *::after { box-sizing: border-box; }
        :root {
            --font-sans: 'Inter', system-ui, sans-serif;
            --radius: 12px;
            --transition: 0.25s cubic-bezier(0.4,0,0.2,1);
        }
        body {
            font-family: var(--font-sans);
            margin: 0;
            background: #f8f9fc;
            color: #1a1c2e;
            line-height: 1.7;
        }
        a { color: var(--color-primary); text-decoration: none; }
        a:hover { opacity: 0.8; }
        img { max-width: 100%; height: auto; }

        /* Utility */
        .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
        .btn {
            display: inline-flex; align-items: center; gap: 0.5rem;
            padding: 0.75rem 1.75rem; border-radius: 50px;
            font-weight: 600; font-size: 0.95rem; cursor: pointer;
            transition: all var(--transition); border: none;
        }
        .btn-primary {
            background: var(--color-primary); color: #fff;
        }
        .btn-primary:hover { opacity: 0.9; transform: translateY(-2px); box-shadow: 0 8px 25px rgba(var(--color-primary-rgb),.35); }
        .btn-outline {
            background: transparent; color: var(--color-primary);
            border: 2px solid var(--color-primary);
        }
        .btn-outline:hover { background: var(--color-primary); color: #fff; }

        /* Section headings */
        .section-title { text-align: center; margin-bottom: 3rem; }
        .section-title h2 {
            font-size: clamp(1.8rem, 4vw, 2.8rem);
            font-weight: 800;
            background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .section-title p { color: #6b7280; max-width: 600px; margin: 0.75rem auto 0; }

        /* Flash messages */
        .flash { padding: 1rem 1.5rem; border-radius: var(--radius); margin: 1rem 0; font-weight: 500; }
        .flash-success { background: #d1fae5; color: #065f46; }
        .flash-error   { background: #fee2e2; color: #991b1b; }

        /* Animations */
        .reveal-up { opacity: 0; transform: translateY(30px); transition: opacity 0.8s ease-out, transform 0.8s ease-out; }
        .reveal-up.active { opacity: 1; transform: translateY(0); }
        .fade-in { opacity: 0; transition: opacity 1s ease-out; }
        .fade-in.active { opacity: 1; }
        .delay-100 { transition-delay: 100ms; }
        .delay-200 { transition-delay: 200ms; }
        .delay-300 { transition-delay: 300ms; }
        .scale-in { opacity: 0; transform: scale(0.95); transition: opacity 0.6s ease-out, transform 0.6s ease-out; }
        .scale-in.active { opacity: 1; transform: scale(1); }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>

{# ── HEADER ── #}
{% include 'themes/nepe/_header.html.twig' %}

{# ── BODY ── #}
<main>
    {% for msg in app.flashes('contact_s') %}
        <div class="container"><div class="flash flash-success">{{ msg }}</div></div>
    {% endfor %}
    {% for msg in app.flashes('contact_f') %}
        <div class="container"><div class="flash flash-error">{{ msg }}</div></div>
    {% endfor %}
    {% block body %}{% endblock %}
</main>

{# ── FOOTER ── #}
{% include 'themes/nepe/_footer.html.twig' %}

{% block javascripts %}{% endblock %}
<script>
document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('active');
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.1, rootMargin: "0px 0px -50px 0px" });

    document.querySelectorAll('.reveal-up, .fade-in, .scale-in').forEach(el => observer.observe(el));
});
</script>
</body>
</html>
