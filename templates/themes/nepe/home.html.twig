{% extends 'themes/nepe/base.html.twig' %}

{% block title %}{{ currentTenant ? currentTenant.name : 'NEPE Brasil' }}{% endblock %}

{% block meta_description %}
<meta name="description" content="{{ currentTenant ? currentTenant.name ~ ' — Núcleo de Estudos e Pesquisas' : 'NEPE Brasil' }}">
{% endblock %}

{% block og_tags %}
{{ parent() }}
<meta property="og:title" content="{{ currentTenant ? currentTenant.name : 'NEPE Brasil' }}">
<meta property="og:description" content="Núcleo de Estudos e Pesquisas — conhecimento, pesquisa e transformação">
{% endblock %}

{# JSON-LD WebPage #}
{% block body %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "{{ currentTenant ? currentTenant.name : 'NEPE Brasil' }}",
  "description": "Núcleo de Estudos e Pesquisas",
  "url": "{{ app.request.uri }}"
}
</script>

{# ── HERO BANNER ─────────────────────────────────────────────────────── #}
{% if banners|length > 0 %}
<div class="hero-slider-wrap" id="heroSlider">
    {% for b in banners %}
    <div class="hero-slide {% if loop.first %}active{% endif %}" data-index="{{ loop.index0 }}">
        <div class="hero-slide-bg" {% if b.backgroundImage %}style="background-image: url('{{ asset('uploads/hero/' ~ b.backgroundImage) }}')"{% endif %}></div>
        <div class="hero-slide-overlay"></div>
        <div class="container hero-content">
            <h1 class="hero-title">{{ b.title }}</h1>
            {% if b.subtitle %}<p class="hero-subtitle">{{ b.subtitle }}</p>{% endif %}
            {% if b.ctaText and b.ctaLink %}
                <a href="{{ b.ctaLink }}" class="btn btn-hero">{{ b.ctaText }} →</a>
            {% endif %}
        </div>
    </div>
    {% endfor %}

    {% if banners|length > 1 %}
    {# Controles de navegação #}
    <button class="hero-nav hero-prev" onclick="heroSlide(-1)" aria-label="Anterior">&#8249;</button>
    <button class="hero-nav hero-next" onclick="heroSlide(1)" aria-label="Próximo">&#8250;</button>

    {# Bolinhas indicadoras #}
    <div class="hero-dots">
        {% for b in banners %}
        <button class="hero-dot {% if loop.first %}active{% endif %}" onclick="heroGoTo({{ loop.index0 }})" aria-label="Slide {{ loop.index }}"></button>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% else %}
<section class="hero hero-default">
    <div class="container hero-content">
        <h1 class="hero-title">{{ currentTenant ? currentTenant.name : 'NEPE Brasil' }}</h1>
        <p class="hero-subtitle">Núcleo de Estudos e Pesquisas — conhecimento que transforma</p>
        <a href="#noticias" class="btn btn-hero">Saiba mais →</a>
    </div>
</section>
{% endif %}


{# ── QUEM SOMOS ──────────────────────────────────────────────────────── #}
{% if currentTenant and (currentTenant.aboutFullText or currentTenant.aboutImage) %}
<section class="section-about" id="quem-somos">
    <div class="container about-grid">
        <div class="about-text reveal-up">
            <div class="section-label-line">Quem Somos</div>
            <h2 class="about-title">{{ currentTenant.name }}</h2>
            {% if currentTenant.aboutFullText %}
                <div class="about-body">{{ currentTenant.aboutFullText|nl2br }}</div>
            {% endif %}
            {% if currentTenant.contactEmail or currentTenant.phone %}
            <div class="about-cta">
                <a href="#contato" class="btn btn-primary">Entre em contato →</a>
            </div>
            {% endif %}
        </div>
        <div class="about-image-wrap scale-in delay-200">
            {% if currentTenant.aboutImage %}
                <img src="{{ asset('uploads/tenant/about/' ~ currentTenant.aboutImage) }}"
                     alt="Quem Somos — {{ currentTenant.name }}"
                     class="about-img" loading="lazy">
            {% else %}
                <div class="about-img-placeholder"></div>
            {% endif %}
        </div>
    </div>
</section>
{% endif %}

{# ── ÚLTIMAS NOTÍCIAS ────────────────────────────────────────────────── #}
{% if latestNews|length > 0 %}
<section class="section-news" id="noticias">
    <div class="container">
        <div class="section-title reveal-up">
            <div class="section-label-line">Publicações</div>
            <h2>Fique por dentro</h2>
            <p>Fique por dentro das últimas novidades e atualizações</p>
        </div>
        <div class="news-grid">
            {% for article in latestNews %}
            <article class="news-card reveal-up delay-{{ loop.index0 * 100 }}">
                {% if article.image %}
                    <div class="news-card-img" style="background-image: url('{{ ('uploads/article/' ~ article.image) | imagine_filter('news_thumb') }}')"></div>
                {% endif %}
                <div class="news-card-body">
                    {% if article.category %}
                        <span class="news-category">{{ article.category.name }}</span>
                    {% endif %}
                    <h3 class="news-title">
                        <a href="{{ path('pub_article_show', {slug: article.slug}) }}">{{ article.title }}</a>
                    </h3>
                    {% if article.shortDescription %}
                        <p class="news-excerpt">{{ article.shortDescription }}</p>
                    {% endif %}
                    <div class="news-meta">
                        <time datetime="{{ article.publishedAt|date('Y-m-d') }}">{{ article.publishedAt|date('d/m/Y') }}</time>
                        <a href="{{ path('pub_article_show', {slug: article.slug}) }}" class="news-read-more">Ler mais →</a>
                    </div>
                </div>
            </article>
            {% endfor %}
        </div>
        <div style="text-align:center;margin-top:2rem">
            <a href="{{ path('pub_articles') }}" class="btn btn-outline">Ver todas as notícias</a>
        </div>
    </div>
</section>
{% endif %}

{# ── VÍDEOS ──────────────────────────────────────────────────────────── #}
{% if footerVideos|length > 0 %}
<section class="section-videos" id="videos">
    <div class="container">
        <div class="section-title reveal-up">
            <div class="section-label-line">Canal</div>
            <h2>Acompanhe o YouTube</h2>
            <p>Veja o que acontece no nosso canal</p>
        </div>
        <div class="videos-grid">
            {% for video in footerVideos|slice(0, 3) %}
            <a href="{{ path('pub_video_show', {slug: video.slug}) }}" class="video-card reveal-up delay-{{ loop.index0 * 100 }}">
                <div class="video-thumb" style="background-image: url('{{ video.thumbnailUrl }}')">
                    <div class="video-play">▶</div>
                </div>
                <div class="video-card-body">
                    <h3 class="video-card-title">{{ video.title }}</h3>
                    {% if video.description %}
                        <p class="video-card-desc">{{ video.description|striptags|slice(0,100) }}…</p>
                    {% endif %}
                </div>
            </a>
            {% endfor %}
        </div>
        <div style="text-align:center;margin-top:2rem">
            <a href="{{ path('pub_videos') }}" class="btn btn-outline">Ver todos os vídeos</a>
        </div>
    </div>
</section>
{% endif %}

{# ── ESTUDOS ──────────────────────────────────────────────────────────── #}
{% if latestStudies is defined and latestStudies|length > 0 %}
<section class="section-studies" id="estudos">
    <div class="container">
        <div class="section-title reveal-up">
            <div class="section-label-line">Estudos</div>
            <h2>Aprofunde seu conhecimento</h2>
            <p>Materiais, referências e conteúdos para estudo</p>
        </div>
        <div class="studies-grid-home">
            {% for study in latestStudies %}
            <a href="{{ path('pub_study_show', {slug: study.slug}) }}" class="study-card-home reveal-up delay-{{ loop.index0 * 100 }}">
                <div class="study-cover-home">
                    {% if study.coverImage %}
                    <img src="{{ asset('uploads/study_cover/' ~ study.coverImage) }}" alt="{{ study.title }}" loading="lazy">
                    {% else %}
                    <div class="study-cover-placeholder-home">📚</div>
                    {% endif %}
                </div>
                <div class="study-card-home-body">
                    {% if study.category %}
                    <span class="study-card-cat">{{ study.category.name }}</span>
                    {% endif %}
                    <h3 class="study-card-home-title">{{ study.title }}</h3>
                    {% if study.description %}
                        <p class="study-card-home-desc">{{ study.description|striptags|slice(0,90) }}…</p>
                    {% endif %}
                    {% if study.author %}
                    <div class="study-card-author">
                        <span class="study-author-avatar">{{ study.author.name|first|upper }}</span>
                        {{ study.author.name }}
                    </div>
                    {% endif %}
                </div>
            </a>
            {% endfor %}
        </div>
        <div style="text-align:center;margin-top:2rem">
            <a href="{{ path('pub_studies') }}" class="btn btn-outline">Ver todos os estudos</a>
        </div>
    </div>
</section>
{% endif %}

{# ── CONTATO ─────────────────────────────────────────────────────────── #}
<section class="section-contact-new" id="contato">
    <div class="container contact-new-inner">

        {# Lado esquerdo — info #}
        <div class="contact-info reveal-up">
            <h2 class="contact-info-title">Vamos <span style="color:var(--color-secondary)">conversar</span>?</h2>
            <p class="contact-info-sub">Entre em contato — respondemos em breve.</p>

            {% if currentTenant and currentTenant.phone %}
            <div class="contact-item">
                <div class="contact-icon"><sl-icon name="telephone-fill"></sl-icon></div>
                <div>
                    <div class="contact-item-label">Telefone</div>
                    <div class="contact-item-value">{{ currentTenant.phone }}</div>
                </div>
            </div>
            {% endif %}

            {% if currentTenant and currentTenant.whatsappLink %}
            <div class="contact-item">
                <div class="contact-icon contact-icon-wa">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                </div>
                <div>
                    <div class="contact-item-label">WhatsApp</div>
                    <a href="{{ currentTenant.whatsappLink }}" target="_blank" class="contact-item-value contact-link">Enviar mensagem</a>
                </div>
            </div>
            {% endif %}

            {% if currentTenant and currentTenant.contactEmail %}
            <div class="contact-item">
                <div class="contact-icon contact-icon-mail"><sl-icon name="envelope-fill"></sl-icon></div>
                <div>
                    <div class="contact-item-label">E-mail</div>
                    <a href="mailto:{{ currentTenant.contactEmail }}" class="contact-item-value contact-link">{{ currentTenant.contactEmail }}</a>
                </div>
            </div>
            {% endif %}

            {% if currentTenant and currentTenant.address %}
            <div class="contact-item">
                <div class="contact-icon contact-icon-addr"><sl-icon name="geo-alt-fill"></sl-icon></div>
                <div>
                    <div class="contact-item-label">Endereço</div>
                    <div class="contact-item-value">{{ currentTenant.address }}</div>
                </div>
            </div>
            {% endif %}
        </div>

        {# Lado direito — formulário #}
        <div class="contact-form-card reveal-up delay-200">
            <div id="contact-alerts">
                {% for msg in app.flashes('contact_s') %}
                <div class="local-alert local-alert-success">
                    <sl-icon name="check-circle-fill"></sl-icon> {{ msg }}
                </div>
                {% endfor %}
                {% for msg in app.flashes('contact_f') %}
                <div class="local-alert local-alert-error">
                    <sl-icon name="exclamation-triangle-fill"></sl-icon> {{ msg }}
                </div>
                {% endfor %}
            </div>
            <form action="{{ path('pub_contact_post') }}" method="post" class="contact-form">
                <input type="hidden" name="_token" value="{{ csrf_token('contact_form') }}">
                <div class="cf-row">
                    <div class="cf-field">
                        <label class="cf-label">Nome completo</label>
                        <input type="text" name="name" placeholder="Como podemos te chamar?" required class="cf-input">
                    </div>
                    <div class="cf-field">
                        <label class="cf-label">Seu melhor e-mail</label>
                        <input type="email" name="email" placeholder="Para enviarmos a resposta" required class="cf-input">
                    </div>
                </div>
                <div class="cf-field">
                    <label class="cf-label">Como podemos ajudar?</label>
                    <textarea name="message" placeholder="Escreva sua mensagem aqui..." rows="5" required class="cf-input cf-textarea"></textarea>
                </div>
                <button type="submit" class="btn btn-primary" style="width:100%;padding:1rem;font-size:1rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase">
                    Enviar Mensagem
                </button>
            </form>
        </div>

    </div>

    {# Mapa #}
    {% if currentTenant and currentTenant.mapsEmbedUrl %}
    <div class="contact-map fade-in delay-300">
        <iframe src="{{ currentTenant.mapsEmbedUrl }}"
                width="100%" height="380" style="border:0;display:block"
                allowfullscreen loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Localização {{ currentTenant.name }}"></iframe>
    </div>
    {% endif %}
</section>

{% endblock %}
{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.19.1/cdn/themes/light.css">
<script type="module" src="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.19.1/cdn/shoelace-autoloader.js"></script>
<style>
/* ── CONTACT LOCAL ALERTS ── */
.local-alert {
    padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;
    display: flex; align-items: center; gap: 0.5rem; font-weight: 600;
    font-size: 0.95rem; animation: slideInLocal 0.4s ease forwards;
    transition: opacity 0.5s ease, transform 0.5s ease;
}
.local-alert.fade-out { opacity: 0; transform: translateY(-10px); }
.local-alert-success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
.local-alert-error { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
@keyframes slideInLocal { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }

/* ── HERO SLIDER ── */
.hero-slider-wrap {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    min-height: 80vh;
    overflow: hidden;
    background: #1a1c2e;
}

.hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s ease-in-out;
    pointer-events: none;
    z-index: 1;
}
.hero-slide.active {
    opacity: 1;
    pointer-events: auto;
    position: relative;
    z-index: 2;
}

.hero-slide-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-color: linear-gradient(135deg, var(--color-primary), color-mix(in srgb, var(--color-primary) 50%, var(--color-secondary)));
}

.hero-slide-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,.15) 0%, rgba(0,0,0,.55) 100%);
    z-index: 1;
}

.hero-slider-wrap .hero-content {
    position: relative;
    z-index: 3;
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    padding: 4rem 1.5rem;
    max-width: 800px;
    margin: 0 auto;
}

/* Navigation arrows */
.hero-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(0,0,0,.3);
    color: white;
    border: none;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.3s, transform 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
}
.hero-nav:hover { background: var(--color-primary); transform: translateY(-50%) scale(1.1); }
.hero-prev { left: 1.5rem; }
.hero-next { right: 1.5rem; }

/* Dots */
.hero-dots {
    position: absolute;
    bottom: 1.8rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    gap: 0.6rem;
}
.hero-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    border: 2px solid rgba(255,255,255,.6);
    background: rgba(255,255,255,.3);
    cursor: pointer;
    transition: background 0.3s, transform 0.3s;
    padding: 0;
}
.hero-dot.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    transform: scale(1.3);
}

.hero-title { font-size: clamp(2.2rem, 6vw, 4rem); font-weight: 900; line-height: 1.1; margin: 0 0 1.5rem; }
.hero-subtitle { font-size: 1.2rem; opacity: .85; margin: 0 0 2.5rem; max-width: 600px; margin-inline: auto; }
.btn-hero {
    background: var(--color-secondary); color: #1a1c2e;
    padding: 1rem 2.5rem; border-radius: 50px; font-size: 1rem; font-weight: 700;
    display: inline-block; transition: all 0.25s; box-shadow: 0 8px 32px rgba(0,0,0,.2);
}
.btn-hero:hover { transform: translateY(-3px); box-shadow: 0 16px 40px rgba(0,0,0,.3); opacity: 1; }

/* Fallback single hero */
.hero {
    min-height: 80vh; display: flex; align-items: center;
    background: linear-gradient(135deg, var(--color-primary), color-mix(in srgb, var(--color-primary) 50%, var(--color-secondary)));
    color: white; text-align: center; position: relative; overflow: hidden;
    width: 100vw; left: 50%; margin-left: -50vw;
}
.hero::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse at 70% 50%, rgba(255,255,255,.08) 0%, transparent 70%);
}
.hero-overlay { position: absolute; inset: 0; z-index: 1; }
.hero-content { position: relative; z-index: 2; max-width: 800px; margin: 0 auto; padding: 4rem 1.5rem; }

/* ── SECTION COMMON ── */
.section-label-line {
    display: inline-block; font-size: .75rem; font-weight: 800; letter-spacing: .12em;
    text-transform: uppercase; color: var(--color-primary); margin-bottom: .6rem;
}
.section-title { text-align: center; margin-bottom: 3rem; }
.section-title h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 900; color: #1a1c2e; margin: .3rem 0 .75rem; }
.section-title p { color: #6b7280; max-width: 520px; margin: 0 auto; }

/* ── ABOUT ── */
.section-about { padding: 5rem 0; background: white; }
.about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
.about-text .section-label-line { display: block; margin-bottom: .5rem; }
.about-title { font-size: clamp(1.8rem, 3.5vw, 2.4rem); font-weight: 900; color: #1a1c2e; margin: 0 0 1.25rem; line-height: 1.2; }
.about-body { color: #4b5563; line-height: 1.8; font-size: 1rem; }
.about-cta { margin-top: 2rem; }
.about-image-wrap { position: relative; }
.about-img { width: 100%; border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,.12); object-fit: cover; aspect-ratio: 4/3; }
.about-img-placeholder { width: 100%; aspect-ratio: 4/3; border-radius: 16px; background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); opacity: .15; }

/* ── NEWS ── */
.section-news { padding: 5rem 0; }
.news-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; }
.news-card { background: white; border-radius: 14px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,.06); transition: transform .2s, box-shadow .2s; }
.news-card:hover { transform: translateY(-6px); box-shadow: 0 16px 40px rgba(0,0,0,.12); }
.news-card-img { height: 200px; background-size: cover; background-position: center; }
.news-card-body { padding: 1.5rem; }
.news-category { display: inline-block; padding: .25rem .75rem; border-radius: 50px; background: color-mix(in srgb, var(--color-secondary) 20%, transparent); color: var(--color-primary); font-size: .75rem; font-weight: 600; margin-bottom: .75rem; }
.news-title { font-size: 1.1rem; font-weight: 700; margin: 0 0 .75rem; line-height: 1.4; }
.news-title a { color: #1a1c2e; }
.news-title a:hover { color: var(--color-primary); }
.news-excerpt { color: #6b7280; font-size: .9rem; margin: 0 0 1rem; }
.news-meta { display: flex; justify-content: space-between; align-items: center; font-size: .8rem; color: #9ca3af; }
.news-read-more { color: var(--color-primary); font-weight: 600; }

/* ── VIDEOS ── */
.section-videos { padding: 5rem 0; background: color-mix(in srgb, var(--color-primary) 8%, white); }
.videos-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; }
.video-card { display: block; text-decoration: none; color: #1a1c2e; background: white; border-radius: 14px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,.06); transition: transform .2s, box-shadow .2s; }
.video-card:hover { transform: translateY(-5px); box-shadow: 0 16px 40px rgba(0,0,0,.12); }
.video-thumb { aspect-ratio: 16/9; background-size: cover; background-position: center; position: relative; }
.video-play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,.3); color: white; font-size: 2rem; opacity: 0; transition: opacity .2s; }
.video-card:hover .video-play { opacity: 1; }
.video-card-body { padding: 1.25rem; }
.video-card-title { font-size: 1rem; font-weight: 700; margin: 0 0 .5rem; line-height: 1.4; }
.video-card-desc { font-size: .85rem; color: #6b7280; margin: 0; }

/* ── ESTUDOS (home) ── */
.section-studies { padding: 5rem 0; background: white; }
.studies-grid-home { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; }
.study-card-home { display: flex; flex-direction: column; text-decoration: none; color: #1a1c2e; background: #f8fafc; border-radius: 14px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,.06); transition: transform .2s, box-shadow .2s; border: 1px solid #f1f5f9; }
.study-card-home:hover { transform: translateY(-5px); box-shadow: 0 16px 40px rgba(0,0,0,.12); }
.study-cover-home { aspect-ratio: 16/9; overflow: hidden; background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); position: relative; }
.study-cover-home img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s; }
.study-card-home:hover .study-cover-home img { transform: scale(1.05); }
.study-cover-placeholder-home { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; opacity: .5; }
.study-card-home-body { padding: 1.25rem; flex: 1; display: flex; flex-direction: column; gap: .4rem; }
.study-card-cat { display: inline-block; font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--color-primary); background: color-mix(in srgb, var(--color-primary) 10%, transparent); padding: .2rem .6rem; border-radius: 50px; width: fit-content; }
.study-card-home-title { font-size: 1rem; font-weight: 700; margin: 0; line-height: 1.4; }
.study-card-home-desc { font-size: .85rem; color: #6b7280; margin: 0; flex: 1; }
.study-card-author { display: flex; align-items: center; gap: .4rem; font-size: .75rem; color: #9ca3af; margin-top: .5rem; }
.study-author-avatar { display: inline-flex; align-items: center; justify-content: center; width: 18px; height: 18px; border-radius: 50%; background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); color: white; font-size: .55rem; font-weight: 800; flex-shrink: 0; }

/* ── CONTACT ── */
.section-contact-new { background: white; } /* zebra: white */
.contact-new-inner { display: grid; grid-template-columns: 1fr 1.3fr; gap: 4rem; padding: 5rem 0 4rem; align-items: start; }
.contact-info-title { font-size: clamp(1.8rem, 3.5vw, 2.4rem); font-weight: 900; color: #1a1c2e; margin: 0 0 .75rem; line-height: 1.2; }
.contact-info-sub { color: #6b7280; margin: 0 0 2.5rem; font-size: 1rem; }
.contact-item { display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 1.5rem; }
.contact-icon { width: 44px; height: 44px; border-radius: 12px; background: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0; }
.contact-icon-wa { background: rgba(37,211,102,.12); color: #25d366; }
.contact-icon-mail { background: color-mix(in srgb, var(--color-secondary) 15%, transparent); color: var(--color-secondary); }
.contact-icon-addr { background: rgba(239,68,68,.1); color: #ef4444; }
.contact-item-label { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #9ca3af; margin-bottom: .25rem; }
.contact-item-value { font-size: .95rem; font-weight: 600; color: #1a1c2e; }
.contact-link { color: var(--color-primary); }
.contact-form-card { background: white; border-radius: 16px; box-shadow: 0 8px 40px rgba(0,0,0,.08); padding: 2.5rem; border: 1px solid #f1f5f9; }
.cf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
.cf-field { margin-bottom: 1rem; }
.cf-field:last-child { margin-bottom: 0; }
.cf-label { display: block; font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #374151; margin-bottom: .4rem; }
.cf-input { width: 100%; padding: .85rem 1rem; border: 1.5px solid #94a3b8; border-radius: 10px; font-size: .95rem; color: #1a1c2e; outline: none; transition: border-color .2s, box-shadow .2s; box-sizing: border-box; background: #f8fafc; }
.cf-input:focus { border-color: var(--color-primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 20%, transparent); background: white; }
.cf-textarea { resize: vertical; min-height: 140px; }
.contact-map { border-top: 1px solid #f1f5f9; }

/* ── BUTTONS ── */
.btn-primary { background: var(--color-primary); color: white; padding: .75rem 2rem; border-radius: 50px; font-weight: 700; display: inline-block; transition: all .2s; border: none; cursor: pointer; }
.btn-primary:hover { opacity: .9; transform: translateY(-2px); box-shadow: 0 8px 25px rgba(var(--color-primary-rgb),.35); }
.btn-outline { background: transparent; color: var(--color-primary); border: 2px solid var(--color-primary); padding: .75rem 2rem; border-radius: 50px; font-weight: 700; display: inline-block; transition: all .2s; }
.btn-outline:hover { background: var(--color-primary); color: white; }

/* ── FLASH ── */
.flash { padding: .85rem 1.25rem; border-radius: 10px; margin-bottom: 1rem; font-size: .9rem; }
.flash-success { background: #d1fae5; color: #065f46; }
.flash-error { background: #fee2e2; color: #991b1b; }

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
    .about-grid, .contact-new-inner { grid-template-columns: 1fr; gap: 2rem; }
    .about-image-wrap { order: -1; }
    .cf-row { grid-template-columns: 1fr; }
}
</style>
<script>
function prevAbout(input) {
    if (!input.files || !input.files[0]) return;
    const reader = new FileReader();
    reader.onload = e => {
        let el = document.getElementById('about-img-prev');
        if (el && el.tagName === 'DIV') {
            const img = document.createElement('img');
            img.id = 'about-img-prev';
            img.style.cssText = 'height:80px;width:120px;object-fit:cover;border-radius:8px;border:1px solid var(--border)';
            el.replaceWith(img); el = img;
        }
        if (el) el.src = e.target.result;
    };
    reader.readAsDataURL(input.files[0]);
}

// ── Hero Slider ──────────────────────────────────────────────────────
var _heroCurrent = 0;
var _heroSlides  = [];
var _heroDots    = [];
var _heroTimer   = null;

function _heroGoTo(index) {
    if (!_heroSlides.length) return;
    _heroSlides[_heroCurrent].classList.remove('active');
    if (_heroDots[_heroCurrent]) _heroDots[_heroCurrent].classList.remove('active');
    _heroCurrent = (index + _heroSlides.length) % _heroSlides.length;
    _heroSlides[_heroCurrent].classList.add('active');
    if (_heroDots[_heroCurrent]) _heroDots[_heroCurrent].classList.add('active');
    clearInterval(_heroTimer);
    if (_heroSlides.length > 1) {
        _heroTimer = setInterval(() => _heroGoTo(_heroCurrent + 1), 7000);
    }
}

window.heroSlide = function(dir) { _heroGoTo(_heroCurrent + dir); };
window.heroGoTo  = function(idx) { _heroGoTo(idx); };

document.addEventListener('DOMContentLoaded', function() {
    _heroSlides = Array.from(document.querySelectorAll('#heroSlider .hero-slide'));
    _heroDots   = Array.from(document.querySelectorAll('#heroSlider .hero-dot'));
    if (_heroSlides.length > 1) {
        _heroTimer = setInterval(() => _heroGoTo(_heroCurrent + 1), 7000);
    }

    // Contact alert auto-dismiss
    const alerts = document.querySelectorAll('.local-alert');
    if (alerts.length > 0) {
        setTimeout(() => {
            alerts.forEach(alert => {
                alert.classList.add('fade-out');
                setTimeout(() => alert.remove(), 500);
            });
        }, 5000);
    }
});
</script>
{% endblock %}
