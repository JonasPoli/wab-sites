<header class="nepe-header" id="site-header">
    <div class="container header-inner">
        {# Logo #}
        <a href="{{ path('pub_home') }}" class="header-logo" aria-label="Página inicial">
            {% if currentTenant and currentTenant.logo %}
                <img src="{{ vich_uploader_asset(currentTenant, 'logoFile') }}"
                     alt="{{ currentTenant.name }}"
                     style="max-height:52px;width:auto;max-width:200px;object-fit:contain;display:block">
            {% else %}
                <span class="logo-text">{{ currentTenant ? currentTenant.name : 'NEPE Brasil' }}</span>
            {% endif %}
        </a>

        {# Nav #}
        <nav class="header-nav" aria-label="Navegação principal">
            {% if headerPages is defined %}
                {% for page in headerPages %}
                    <a href="{{ path('pub_page_show', {slug: page.slug}) }}" class="nav-link">{{ page.title }}</a>
                {% endfor %}
            {% endif %}
            {% if headerCategories is defined %}
                {% for cat in headerCategories %}
                    {% if cat.children|length > 0 %}
                    <div class="nav-dropdown">
                        <a href="#" class="nav-link nav-link--has-children" aria-haspopup="true">
                            {{ cat.name }} <svg class="nav-chevron" width="10" height="6" viewBox="0 0 10 6"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>
                        </a>
                        <div class="nav-dropdown__panel">
                            {% for sub in cat.children %}
                            <a href="#" class="nav-dropdown__item">{{ sub.name }}</a>
                            {% endfor %}
                        </div>
                    </div>
                    {% else %}
                    <a href="#" class="nav-link">{{ cat.name }}</a>
                    {% endif %}
                {% endfor %}
            {% endif %}
            <a href="{{ path('pub_articles') }}" class="nav-link">Notícias</a>
            <a href="{{ path('pub_videos') }}"   class="nav-link">Vídeos</a>
            <a href="{{ path('pub_studies') }}"  class="nav-link">Estudos</a>
            <a href="{{ path('pub_home') }}#contato" class="nav-link">Contato</a>
        </nav>

        {# Mobile toggle #}
        <button class="nav-toggle" aria-label="Abrir menu" onclick="document.querySelector('.header-nav').classList.toggle('open')">
            <span></span><span></span><span></span>
        </button>
    </div>
</header>

<style>
.nepe-header {
    position: sticky; top: 0; z-index: 100;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(0,0,0,.07);
    box-shadow: 0 2px 20px rgba(0,0,0,.06);
}
.header-inner {
    display: flex; align-items: center; justify-content: space-between;
    height: 72px; gap: 2rem;
}
.header-logo { display: flex; align-items: center; height: 52px; overflow: hidden; flex-shrink: 0; }
.logo-text {
    font-size: 1.3rem; font-weight: 800;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.header-nav { display: flex; align-items: center; gap: 0.25rem; }
.nav-link {
    padding: 0.5rem 1rem; border-radius: 8px; font-size: 0.9rem; font-weight: 500;
    color: #374151; transition: all 0.2s; text-decoration: none; display: flex; align-items: center; gap: .3rem;
}
.nav-link:hover { background: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary); opacity: 1; }
.nav-chevron { flex-shrink: 0; transition: transform .2s; }
/* ── Dropdown ── */
.nav-dropdown { position: relative; }
.nav-dropdown:hover .nav-dropdown__panel { opacity: 1; visibility: visible; transform: translateY(0); pointer-events: auto; }
.nav-dropdown:hover .nav-chevron { transform: rotate(180deg); }
.nav-dropdown__panel {
    position: absolute; top: calc(100% + .4rem); left: 50%; transform: translateX(-50%) translateY(-6px);
    min-width: 180px; background: white; border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0,0,0,.14); border: 1px solid rgba(0,0,0,.06);
    padding: .4rem; display: flex; flex-direction: column; gap: .1rem;
    opacity: 0; visibility: hidden; transition: opacity .18s, transform .18s, visibility .18s;
    z-index: 200;
}
.nav-dropdown__item {
    padding: .5rem .9rem; border-radius: 8px; font-size: .875rem; font-weight: 500;
    color: #374151; text-decoration: none; transition: background .15s, color .15s; white-space: nowrap;
}
.nav-dropdown__item:hover { background: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary); }
/* ── Toggle ── */
.nav-toggle {
    display: none; flex-direction: column; gap: 5px;
    background: none; border: none; cursor: pointer; padding: 8px;
}
.nav-toggle span { display: block; width: 24px; height: 2px; background: #374151; border-radius: 2px; transition: 0.2s; }
@media (max-width: 768px) {
    .nav-toggle { display: flex; }
    .header-nav {
        display: none; flex-direction: column; position: absolute;
        top: 72px; left: 0; right: 0;
        background: white; padding: 1rem; box-shadow: 0 8px 32px rgba(0,0,0,.12);
    }
    .header-nav.open { display: flex; }
    .nav-link { width: 100%; padding: 0.75rem 1rem; }
    .nav-dropdown__panel { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; border: none; padding-left: 1rem; }
}
</style>
