{#
  Cartão de post do blog (lista, bloco "Últimas do blog"). Variável: article.
  Classes Tailwind com as cores do site (cetec-*), que valem em todos os temas.
#}
{% set url = article_url(article) %}
<article class="group flex flex-col bg-white dark:bg-cetec-dark border border-gray-100 dark:border-white/5 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:border-cetec-secondary/50 transition-all duration-300">
    {% if article.coverImage %}
    <a href="{{ url }}" class="block aspect-[3/2] overflow-hidden bg-gray-100 dark:bg-white/5" tabindex="-1" aria-hidden="true">
        <img {{ ('uploads/article/' ~ article.coverImage)|thumb_attrs('capa_pagina') }} alt="" loading="lazy" decoding="async"
             class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
    </a>
    {% endif %}
    <div class="flex flex-col flex-1 p-6">
        <div class="flex flex-wrap items-center gap-2 mb-3 text-xs">
            {% if article.category %}
                <a href="{{ articles_url(article.category) }}" class="bg-cetec-secondary/30 text-cetec-primary-text px-3 py-1 rounded-full font-bold uppercase tracking-wider text-[10px]">{{ article.category.name }}</a>
            {% endif %}
            <time datetime="{{ article.publishedAt|date('Y-m-d') }}" class="text-gray-600 dark:text-gray-400">{{ article.publishedAt|date('d/m/Y', 'America/Sao_Paulo') }}</time>
        </div>
        <h3 class="text-lg font-bold leading-snug text-cetec-primary-text mb-2">
            <a href="{{ url }}" class="hover:underline underline-offset-4">{{ article.title }}</a>
        </h3>
        {% if article.summary %}
            <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed line-clamp-3 mb-4">{{ article.summary }}</p>
        {% endif %}
        <a href="{{ url }}" class="mt-auto inline-flex items-center gap-1.5 text-sm font-bold text-cetec-secondary-text hover:gap-2.5 transition-all" aria-label="Ler o post: {{ article.title }}">
            Ler mais {{ ux_icon('bi:arrow-right', {'aria-hidden': 'true'}) }}
        </a>
    </div>
</article>
