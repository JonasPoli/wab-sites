<!DOCTYPE html>
<html lang="pt-BR" data-theme="light" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {# ── O que o navegador precisa descobrir primeiro ──────────────────────────────
       Estas duas linhas vêm antes de tudo de propósito: o leitor de pré-carga do
       navegador lê o <head> em ordem, e cada KB de HTML antes delas atrasa o pedido.
       Com a pré-carga no fim do <head> o PageSpeed media 470 ms de "atraso no
       carregamento do recurso" só para começar a baixar a imagem do topo. #}
    {% set arquivoDoLcp = imagem_do_lcp(_context) %}
    {% if arquivoDoLcp %}
        <link rel="preload" as="image" fetchpriority="high"
              imagesrcset="{{ arquivoDoLcp|thumb_srcset({'banner_mobile': 768, 'banner_desktop': 1600}) }}"
              imagesizes="100vw">
    {% endif %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {# Título, descrição, canônico, Open Graph, Twitter Card e JSON-LD num lugar só (PageSeo) #}
    {% include 'pub/_seo_head.html.twig' %}
    {% if currentTenant and currentTenant.favicon %}
        <link rel="icon" href="{{ ('uploads/tenant/favicon/' ~ currentTenant.favicon)|thumb('favicon_site') }}" sizes="64x64">
    {% endif %}

    {# Cores e tipografia do site #}
    {{ tenant_css_vars()|raw }}

    {# ── Tudo pelo próprio domínio ──────────────────────────────────────────────────
       Saíram daqui quatro folhas de estilo de três domínios de terceiro (Swiper e
       Bootstrap Icons no jsdelivr, AOS no unpkg, FontAwesome no cdnjs) e o @import do
       Google Fonts. Os ícones agora são SVG embutido (ux-icons) e o carrossel só é
       carregado na página que tem carrossel. #}
    {% set usaCarrossel = usa_carrossel(_context) %}


    {# Só a família do título é pré-carregada. Todas elas têm `font-display: swap`, então o
       texto já aparece na fonte de reserva; pré-carregar duas ou três ao mesmo tempo só
       tirava banda da imagem do topo — num site com duas famílias eram 79 KB na frente da
       imagem do LCP. As demais carregam na ordem normal. #}
    {% for arquivo in tenant_fontes()|slice(0, 1) %}
        <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ asset(arquivo) }}">
    {% endfor %}
    {% if usaCarrossel %}
        {# O mínimo para o primeiro slide já está no app.css; o resto do Swiper entra
           sem bloquear a renderização. #}
        <link rel="stylesheet" href="{{ asset('bibliotecas/swiper/swiper-bundle.min.css') }}"
              media="print" onload="this.media='all';this.onload=null">
        <noscript><link rel="stylesheet" href="{{ asset('bibliotecas/swiper/swiper-bundle.min.css') }}"></noscript>
    {% endif %}

    {# Apply theme BEFORE paint to prevent flash #}
    <script>
    (function(){
        var saved = localStorage.getItem('wab-theme') || 'light';
        var dark = saved === 'auto'
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
            : saved === 'dark';
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        if (dark) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    })();
    </script>

    <style>
    /* ── Design Tokens & Base Styles ── */
    :root {
        --font-headline: 'Outfit', 'Inter', system-ui, sans-serif;
        --font-body: 'Inter', system-ui, sans-serif;
        --radius: 12px;
        --radius-lg: 24px;
        --ease: cubic-bezier(0.34, 1.56, 0.64, 1);
        
        /* Default colors overridden by tenant_css_vars */
        --bg: #ffffff;
        --bg-alt: #f8fafc;
        --bg-card: #ffffff;
        --bg-glass: rgba(255,255,255,.92);
        --text: #1a1a1a;
        --text-muted: #64748b;
        --border: rgba(0,0,0,.08);
        --header-bg: rgba(255,255,255,.95);
        --header-border: rgba(0,0,0,.06);
    }
    
    [data-theme="dark"] {
        --bg: #0d0f1a;
        --bg-alt: #131625;
        --bg-card: #181c30;
        --bg-glass: rgba(24,28,48,.92);
        --text: #f1f5f9;
        --text-muted: #94a3b8;
        --border: rgba(255,255,255,.08);
        --header-bg: rgba(13,15,26,.95);
        --header-border: rgba(255,255,255,.08);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; }
    body {
        font-family: var(--font-body);
        background: var(--bg);
        color: var(--text);
        line-height: 1.7;
        overflow-x: hidden;
        transition: background .25s, color .25s;
    }
    a { color: var(--color-secondary); text-decoration: none; transition: opacity .2s; }
    a:hover { opacity: .8; }
    img { max-width: 100%; height: auto; display: block; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }

    /* Custom Theme Toggle button */
    #wab-theme-btn {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .4rem .9rem; border-radius: 50px; border: 1px solid var(--border);
        background: var(--bg-card); color: var(--text); font-size: .82rem;
        font-weight: 600; cursor: pointer; transition: all .2s; white-space: nowrap;
    }
    #wab-theme-btn:hover { border-color: var(--color-secondary); }

    /* Swiper & AOS overrides */
    .swiper-pagination-bullet-active {
        background: var(--color-secondary) !important;
    }
    .swiper-button-next, .swiper-button-prev {
        color: #ffffff !important;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }
    .swiper-button-next:hover, .swiper-button-prev:hover {
        color: var(--color-secondary) !important;
    }

    /* Flashes */
    .flash { padding:1rem 1.5rem; border-radius:var(--radius); margin:1rem 0; font-weight:500; }
    .flash-success { background:rgba(16,185,129,.15); color:#065f46; border:1px solid rgba(16,185,129,.3); }
    .flash-error   { background:rgba(239,68,68,.15); color:#991b1b; border:1px solid rgba(239,68,68,.3); }
    [data-theme="dark"] .flash-success { color:#6ee7b7; }
    [data-theme="dark"] .flash-error   { color:#fca5a5; }

    /* WhatsApp floating button */
    .whatsapp-float {
        position: fixed;
        bottom: 28px;
        right: 28px;
        background: #25d366;
        color: white;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.25);
        z-index: 999;
        transition: transform 0.2s, background 0.2s;
        text-decoration: none;
    }
    .whatsapp-float:hover {
        background: #1ebd59;
        transform: scale(1.1);
        color: white;
    }

    /* Dark section classes to adapt layout seamlessly */
    .mp-section-dark {
        --bg: #0d0f1a;
        --bg-alt: #131625;
        --bg-card: #181c30;
        --bg-glass: rgba(24,28,48,.92);
        --text: #f1f5f9;
        --text-muted: #94a3b8;
        --border: rgba(255,255,255,.08);
        --link: #ffffff;
        color: var(--text);
        background-color: var(--bg-alt);
    }
    </style>

    {% block stylesheets %}{% endblock %}

    {# ── Google Analytics (GA4) ── #}
    {% if currentTenant and currentTenant.googleAnalyticsId %}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ currentTenant.googleAnalyticsId|e('html_attr') }}"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '{{ currentTenant.googleAnalyticsId|e('js') }}');
    </script>
    {% endif %}
</head>
<body>

    {% include 'themes/cetec/_header.html.twig' %}

    <main>
        {% for msg in app.flashes('success') %}
            <div class="container"><div class="flash flash-success">{{ msg }}</div></div>
        {% endfor %}
        {% for msg in app.flashes('error') %}
            <div class="container"><div class="flash flash-error">{{ msg }}</div></div>
        {% endfor %}
        {% block body %}{% endblock %}
    </main>

    {% include 'themes/cetec/_footer.html.twig' %}

    <!-- WhatsApp Floating Dynamic -->
    {% if currentTenant and currentTenant.whatsappLink %}
        <a href="{{ currentTenant.whatsappLink }}" target="_blank" rel="noopener"
           aria-label="Fale conosco pelo WhatsApp" class="whatsapp-float">
            {{ ux_icon('bi:whatsapp', {'aria-hidden': 'true'}) }}
        </a>
    {% endif %}

    {# Carrossel só na página que tem carrossel; animação de entrada sem biblioteca #}
    {% if usaCarrossel %}
        {# O Swiper entra depois do load, pelo assets/carrossel.js; os blocos esperam
           o evento 'swiper:pronto'. O primeiro slide já aparece sem ele. #}
        <script src="{{ asset('carrossel.js') }}" defer
                data-swiper="{{ asset('bibliotecas/swiper/swiper-bundle.min.js') }}"></script>
    {% endif %}
    <script src="{{ asset('animacoes.js') }}" defer></script>
    <script src="{{ asset('imagens-adiadas.js') }}" defer></script>
    
    <script>
    // Theme Toggler
    const MODES = ['dark', 'light', 'auto'];
    const MODE_LABELS = {
        dark:  '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px"><path d="M21 12.79A9 9 0 1111.21 3a7 7 0 0010 9.79z"/></svg> Escuro',
        light: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg> Claro',
        auto:  '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px"><path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zm0 2v16a8 8 0 0 1 0-16z"/></svg> Auto'
    };

    function applyTheme(mode) {
        const dark = mode === 'auto'
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
            : mode === 'dark';
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        if (dark) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
        localStorage.setItem('wab-theme', mode);
        const btn = document.getElementById('wab-theme-btn');
        if (btn) btn.innerHTML = MODE_LABELS[mode];
    }

    function cycleTheme() {
        const cur = localStorage.getItem('wab-theme') || 'light';
        const next = MODES[(MODES.indexOf(cur) + 1) % MODES.length];
        applyTheme(next);
    }

    document.addEventListener('DOMContentLoaded', () => {
        const cur = localStorage.getItem('wab-theme') || 'light';
        const btn = document.getElementById('wab-theme-btn');
        if (btn) btn.innerHTML = MODE_LABELS[cur];
        
    });

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if ((localStorage.getItem('wab-theme') || 'light') === 'auto') applyTheme('auto');
    });
    </script>

    {% block javascripts %}{% endblock %}
</body>
</html>
