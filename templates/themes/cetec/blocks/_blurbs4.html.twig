{% set config = block.config ?? {} %}
{% set items_list = [] %}
{% if config.items is defined and config.items is iterable %}
    {% for it in config.items %}
        {% if it.title is defined and it.title %}
            {% set items_list = items_list|merge([{
                'icon': it.icon ?? null,
                'title': it.title,
                'text': it.text ?? null,
                'link': it.link ?? null,
                'linkTarget': it.linkTarget ?? '_self'
            }]) %}
        {% endif %}
    {% endfor %}
{% endif %}

{% if items_list|length == 0 %}
    {% for i in 1..4 %}
        {% set title = config['item' ~ i ~ '_title'] ?? null %}
        {% if title %}
            {% set items_list = items_list|merge([{
                'icon': config['item' ~ i ~ '_icon'] ?? null,
                'title': title,
                'text': config['item' ~ i ~ '_text'] ?? null,
                'link': null,
                'linkTarget': '_self'
            }]) %}
        {% endif %}
    {% endfor %}
{% endif %}

{% set has_items = items_list|length > 0 %}
{% if block.title or block.text or block.preTitle or has_items %}
<div class="wab-block my-16">
    <div class="text-center max-w-3xl mx-auto mb-12" data-aos="fade-up">
        {% if block.preTitle %}<span class="inline-block bg-cetec-secondary/30 text-cetec-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-3">{{ block.preTitle }}</span>{% endif %}
        {% if block.title %}<h2 class="text-2xl md:text-4xl font-extrabold mb-3 text-cetec-primary">{{ block.title }}</h2>{% endif %}
        <div class="w-16 h-1 bg-cetec-secondary mx-auto mb-4 rounded-full"></div>
        {% if block.text %}<p class="text-gray-500 dark:text-gray-400 text-sm max-w-xl mx-auto">{{ block.text }}</p>{% endif %}
    </div>
    
    {% if has_items %}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-4xl">
        {% for it in items_list %}
        {% set delay = loop.index0 * 200 %}
        {% set card_classes = "bg-white dark:bg-cetec-dark p-6 rounded-2xl shadow-lg hover:shadow-2xl flex flex-col items-center text-center border border-gray-100 dark:border-white/5 group hover:border-cetec-secondary/50 transition-all duration-300 transform hover:-translate-y-1" %}
        {% if it.link %}
            <a href="/{{ it.link }}" target="{{ it.linkTarget }}" class="{{ card_classes }}"
               data-aos="fade-up"
               data-aos-delay="{{ delay }}">
        {% else %}
            <div class="{{ card_classes }}"
                 data-aos="fade-up"
                 data-aos-delay="{{ delay }}">
        {% endif %}
            {% if it.icon %}
            <div class="w-14 h-14 bg-cetec-secondary/10 rounded-2xl flex items-center justify-center text-2xl text-cetec-secondary mb-4 group-hover:bg-cetec-secondary group-hover:text-cetec-dark transition-all duration-300">
                <i class="{{ it.icon }}"></i>
            </div>
            {% endif %}
            <h3 class="text-lg font-bold mb-2 text-cetec-primary group-hover:text-cetec-secondary transition-colors">{{ it.title }}</h3>
            {% if it.text %}<p class="text-gray-500 dark:text-gray-400 text-xs md:text-sm leading-relaxed">{{ it.text }}</p>{% endif %}
        {% if it.link %}
            </a>
        {% else %}
            </div>
        {% endif %}
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endif %}
