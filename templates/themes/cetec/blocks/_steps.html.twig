{# Etapas (steps): até 6 passos numerados. #}
{% set etapas = (block.config.steps ?? [])|filter(e => (e.title ?? '')|trim != '') %}
{% if etapas|length > 0 or block.title %}
{% set colunas = {1: 'lg:grid-cols-1', 2: 'lg:grid-cols-2', 3: 'lg:grid-cols-3', 4: 'lg:grid-cols-4', 5: 'lg:grid-cols-3', 6: 'lg:grid-cols-3'}[etapas|length] ?? 'lg:grid-cols-4' %}
<div class="wab-block my-12" data-aos="fade-up">
    <div class="text-center max-w-3xl mx-auto mb-12">
        {% if block.preTitle %}{% include 'themes/cetec/blocks/_pre_title.html.twig' with {text: block.preTitle} %}{% endif %}
        {% if block.title %}<h2 class="text-2xl md:text-4xl font-extrabold mb-3 text-cetec-primary-text">{{ block.title }}</h2>{% endif %}
        <div class="w-16 h-1 bg-cetec-secondary mx-auto mb-4 rounded-full"></div>
        {% if block.text %}<p class="text-gray-600 dark:text-gray-400 text-sm max-w-xl mx-auto">{{ block.text }}</p>{% endif %}
    </div>
    {% if etapas|length > 0 %}
    <ol class="grid sm:grid-cols-2 {{ colunas }} gap-8 list-none p-0 m-0">
        {% for e in etapas %}
        <li class="border-t-2 border-cetec-secondary/40 pt-5">
            <div class="text-xs font-black tracking-widest uppercase text-cetec-secondary-text">{{ (e.label ?? '')|trim ?: '%02d'|format(loop.index) }}</div>
            <h3 class="text-lg font-bold text-cetec-primary-text mt-4 mb-2">{{ e.title }}</h3>
            {% if e.text ?? null %}<p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{{ e.text }}</p>{% endif %}
        </li>
        {% endfor %}
    </ol>
    {% endif %}
</div>
{% endif %}
