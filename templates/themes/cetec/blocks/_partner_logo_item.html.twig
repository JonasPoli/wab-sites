{% if logo.url %}
<a href="{{ logo.url }}" target="_blank" rel="noopener" class="pl-logo-item flex items-center justify-center p-6 bg-white dark:bg-cetec-dark border border-gray-100 dark:border-white/5 rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 hover:scale-[1.03] hover:border-cetec-secondary/50 group">
    <img src="{{ asset('uploads/partner_logo/' ~ logo.logoFilename) }}" alt="{{ logo.name }}" loading="lazy" class="max-h-12 max-w-[140px] object-contain filter grayscale opacity-60 group-hover:filter-none group-hover:opacity-100 transition-all duration-300">
</a>
{% else %}
<div class="pl-logo-item flex items-center justify-center p-6 bg-white dark:bg-cetec-dark border border-gray-100 dark:border-white/5 rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 hover:scale-[1.03] hover:border-cetec-secondary/50 group">
    <img src="{{ asset('uploads/partner_logo/' ~ logo.logoFilename) }}" alt="{{ logo.name }}" loading="lazy" class="max-h-12 max-w-[140px] object-contain filter grayscale opacity-60 group-hover:filter-none group-hover:opacity-100 transition-all duration-300">
</div>
{% endif %}
