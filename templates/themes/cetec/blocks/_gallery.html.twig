{% set images = block.galleryImages %}
{% if images|length > 0 %}
<div class="wab-block my-16" data-aos="fade-up">
    <div class="text-center max-w-3xl mx-auto mb-10">
        {% if block.preTitle %}<span class="text-cetec-orange font-bold uppercase tracking-widest text-xs mb-2 block">{{ block.preTitle }}</span>{% endif %}
        {% if block.title %}<h2 class="text-2xl md:text-4xl font-extrabold mb-3">{{ block.title }}</h2>{% endif %}
        <div class="w-16 h-1 bg-cetec-orange mx-auto mb-4 rounded-full"></div>
        {% if block.text %}<p class="text-gray-500 dark:text-gray-400 text-sm max-w-xl mx-auto">{{ block.text }}</p>{% endif %}
    </div>
    
    <div class="wab-gallery relative overflow-hidden rounded-2xl shadow-xl border border-gray-100 dark:border-white/5" id="gallery-{{ block.id }}">
        <div class="wg-track flex transition-transform duration-[400ms] cubic-bezier(0.34, 1.56, 0.64, 1)">
            {% for img in images %}
            <div class="wg-slide min-w-full cursor-zoom-in group relative" onclick="openLightbox('{{ block.id }}', {{ loop.index0 }})">
                <img src="{{ asset('uploads/page_block_gallery/' ~ img.filename) }}" alt="{{ img.caption }}" loading="lazy" class="w-full aspect-[16/9] object-cover rounded-2xl transition-transform duration-500 group-hover:scale-[1.02]">
                {% if img.caption %}
                <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 to-transparent p-6 rounded-b-2xl">
                    <p class="text-white text-sm md:text-base font-semibold">{{ img.caption }}</p>
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        
        {% if images|length > 1 %}
        <button class="wg-btn wg-prev absolute left-4 top-1/2 -translate-y-1/2 bg-white/90 dark:bg-cetec-dark/90 hover:bg-cetec-orange hover:text-white text-cetec-dark dark:text-white w-12 h-12 rounded-full flex items-center justify-center border border-gray-200 dark:border-white/10 shadow-lg cursor-pointer transition-all duration-300 z-10" onclick="slideGallery('{{ block.id }}', -1)"><i class="fa-solid fa-chevron-left"></i></button>
        <button class="wg-btn wg-next absolute right-4 top-1/2 -translate-y-1/2 bg-white/90 dark:bg-cetec-dark/90 hover:bg-cetec-orange hover:text-white text-cetec-dark dark:text-white w-12 h-12 rounded-full flex items-center justify-center border border-gray-200 dark:border-white/10 shadow-lg cursor-pointer transition-all duration-300 z-10" onclick="slideGallery('{{ block.id }}', 1)"><i class="fa-solid fa-chevron-right"></i></button>
        
        <div class="wg-dots flex justify-center gap-2 mt-6">
            {% for img in images %}
            <span class="wg-dot w-2.5 h-2.5 rounded-full bg-gray-300 dark:bg-white/20 cursor-pointer transition-all duration-300 {{ loop.first ? 'active !bg-cetec-orange !w-6' : '' }}" onclick="goSlide('{{ block.id }}', {{ loop.index0 }})"></span>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</div>

<div class="wab-lightbox fixed inset-0 bg-black/95 hidden items-center justify-center z-[9999] cursor-zoom-out" id="lb-{{ block.id }}" onclick="closeLightbox('{{ block.id }}')">
    <button onclick="closeLightbox('{{ block.id }}')" class="fixed top-6 right-6 bg-transparent border-0 text-white text-4xl cursor-pointer hover:text-cetec-orange transition-colors">&times;</button>
    <img id="lb-img-{{ block.id }}" src="" class="max-w-[90vw] max-h-[85vh] rounded-2xl border-4 border-white/10 shadow-2xl">
</div>

<style>
.wg-dot.active {
    background-color: #FE6102 !important;
    width: 1.5rem !important;
}
</style>

<script>
(function(){
    window.galleries = window.galleries || {};
    window.slideGallery = window.slideGallery || function(id, dir) {
        const g = window.galleries[id] || (window.galleries[id] = { idx: 0, total: document.querySelectorAll('#gallery-' + id + ' .wg-slide').length });
        g.idx = (g.idx + dir + g.total) % g.total;
        document.querySelector('#gallery-' + id + ' .wg-track').style.transform = 'translateX(-' + g.idx * 100 + '%)';
        document.querySelectorAll('#gallery-' + id + ' .wg-dot').forEach((d, i) => {
            d.classList.toggle('active', i === g.idx);
            if (i === g.idx) {
                d.classList.add('!bg-cetec-orange', '!w-6');
            } else {
                d.classList.remove('!bg-cetec-orange', '!w-6');
            }
        });
    };
    window.goSlide = window.goSlide || function(id, idx) {
        window.galleries[id] = { idx, total: document.querySelectorAll('#gallery-' + id + ' .wg-slide').length };
        window.slideGallery(id, 0);
    };
    window.openLightbox = window.openLightbox || function(id, idx) {
        const imgs = document.querySelectorAll('#gallery-' + id + ' .wg-slide img');
        document.getElementById('lb-img-' + id).src = imgs[idx].src;
        document.getElementById('lb-' + id).style.display = 'flex';
    };
    window.closeLightbox = window.closeLightbox || function(id) {
        document.getElementById('lb-' + id).style.display = 'none';
    };

    const currentId = '{{ block.id }}';
    window.galleries[currentId] = { idx: 0, total: document.querySelectorAll('#gallery-' + currentId + ' .wg-slide').length };
})();
</script>
{% endif %}
