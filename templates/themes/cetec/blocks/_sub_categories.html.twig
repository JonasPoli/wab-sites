{% set cat = block.relatedCategory %}
{% if cat %}
    {% set pages = cat.pages %}
    {% if pages is empty and cat.children|length > 0 %}
        {% set pages = [] %}
        {% for child in cat.children %}
            {% for p in child.pages %}
                {% set pages = pages|merge([p]) %}
            {% endfor %}
        {% endfor %}
    {% endif %}
<div class="wab-block my-16" data-aos="fade-up">
    <div class="text-center max-w-3xl mx-auto mb-12">
        {% if block.preTitle %}<span class="inline-block bg-cetec-secondary/30 text-cetec-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-3">{{ block.preTitle }}</span>{% endif %}
        {% if block.title %}<h2 class="text-2xl md:text-4xl font-extrabold mb-3 text-cetec-primary">{{ block.title }}</h2>{% endif %}
        <div class="w-16 h-1 bg-cetec-secondary mx-auto mb-4 rounded-full"></div>
        {% if block.text %}<p class="text-gray-500 dark:text-gray-400 text-sm max-w-xl mx-auto">{{ block.text }}</p>{% endif %}
    </div>
    
    {% if pages|length > 0 %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 bg-transparent">
        {% for page in pages %}
        <a href="{{ path('pub_page_show', {slug: page.slug}) }}" class="flex flex-col items-center text-center bg-transparent group cursor-pointer transition-transform duration-300 transform hover:-translate-y-2">
            <div class="w-full h-60 flex items-center justify-center bg-transparent overflow-hidden mb-4">
                {% if page.coverImage %}
                    <img src="{{ asset('uploads/page_cover/' ~ page.coverImage) }}" alt="{{ page.title }}" class="max-w-full max-h-full w-auto h-auto object-contain bg-transparent transition-transform duration-500 group-hover:scale-105 group-hover:drop-shadow-lg" loading="lazy">
                {% else %}
                    <div class="text-5xl text-gray-300 dark:text-white/20 bg-transparent flex items-center justify-center w-full h-full">
                        <i class="bi bi-image"></i>
                    </div>
                {% endif %}
            </div>
            <h3 class="text-lg md:text-xl font-bold text-cetec-primary group-hover:text-cetec-secondary transition-colors duration-300">
                {{ page.title }}
            </h3>
        </a>
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endif %}
