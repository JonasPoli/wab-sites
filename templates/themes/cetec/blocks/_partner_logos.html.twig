{% set logos = block.partnerLogos %}
{% if logos|length > 0 %}
<div class="wab-block my-16" data-aos="fade-up">
    <div class="text-center max-w-3xl mx-auto mb-10">
        {% if block.preTitle %}<span class="text-cetec-orange font-bold uppercase tracking-widest text-xs mb-2 block">{{ block.preTitle }}</span>{% endif %}
        {% if block.title %}<h2 class="text-2xl md:text-4xl font-extrabold mb-3">{{ block.title }}</h2>{% endif %}
        <div class="w-16 h-1 bg-cetec-orange mx-auto mb-4 rounded-full"></div>
        {% if block.text %}<p class="text-gray-500 dark:text-gray-400 text-sm max-w-xl mx-auto">{{ block.text }}</p>{% endif %}
    </div>

    {% set style = block.config ? (block.config.style ?? 'grid') : 'grid' %}
    {% set cols = block.config ? (block.config.columns ?? 4) : 4 %}

    {% if style == 'carousel' %}
    <div class="pl-carousel-wrap overflow-hidden relative">
        <div class="pl-carousel flex gap-6 w-max animate-[scrollLogos_25s_linear_infinite] hover:[animation-play-state:paused] py-4">
            {% for logo in logos %}
                {% include 'themes/cetec/blocks/_partner_logo_item.html.twig' %}
            {% endfor %}
            {# Duplicate for infinite loop #}
            {% for logo in logos %}
                {% include 'themes/cetec/blocks/_partner_logo_item.html.twig' %}
            {% endfor %}
        </div>
    </div>
    <style>
    @keyframes scrollLogos {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
    </style>
    {% else %}
    <div class="grid gap-6" style="grid-template-columns: repeat({{ cols }}, minmax(0, 1fr));">
        {% for logo in logos %}
            {% include 'themes/cetec/blocks/_partner_logo_item.html.twig' %}
        {% endfor %}
    </div>
    {% endif %}
</div>
{% endif %}
