{% if block.title or block.text or block.preTitle or block.image %}
{% set pos = block.config ? (block.config.imagePosition ?? 'right') : 'right' %}
<div class="wab-block flex flex-col {{ pos == 'left' ? 'lg:flex-row-reverse' : 'lg:flex-row' }} items-center gap-12 lg:gap-16 py-8">
    <div class="flex-1 w-full text-left">
        {% if block.preTitle %}
            <span class="inline-block bg-cetec-orange/10 text-cetec-orange px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-3">
                {{ block.preTitle }}
            </span>
        {% endif %}
        {% if block.title %}
            <h2 class="text-2xl md:text-4xl font-extrabold mb-4 text-cetec-dark dark:text-white leading-tight">
                {{ block.title }}
            </h2>
        {% endif %}
        {% if block.text %}
            <div class="text-gray-600 dark:text-gray-300 text-sm md:text-base leading-relaxed space-y-4">
                {{ block.text|nl2br }}
            </div>
        {% endif %}
        {% if block.config and (block.config.ctaText ?? null) and (block.config.ctaLink ?? null) %}
            <div class="mt-6">
                <a href="{{ block.config.ctaLink }}" class="bg-cetec-orange hover:brightness-90 text-white px-6 py-3 rounded-md font-black text-sm shadow-md transition-all inline-block">
                    {{ block.config.ctaText }}
                </a>
            </div>
        {% endif %}
    </div>
    {% if block.image %}
    <div class="flex-1 w-full relative">
        <div class="absolute -top-4 -left-4 w-24 h-24 bg-cetec-orange/5 rounded-full blur-2xl"></div>
        <div class="absolute -bottom-4 -right-4 w-24 h-24 bg-cetec-orange/5 rounded-full blur-2xl"></div>
        <img src="{{ asset('uploads/page_block/' ~ block.image) }}" 
             alt="{{ block.title }}" 
             loading="lazy" 
             class="w-full h-auto object-cover rounded-2xl shadow-xl border border-gray-100 dark:border-white/5 max-h-[380px] relative z-10">
    </div>
    {% endif %}
</div>
{% endif %}
