{% extends 'themes/cetec/base.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block meta_description %}
{% if category.description %}
<meta name="description" content="{{ category.description|striptags|slice(0,160) }}">
{% endif %}
{% endblock %}

{% block body %}

{# ── Category Hero ── #}
<div class="cetec-page-hero py-12 md:py-16 bg-gray-50 dark:bg-cetec-dark/40 border-b border-gray-100 dark:border-white/5 text-center relative overflow-hidden">
    <div class="absolute -top-12 -left-12 w-48 h-48 bg-cetec-secondary/5 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-12 -right-12 w-48 h-48 bg-cetec-secondary/5 rounded-full blur-3xl"></div>
    
    <div class="container mx-auto px-4 relative z-10">
        {% if category.parent %}
            <a href="{{ path('pub_category', {slug: category.parent.slug}) }}" class="inline-block bg-cetec-secondary/30 text-cetec-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-3 hover:bg-cetec-secondary/40 transition-all">
                <i class="bi bi-chevron-left"></i> {{ category.parent.name }}
            </a>
        {% endif %}
        
        {% if category.icon %}
            <div class="text-cetec-secondary text-4xl mb-3">
                <i class="{{ category.icon }}"></i>
            </div>
        {% endif %}
        
        <h1 class="text-3xl md:text-5xl font-black text-cetec-primary leading-tight">
            {{ category.name }}
        </h1>
        
        {% if category.description %}
            <p class="text-gray-500 dark:text-gray-400 max-w-xl mx-auto mt-3 text-sm md:text-base leading-relaxed">
                {{ category.description }}
            </p>
        {% endif %}
    </div>
</div>

{# ── Subcategories Grid ── #}
{% if category.children is defined and category.children|length > 0 %}
<section class="py-16 bg-white dark:bg-cetec-dark border-b border-gray-100 dark:border-white/5">
    <div class="container mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-extrabold mb-8 text-cetec-primary border-l-4 border-cetec-secondary pl-3">Subcategorias</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for sub in category.children %}
            <a href="{{ path('pub_category', {slug: sub.slug}) }}" class="bg-gray-50 dark:bg-cetec-dark/50 p-6 rounded-2xl border border-gray-100 dark:border-white/5 shadow-sm hover:shadow-md hover:border-cetec-secondary/50 transition-all transform hover:-translate-y-1 group">
                <div class="flex items-center gap-4 mb-3">
                    <div class="w-12 h-12 bg-cetec-secondary/15 rounded-xl flex items-center justify-center text-cetec-secondary text-2xl group-hover:bg-cetec-secondary group-hover:text-cetec-dark transition-all duration-300">
                        {% if sub.icon %}
                            <i class="{{ sub.icon }}"></i>
                        {% else %}
                            <i class="bi bi-tag-fill"></i>
                        {% endif %}
                    </div>
                    <h3 class="text-lg font-bold group-hover:text-cetec-secondary transition-colors">{{ sub.name }}</h3>
                </div>
                {% if sub.description %}
                    <p class="text-gray-500 dark:text-gray-400 text-xs line-clamp-2">{{ sub.description }}</p>
                {% endif %}
            </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ── Category Pages List ── #}
{% if category.pages is defined and category.pages|length > 0 %}
<section class="py-16 bg-gray-50 dark:bg-cetec-dark/40 border-b border-gray-100 dark:border-white/5">
    <div class="container mx-auto px-4">
        {% if not (category.children is defined and category.children|length > 0) %}
            <h2 class="text-2xl md:text-3xl font-extrabold mb-8 text-cetec-primary border-l-4 border-cetec-secondary pl-3">Cursos e Páginas</h2>
        {% endif %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {% for page in category.pages %}
            <a href="{{ path('pub_page_show', {slug: page.slug}) }}" class="bg-white dark:bg-cetec-dark rounded-2xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100 dark:border-white/5 flex flex-col group">
                {% if page.coverImage %}
                    <div class="h-48 overflow-hidden relative">
                        <img src="{{ asset('uploads/page_cover/' ~ page.coverImage) }}" alt="{{ page.title }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
                    </div>
                {% else %}
                    <div class="h-48 bg-cetec-secondary/5 dark:bg-cetec-dark/80 flex items-center justify-center text-5xl text-cetec-secondary/40">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>
                {% endif %}
                <div class="p-6 flex-1 flex flex-col justify-between">
                    <div>
                        <h3 class="text-xl font-bold mb-3 group-hover:text-cetec-secondary transition-colors">{{ page.title }}</h3>
                        {% if page.seoDescription %}
                            <p class="text-gray-500 dark:text-gray-400 text-xs line-clamp-3 mb-6">{{ page.seoDescription }}</p>
                        {% endif %}
                    </div>
                    <span class="text-cetec-secondary font-bold text-sm flex items-center gap-2 mt-auto">
                        Saiba mais <i class="bi bi-arrow-right"></i>
                    </span>
                </div>
            </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ── Category Sections ── #}
{% for section in category.sections %}{% if section.active %}

    {% set sectionStyle = '' %}
    {% set sectionClass = 'cetec-section py-16 border-b border-gray-100 dark:border-white/5 relative' %}
    {% set isDark = false %}
    {% if section.bgType in ['image', 'video', 'gradient'] %}
        {% set isDark = true %}
    {% elseif section.bgType == 'color' and section.bgColor %}
        {% set isDark = is_dark_color(section.bgColor) %}
    {% endif %}

    {% if isDark %}
        {% set sectionClass = sectionClass ~ ' mp-section-dark text-white' %}
    {% endif %}

    {% if section.bgType == 'color' and section.bgColor %}
        {% set sectionStyle = 'background-color:' ~ section.bgColor %}
    {% elseif section.bgType == 'gradient' and section.bgGradient %}
        {% set sectionStyle = 'background:linear-gradient(' ~ section.bgGradient ~ ')' %}
    {% elseif section.bgType in ['image', 'video'] %}
        {% set sectionStyle = 'position:relative;overflow:hidden' %}
    {% endif %}

    <section class="{{ sectionClass }}" style="{{ sectionStyle }}">
        {# Background Image layer #}
        {% if section.bgType == 'image' and section.bgImage %}
            <div class="absolute inset-0 bg-cover bg-center pointer-events-none" 
                 style="background-image:url('{{ asset('uploads/section/bg/' ~ section.bgImage) }}'); background-position:{{ section.bgImagePosition }}; opacity:{{ section.bgImageOpacity / 100 }}; z-index:0;"></div>
        {% endif %}
        
        {# Background Video layer #}
        {% if section.bgType == 'video' and section.bgVideo %}
            <video autoplay muted loop playsinline class="absolute inset-0 w-full h-full object-cover pointer-events-none" style="z-index:0">
                <source src="{{ asset('uploads/section/video/' ~ section.bgVideo) }}" type="video/mp4">
            </video>
            {% if section.bgColor %}
                <div class="absolute inset-0 pointer-events-none" style="background:{{ section.bgColor }}; opacity:.5; z-index:1"></div>
            {% endif %}
        {% endif %}

        <div class="container mx-auto px-4 relative z-10">
            {# Two-tone Section Title #}
            {% if (currentTenant.showSectionTitles ?? true) and (section.titlePart1 or section.titlePart2) %}
                <div class="flex flex-wrap justify-center mb-12 rounded-lg overflow-hidden text-center max-w-2xl mx-auto shadow-md">
                    {% if section.titlePart1 %}
                        <span class="bg-cetec-dark text-white px-6 py-2.5 font-extrabold text-lg flex-1 md:flex-none">{{ section.titlePart1 }}</span>
                    {% endif %}
                    {% if section.titlePart2 %}
                        <span class="bg-cetec-secondary text-white px-6 py-2.5 font-extrabold text-lg flex-1 md:flex-none">{{ section.titlePart2 }}</span>
                    {% endif %}
                </div>
            {% endif %}

            {# Blocks Renderer #}
            <div class="space-y-12">
                {% for block in section.blocks %}
                    {% include 'themes/cetec/_block.html.twig' %}
                {% endfor %}
            </div>
        </div>
    </section>

{% endif %}{% endfor %}

{% endblock %}
