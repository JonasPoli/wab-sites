{% extends 'themes/cetec/base.html.twig' %}

{% block title %}{{ member.name }} | {{ currentTenant ? currentTenant.name : '' }}{% endblock %}

{% block meta_description %}
{% if member.summary %}
<meta name="description" content="{{ member.summary|striptags|slice(0,160) }}">
{% endif %}
{% endblock %}

{% block stylesheets %}
<style>
@media print {
    .profile-modern-hero, .profile-action-btn, nav, header, footer { display: none !important; }
    body { background: #fff; color: #000; }
    .profile-modern-grid { grid-template-columns: 1fr !important; }
}

/* Hero split: foto + texto */
.profile-modern-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 520px;
    overflow: hidden;
}
.profile-hero-img-side {
    position: relative; overflow: hidden;
    background: var(--color-primary);
}
.profile-hero-img-side img {
    width: 100%; height: 100%; object-fit: cover; object-position: top;
    filter: brightness(.85) saturate(1.1);
    transition: transform 8s ease;
}
.profile-modern-hero:hover .profile-hero-img-side img { transform: scale(1.06); }
.profile-hero-img-placeholder {
    width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
    font-size: 6rem; color: rgba(255,255,255,.3);
}
.profile-hero-text-side {
    background: linear-gradient(150deg,
        var(--color-primary) 0%,
        color-mix(in srgb, var(--color-primary) 70%, var(--color-secondary)) 100%);
    display: flex; flex-direction: column; justify-content: center;
    padding: 4rem 3.5rem;
}
.profile-back-hero {
    display: inline-flex; align-items: center; gap: .5rem;
    color: rgba(255,255,255,.65); font-size: .82rem;
    text-decoration: none; margin-bottom: 2rem; transition: color .2s;
}
.profile-back-hero:hover { color: #fff; opacity: 1; }
.profile-hero-type {
    display: inline-block;
    background: rgba(255,255,255,.15); backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,.25);
    color: rgba(255,255,255,.9);
    font-size: .68rem; font-weight: 900; letter-spacing: .14em; text-transform: uppercase;
    padding: .3rem .9rem; border-radius: 50px; margin-bottom: 1.25rem;
}
.profile-hero-name {
    font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 900; line-height: 1.05;
    color: #fff; margin: 0 0 2rem;
    font-family: var(--font-headline, 'Outfit', sans-serif);
}
.profile-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
.profile-action-btn {
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .7rem 1.5rem; border-radius: 50px;
    font-size: .85rem; font-weight: 800; letter-spacing: .02em;
    text-decoration: none; cursor: pointer; border: none;
    transition: all .25s cubic-bezier(0.34,1.56,0.64,1);
}
.profile-action-btn-white { background: #fff; color: var(--color-primary); }
.profile-action-btn-white:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(0,0,0,.2); opacity: 1; color: var(--color-primary); }
.profile-action-btn-outline {
    background: rgba(255,255,255,.15); backdrop-filter: blur(8px);
    border: 2px solid rgba(255,255,255,.5); color: #fff;
}
.profile-action-btn-outline:hover { background: rgba(255,255,255,.25); transform: translateY(-3px); opacity: 1; color: #fff; }

/* Body */
.profile-modern-body { padding: 4rem 0 6rem; }
.profile-modern-grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem; align-items: start;
}

/* Cards */
.profile-content-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 24px);
    padding: 2rem 2.5rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 30px rgba(0,0,0,.05);
}
.profile-section-badge {
    display: inline-flex; align-items: center; gap: .5rem;
    background: rgba(var(--color-secondary-rgb),.12);
    color: var(--color-secondary);
    font-size: .65rem; font-weight: 900; text-transform: uppercase; letter-spacing: .12em;
    padding: .3rem .9rem; border-radius: 50px; margin-bottom: 1rem;
}
.profile-summary-text { font-size: 1.05rem; color: var(--text-muted); line-height: 1.8; }
.profile-experience-text { font-size: .95rem; color: var(--text-muted); line-height: 1.8; }
.profile-experience-text p { margin-bottom: 1em; }

/* Sidebar card */
.profile-info-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, 24px);
    overflow: hidden;
    box-shadow: 0 4px 30px rgba(0,0,0,.05);
    position: sticky; top: 100px;
}
.profile-info-section {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
}
.profile-info-section:last-child { border-bottom: none; }
.info-section-title {
    font-size: .62rem; font-weight: 900; text-transform: uppercase;
    letter-spacing: .14em; color: var(--color-secondary); margin-bottom: .75rem;
}
.info-item {
    display: flex; align-items: center; gap: .6rem;
    font-size: .85rem; color: var(--text-muted); margin-bottom: .45rem;
    text-decoration: none; transition: color .2s;
}
.info-item:hover { color: var(--color-primary); opacity: 1; }
.info-item i { width: 16px; text-align: center; color: var(--color-secondary); flex-shrink: 0; }
.info-socials { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .75rem; }
.info-social-btn {
    width: 32px; height: 32px; border-radius: 50%;
    background: rgba(var(--color-secondary-rgb),.1);
    color: var(--text); display: flex; align-items: center; justify-content: center;
    font-size: .85rem; text-decoration: none; transition: all .2s;
}
.info-social-btn:hover { color: #fff; transform: scale(1.1); opacity: 1; }
.info-social-btn.li:hover { background: #0077b5; }
.info-social-btn.fb:hover { background: #1877f2; }
.info-social-btn.ig:hover { background: #e1306c; }

/* Áreas — chips coloridos */
.areas-chips { display: flex; flex-wrap: wrap; gap: .4rem; }
.area-chip {
    display: inline-flex; align-items: center;
    background: rgba(var(--color-secondary-rgb),.1);
    color: var(--color-secondary);
    border: 1px solid rgba(var(--color-secondary-rgb),.25);
    font-size: .75rem; font-weight: 800; padding: .25rem .75rem;
    border-radius: 50px; text-decoration: none; transition: all .2s;
}
.area-chip:hover { background: var(--color-secondary); color: #fff; opacity: 1; }

@media(max-width: 900px) {
    .profile-modern-hero { grid-template-columns: 1fr; }
    .profile-hero-img-side { height: 280px; }
    .profile-hero-text-side { padding: 2.5rem 1.5rem; }
    .profile-modern-grid { grid-template-columns: 1fr; }
    .profile-info-card { position: static; }
}
</style>
{% endblock %}

{% block body %}

{# ── HERO SPLIT ── #}
<section class="profile-modern-hero">
    <div class="profile-hero-img-side">
        {% if member.image %}
        <img src="{{ vich_uploader_asset(member, 'imageFile') }}" alt="{{ member.name }}">
        {% else %}
        <div class="profile-hero-img-placeholder"><i class="fa-solid fa-user-tie"></i></div>
        {% endif %}
    </div>
    <div class="profile-hero-text-side">
        <a href="javascript:history.back()" class="profile-back-hero">
            <i class="fa-solid fa-arrow-left"></i> Voltar
        </a>
        {% if member.role %}
        <div class="profile-hero-type">{{ member.role }}</div>
        {% endif %}
        <h1 class="profile-hero-name">{{ member.name }}</h1>
        <div>
            <button type="button" class="profile-action-btn profile-action-btn-outline" onclick="window.print()">
                <i class="fa-solid fa-file-pdf"></i> Baixar PDF
            </button>
        </div>
    </div>
</section>

{# ── BODY ── #}
<div class="profile-modern-body">
<div class="container">
<div class="profile-modern-grid">

    <div>
        {% if member.summary %}
        <div class="profile-content-card" data-aos="fade-up">
            <p class="profile-summary-text">{{ member.summary }}</p>
        </div>
        {% endif %}

        {% if member.experience or member.bio %}
        <div class="profile-content-card" data-aos="fade-up" data-aos-delay="100">
            <div class="profile-section-badge"><i class="fa-solid fa-briefcase"></i> Experiência</div>
            <div class="profile-experience-text">
                {% if member.experience %}{{ member.experience|raw }}{% else %}{{ member.bio|nl2br }}{% endif %}
            </div>
        </div>
        {% endif %}
    </div>

    <aside>
        <div class="profile-info-card" data-aos="fade-left">
            {% set has_contact = member.email or member.phone or member.address %}
            {% if has_contact %}
            <div class="profile-info-section">
                <div class="info-section-title">Contato</div>
                {% if member.email %}<a href="mailto:{{ member.email }}" class="info-item"><i class="fa-solid fa-envelope"></i> {{ member.email }}</a>{% endif %}
                {% if member.phone %}<a href="tel:{{ member.phone }}" class="info-item"><i class="fa-solid fa-phone"></i> {{ member.phone }}</a>{% endif %}
                {% if member.address %}<div class="info-item"><i class="fa-solid fa-location-dot"></i> {{ member.address }}</div>{% endif %}
                {% if member.linkedinUrl or member.facebookUrl or member.instagramUrl %}
                <div class="info-socials">
                    {% if member.linkedinUrl %}<a href="{{ member.linkedinUrl }}" target="_blank" class="info-social-btn li"><i class="fa-brands fa-linkedin-in"></i></a>{% endif %}
                    {% if member.facebookUrl %}<a href="{{ member.facebookUrl }}" target="_blank" class="info-social-btn fb"><i class="fa-brands fa-facebook-f"></i></a>{% endif %}
                    {% if member.instagramUrl %}<a href="{{ member.instagramUrl }}" target="_blank" class="info-social-btn ig"><i class="fa-brands fa-instagram"></i></a>{% endif %}
                </div>
                {% endif %}
            </div>
            {% endif %}

            {% if member.practiceAreas %}
            <div class="profile-info-section">
                <div class="info-section-title">Áreas de Atuação</div>
                <div class="areas-chips">
                    {% for area in member.practiceAreas %}
                    {% if area.url %}
                    <a href="{{ area.url }}" class="area-chip">{{ area.name }}</a>
                    {% else %}
                    <span class="area-chip">{{ area.name }}</span>
                    {% endif %}
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {% for cs in (member.customSections ?? []) %}
            {% if cs.title or cs.content %}
            <div class="profile-info-section">
                {% if cs.title %}<div class="info-section-title">{{ cs.title }}</div>{% endif %}
                {% if cs.content %}<div style="font-size:.88rem;color:var(--text-muted);line-height:1.5">{{ cs.content }}</div>{% endif %}
            </div>
            {% endif %}
            {% endfor %}
        </div>
    </aside>

</div>
</div>
</div>
{% endblock %}
