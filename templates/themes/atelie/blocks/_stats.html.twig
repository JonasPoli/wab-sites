{# Estatísticas (stats): números grandes em linha. Mesmo formato de dados do cetec. #}
{% set config = block.config ?? {} %}
{% set numeros = [] %}
{% for s in (config.stats ?? []) %}{% if s.number ?? null %}{% set numeros = numeros|merge([{number: s.number, label: s.label ?? null, description: s.description ?? null}]) %}{% endif %}{% endfor %}
{% if numeros|length == 0 %}{% for i in 1..4 %}{% if config['stat' ~ i ~ '_number'] ?? null %}{% set numeros = numeros|merge([{number: config['stat' ~ i ~ '_number'], label: config['stat' ~ i ~ '_label'] ?? null, description: config['stat' ~ i ~ '_description'] ?? null}]) %}{% endif %}{% endfor %}{% endif %}
{% if block.title or block.text or numeros|length %}
{% include 'themes/atelie/blocks/_head.html.twig' %}
{% if numeros|length %}
<div class="at-stats" style="--at-cols:{{ numeros|length < 4 ? numeros|length : 4 }}">
    {% for s in numeros %}
    <div data-aos="fade-up"><strong>{{ s.number }}</strong>{% if s.label %}<span>{{ s.label }}</span>{% endif %}{% if s.description %}<small>{{ s.description }}</small>{% endif %}</div>
    {% endfor %}
</div>
{% endif %}
{% endif %}
