{# Imagem + Texto (text_image). #}
{% if block.title or block.text or block.preTitle or block.image %}
{% set cfg = block.config ?? {} %}
<div class="at-split{{ not block.image ? ' at-split--solo' }}{{ (cfg.imagePosition ?? 'right') == 'left' ? ' at-split--left' }}">
    <div data-aos="fade-up">
        {% if block.preTitle %}<p class="at-eyebrow">{{ block.preTitle }}</p>{% endif %}
        {% if block.title %}<h2 class="at-h2" style="margin:14px 0 20px">{{ block.title }}</h2>{% endif %}
        {% if block.text %}<div class="at-text">{{ block.text|nl2br }}</div>{% endif %}
        {% if (cfg.ctaText ?? null) and (cfg.ctaLink ?? null) %}<p style="margin-top:28px"><a class="at-btn at-btn-primary" href="{{ cfg.ctaLink }}">{{ cfg.ctaText }} <span class="at-arrow" aria-hidden="true">↗</span></a></p>{% endif %}
    </div>
    {% if block.image %}
    <figure class="at-split-media">
        <img {{ ('uploads/page_block/' ~ block.image)|thumb_attrs('bloco_imagem') }} alt="{{ block.title }}" loading="lazy" decoding="async">
    </figure>
    {% endif %}
</div>
{% endif %}
