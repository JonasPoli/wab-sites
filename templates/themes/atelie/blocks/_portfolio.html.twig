{# Portfólio com filtro (portfolio) — "#projetos" do layout de referência. Sem JavaScript, todas as fotos aparecem. #}
{% set cfg = block.config ?? {} %}
{% set fotos = block.galleryImages %}
{% if fotos|length > 0 %}
{% set categorias = {} %}
{% for f in fotos %}{% if f.category %}{% set chave = f.category|lower|trim %}{% if categorias[chave] is not defined %}{% set categorias = categorias|merge({(chave): f.category}) %}{% endif %}{% endif %}{% endfor %}
<div id="portfolio-{{ block.id }}">
    {% include 'themes/atelie/blocks/_head.html.twig' %}
    {% if categorias|length > 1 %}
    <div class="at-filters" role="group" aria-label="Filtrar projetos">
        <button type="button" class="at-filter" data-filtro="*" aria-pressed="true">Todos</button>
        {% for chave, nome in categorias %}<button type="button" class="at-filter" data-filtro="{{ chave }}" aria-pressed="false">{{ nome }}</button>{% endfor %}
    </div>
    {% endif %}
    <div class="at-portfolio-grid">
        {% for f in fotos %}
        {% set arquivo = 'uploads/page_block_gallery/' ~ f.filename %}
        <figure class="at-project{{ loop.first ? ' is-big' }}" data-categoria="{{ f.category ? f.category|lower|trim : '' }}">
            <img {{ arquivo|thumb_attrs(loop.first ? 'portfolio_grande' : 'portfolio') }} alt="{{ f.caption ?: f.title ?: block.title }}" loading="lazy" decoding="async">
            {% if f.title or f.category %}
            <figcaption class="at-project-info">
                {% if f.category %}<small>{{ f.category }}</small>{% endif %}
                {% if f.title %}<strong>{{ f.title }}</strong>{% endif %}
            </figcaption>
            {% endif %}
            <a class="at-zoom" href="{{ asset(arquivo) }}" data-lightbox="portfolio-{{ block.id }}"><span class="at-sr">Ampliar: {{ f.title ?: f.caption ?: 'foto ' ~ loop.index }}</span></a>
        </figure>
        {% endfor %}
    </div>
    {% if (cfg.note ?? null) or ((cfg.ctaText ?? null) and (cfg.ctaLink ?? null)) %}
    <div class="at-projects-note">
        <span>{{ cfg.note ?? '' }}</span>
        {% if (cfg.ctaText ?? null) and (cfg.ctaLink ?? null) %}<a href="{{ cfg.ctaLink }}" class="at-btn at-btn-outline">{{ cfg.ctaText }} <span class="at-arrow" aria-hidden="true">↗</span></a>{% endif %}
    </div>
    {% endif %}
</div>
{% include 'themes/atelie/blocks/_lightbox.html.twig' %}
{% if categorias|length > 1 %}
<script>
(function () {
    var raiz = document.getElementById('portfolio-{{ block.id }}');
    if (!raiz) return;
    var botoes = raiz.querySelectorAll('[data-filtro]');
    Array.prototype.forEach.call(botoes, function (botao) {
        botao.addEventListener('click', function () {
            var filtro = botao.getAttribute('data-filtro');
            Array.prototype.forEach.call(botoes, function (b) { b.setAttribute('aria-pressed', b === botao ? 'true' : 'false'); });
            Array.prototype.forEach.call(raiz.querySelectorAll('[data-categoria]'), function (item) {
                item.classList.toggle('is-oculto', filtro !== '*' && item.getAttribute('data-categoria') !== filtro);
            });
        });
    });
})();
</script>
{% endif %}
{% endif %}
