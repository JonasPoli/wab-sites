{#
  CSS do tema atelie, portado do layout de referência
  (openspec/changes/tema-atelie/referencia/proposta-redesign-marcenaria-pichoneri.html).
  Toda classe tem o prefixo at-; os estilos de elemento ficam presos a .at-root (o <body>),
  para não brigar com o preflight do Tailwind do app.css nem com os outros temas.
  Cores da marca vêm do tenant_css_vars(): --color-primary, --color-primary-text,
  --color-on-primary, --color-secondary-text. Fundos claros: --at-bg e --at-bg2 (base.html.twig).
#}
<style>
.at-root{--at-ink:#29251f;--at-muted:#6b645b;--at-line:#dfd9ce;--at-dark:#292821;--at-paper:#fffefa;--at-card:#ede9e1;--at-radius:3px;
  margin:0;background:var(--at-bg,#f7f5f0);color:var(--at-ink);font-family:'DM Sans',system-ui,-apple-system,'Segoe UI',Arial,sans-serif;font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
.at-root *,.at-root *:before,.at-root *:after{box-sizing:border-box}
.at-root :where(a){color:inherit;text-decoration:none}
.at-root :where(img){display:block;max-width:100%;height:auto}
.at-root :where(button){font:inherit;cursor:pointer}
.at-root :where(h1,h2,h3,h4,h5){font-family:'Manrope','DM Sans',Arial,sans-serif;letter-spacing:-.04em;margin:0;color:inherit;font-weight:600;line-height:1.2}
.at-root :where(p){margin:0 0 1em;line-height:1.75}
.at-root :where(p:last-child){margin-bottom:0}
.at-root :where(ul,ol){margin:0}
.at-root a:focus-visible,.at-root button:focus-visible,.at-root input:focus-visible,.at-root textarea:focus-visible,.at-root select:focus-visible{outline:3px solid #f5ab57;outline-offset:3px}
.at-sr{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

.at-wrap{width:min(1200px,calc(100% - 64px));margin-inline:auto}
.at-section{padding:110px 0;position:relative}
.at-section--flush{padding:0}
.at-section-title{margin-bottom:36px}
.at-eyebrow{display:flex;align-items:center;gap:11px;text-transform:uppercase;letter-spacing:.22em;font-size:11px;font-weight:800;color:var(--color-primary-text);margin:0}
.at-eyebrow:before{content:'';width:29px;height:1px;background:currentColor;flex-shrink:0}
.at-h2{font-weight:600;line-height:1.2;font-size:clamp(30px,4.2vw,52px)}
.at-muted{color:var(--at-muted)}
.at-text{font-size:15px;color:var(--at-muted)}
.at-text strong{color:var(--at-ink)}

.at-btn{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:51px;padding:14px 23px;border:1px solid transparent;border-radius:var(--at-radius);font-size:13px;font-weight:700;letter-spacing:.04em;line-height:1.2;transition:.25s;text-align:center}
.at-btn-primary{background:var(--color-primary);color:var(--color-on-primary)}
.at-btn-primary:hover{filter:brightness(.88);transform:translateY(-2px)}
.at-btn-light{background:#fff;color:var(--at-ink)}
.at-btn-light:hover{background:#f1ede6}
.at-btn-outline{border-color:#cfc8bc;color:var(--at-ink);background:transparent}
.at-btn-outline:hover{background:var(--at-ink);color:#fff}
.at-arrow{font-size:20px;line-height:0}

/* Cabeçalho */
.at-header{position:sticky;top:0;z-index:50;background:rgba(247,245,240,.96);background:color-mix(in srgb,var(--at-bg,#f7f5f0) 96%,transparent);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid rgba(65,51,37,.1)}
.at-nav{min-height:91px;display:flex;align-items:center;justify-content:space-between;gap:24px;position:relative}
.at-logo{display:flex;align-items:center;gap:12px;flex-shrink:0;min-width:0}
.at-logo img{height:58px;width:auto;max-width:170px;object-fit:contain}
.at-logo-words{display:flex;flex-direction:column;gap:2px;min-width:0}
.at-logo-words strong{font-family:'Manrope',sans-serif;font-size:15px;letter-spacing:-.04em;line-height:1.2;text-transform:uppercase}
.at-logo-words small{font-size:10px;color:var(--at-muted);text-transform:uppercase;letter-spacing:.13em;line-height:1.3}
.at-links{display:flex;align-items:center;gap:26px}
.at-links>a:not(.at-btn),.at-dd>button{font-size:13px;font-weight:700;padding:10px 0;background:none;border:0;color:inherit;display:inline-flex;align-items:center;gap:6px}
.at-links>a:not(.at-btn):hover,.at-dd>button:hover{color:var(--color-primary-text)}
.at-links>a[aria-current="page"]{color:var(--color-primary-text)}
.at-dd{position:relative}
.at-dd-menu{display:none;position:absolute;top:100%;left:-16px;background:var(--at-paper);border:1px solid var(--at-line);min-width:220px;padding:8px 0;box-shadow:0 14px 30px rgba(0,0,0,.08);z-index:5}
.at-dd:hover .at-dd-menu,.at-dd:focus-within .at-dd-menu{display:block}
.at-dd-menu a{display:block;padding:9px 16px;font-size:13px;font-weight:600}
.at-dd-menu a:hover{background:var(--at-card)}
.at-menu-toggle{display:none;border:0;background:transparent;color:inherit;width:44px;height:44px;align-items:center;justify-content:center;font-size:26px;line-height:1}

/* Destaque com foto (hero_split) */
.at-hero{padding:44px 0 0}
.at-hero-grid{display:grid;grid-template-columns:42% 58%;min-height:625px}
.at-hero-grid--solo{grid-template-columns:1fr;min-height:0;padding-bottom:70px}
.at-hero-copy{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:35px 45px 55px 0}
.at-hero-title{font-size:clamp(40px,5.1vw,73px);line-height:1.11;font-weight:600;margin:24px 0}
.at-hero-title em{font-style:normal;color:var(--color-primary-text)}
.at-lead{max-width:420px;font-size:15px;color:var(--at-muted);margin-bottom:31px}
.at-hero-photo{position:relative;min-height:570px;overflow:hidden;margin:0;background:#d9d0c5}
.at-hero-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}
.at-hero-photo:after{content:'';position:absolute;inset:45% 0 0;background:linear-gradient(transparent,rgba(19,15,11,.55));pointer-events:none}
.at-hero-caption{position:absolute;z-index:2;bottom:27px;left:30px;right:30px;color:#fff;display:flex;align-items:center;gap:13px;font-size:13px}
.at-hero-caption:before{content:'';width:26px;height:1px;background:#fff;flex-shrink:0}
.at-hero-stamp{position:absolute;z-index:2;right:24px;top:24px;border:1px solid rgba(255,255,255,.72);color:#fff;background:rgba(41,37,31,.39);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);width:110px;height:110px;border-radius:100%;display:flex;justify-content:center;align-items:center;flex-direction:column;font-size:10px;text-align:center;letter-spacing:.08em;text-transform:uppercase;line-height:1.3;padding:0 10px}
.at-hero-stamp strong{font-family:'Manrope',sans-serif;font-size:35px;letter-spacing:-.06em;line-height:1.1;text-transform:none}

/* Faixa de destaques (highlights) */
.at-cred-bar{display:grid;grid-template-columns:repeat(var(--at-cols,4),1fr);background:var(--at-bg2,#eae6dd);margin-top:-1px}
.at-cred-bar>div{padding:31px 30px;border-right:1px solid #d8d1c5;min-height:115px}
.at-cred-bar>div:last-child{border-right:0}
.at-cred-bar strong{display:block;font-size:16px;letter-spacing:-.02em;margin-bottom:4px}
.at-cred-bar span{font-size:12.5px;color:#5f584f;line-height:1.6}

/* Cabeçalho de bloco */
.at-section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:25px;margin-bottom:35px}
.at-section-head h2{max-width:640px;margin:14px 0 0}
.at-section-head>p,.at-section-head>.at-head-text{max-width:330px;font-size:14px;color:var(--at-muted);margin:0 0 6px}
.at-section-head--center{flex-direction:column;align-items:center;text-align:center}
.at-section-head--center .at-eyebrow{justify-content:center}
.at-section-head--center>p,.at-section-head--center>.at-head-text{max-width:620px}

/* Portfólio */
.at-filters{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:27px}
.at-filter{border:1px solid #d6cfc4;background:transparent;padding:11px 19px;color:#5a534a;font-size:12px;font-weight:700;transition:.2s;border-radius:var(--at-radius);min-height:44px}
.at-filter:hover,.at-filter[aria-pressed="true"]{background:var(--at-ink);border-color:var(--at-ink);color:#fff}
.at-portfolio-grid{display:grid;grid-template-columns:1.24fr 1fr 1fr;gap:17px;grid-auto-rows:230px}
.at-project{position:relative;overflow:hidden;background:#d9d0c5;margin:0}
.at-project.is-big{grid-row:span 2}
.at-project.is-oculto{display:none}
.at-portfolio-grid.is-limitado .at-project:nth-child(n+12){display:none}
.at-project img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .65s}
.at-project:hover img{transform:scale(1.05)}
.at-project:after{content:'';position:absolute;inset:35% 0 0;background:linear-gradient(transparent,rgba(22,18,14,.69));pointer-events:none}
.at-project-info{position:absolute;bottom:20px;left:21px;right:20px;z-index:2;color:#fff}
.at-project-info small{display:block;font-size:11px;letter-spacing:.12em;text-transform:uppercase;margin-bottom:5px;opacity:.88}
.at-project-info strong{font-size:15px;font-weight:600;line-height:1.3}
.at-project a.at-zoom{position:absolute;inset:0;z-index:3}
.at-projects-note{display:flex;justify-content:space-between;gap:24px;align-items:center;margin-top:22px;color:var(--at-muted);font-size:12px}

/* Manifesto (statement) */
.at-statement{background:#2c2923;color:#fff;overflow:hidden}
.at-statement-grid{display:grid;grid-template-columns:48% 52%;min-height:560px}
.at-statement-grid--solo{grid-template-columns:1fr;min-height:0}
.at-statement-text{padding:90px max(50px,calc((100vw - 1200px)/2)) 85px max(32px,calc((100vw - 1200px)/2));display:flex;flex-direction:column;justify-content:center}
.at-statement--left .at-statement-image{order:-1}
.at-statement--left .at-statement-text{padding:90px max(32px,calc((100vw - 1200px)/2)) 85px 70px}
.at-statement .at-eyebrow{color:var(--color-secondary-text)}
.at-statement h2{max-width:490px;margin:22px 0;font-weight:500;color:#fff}
.at-statement-body{color:#d0c7b9;max-width:440px;font-size:14px;line-height:1.75}
.at-stat{border-top:1px solid rgba(255,255,255,.23);padding-top:25px;margin-top:24px;display:flex;align-items:center;gap:20px;max-width:440px}
.at-stat strong{font:600 51px/1 'Manrope',sans-serif;letter-spacing:-.06em;color:var(--color-secondary-text)}
.at-stat span{font-size:13px;max-width:200px;line-height:1.5}
.at-statement-image{min-height:500px;position:relative;margin:0}
.at-statement-image img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}

/* Serviços (blurbs4) */
.at-services{display:grid;grid-template-columns:repeat(var(--at-cols,4),1fr);gap:15px}
.at-service{background:var(--at-card);padding:34px 23px 32px;min-height:215px;display:flex;flex-direction:column;align-items:flex-start;transition:.25s}
a.at-service:hover,.at-service:hover{background:#e3dbce;transform:translateY(-4px)}
.at-symbol{color:var(--color-primary-text);margin-bottom:43px;line-height:1;display:block}
.at-symbol svg{width:28px;height:28px}
.at-service h3{font-size:17px;letter-spacing:-.025em;margin:0 0 10px}
.at-service p{font-size:13px;color:var(--at-muted);margin:0}

/* Etapas (steps) */
.at-process{background:var(--at-bg2,#ebe6dc);padding:110px 0}
.at-process-grid{display:grid;grid-template-columns:repeat(var(--at-cols,4),1fr);gap:28px;margin:45px 0 0;padding:0;list-style:none}
.at-step{border-top:1px solid #b9ad9d;padding-top:17px}
.at-number{font-size:12px;color:var(--color-primary-text);letter-spacing:.1em;font-weight:800;text-transform:uppercase}
.at-step h3{font-size:18px;margin:24px 0 9px}
.at-step p{font-size:13px;color:#5f584f;margin:0}

/* Depoimentos */
.at-testimonial{max-width:870px;margin:auto;text-align:center}
.at-testimonial .at-eyebrow{justify-content:center}
.at-quote{margin:0}
.at-quote blockquote{font:500 clamp(21px,3vw,34px)/1.55 'Manrope',sans-serif;letter-spacing:-.035em;margin:31px 0}
.at-quote--long blockquote{font-size:clamp(18px,2.1vw,24px);line-height:1.6}
.at-quote figcaption{display:flex;flex-direction:column;align-items:center;gap:6px}
.at-quote figcaption img{width:56px;height:56px;border-radius:50%;object-fit:cover;margin-bottom:6px}
.at-quote strong{display:block;font-size:14px}
.at-quote small{display:block;color:var(--at-muted);font-size:12px}
.at-stars{color:#b7791f;letter-spacing:3px;font-size:14px;margin-top:4px}
.at-slider{position:relative}
.at-slider-track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;gap:0}
.at-slider-track::-webkit-scrollbar{display:none}
.at-slider-track>*{flex:0 0 100%;scroll-snap-align:center;padding:0 4px}
.at-slider-nav{display:flex;justify-content:center;align-items:center;gap:12px;margin-top:28px}
.at-slider-nav button{width:44px;height:44px;border:1px solid #cfc8bc;background:transparent;border-radius:50%;color:var(--at-ink);display:inline-flex;align-items:center;justify-content:center}
.at-slider-nav button:hover{background:var(--at-ink);color:#fff}
.at-slider-count{font-size:12px;color:var(--at-muted);min-width:48px;text-align:center}

/* Chamada final (cta) */
.at-final-cta{background:var(--color-primary);color:var(--color-on-primary);padding:77px 0}
.at-cta-grid{display:flex;justify-content:space-between;align-items:center;gap:30px}
.at-cta-grid small{display:block;letter-spacing:.2em;font-weight:700;font-size:12px;text-transform:uppercase}
.at-cta-grid h2{font-size:clamp(28px,4vw,49px);max-width:700px;font-weight:500;margin:10px 0 0;color:inherit}
.at-cta-grid p{margin:14px 0 0;opacity:.92;max-width:620px}

/* Vídeo */
.at-media{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.at-media--solo{grid-template-columns:1fr}
.at-media--left .at-media-frame{order:-1}
.at-media-frame{position:relative;background:#1c1a16;overflow:hidden;width:100%}
.at-media-frame--h{aspect-ratio:16/9}
.at-media-frame--v{aspect-ratio:9/16;max-width:340px;margin-inline:auto}
.at-media-frame iframe,.at-media-frame video{position:absolute;inset:0;width:100%;height:100%;border:0;object-fit:cover}
.at-media-copy h2{margin:14px 0 18px}

/* Conteúdo genérico (texto, imagem, números, cartões) */
.at-split{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.at-split--solo{grid-template-columns:1fr;max-width:820px}
.at-split--left .at-split-media{order:-1}
.at-split-media{margin:0;overflow:hidden}
.at-split-media img{width:100%;max-height:520px;object-fit:cover}
.at-rich{font-size:15px;color:var(--at-ink);line-height:1.8;max-width:820px}
.at-rich>*+*{margin-top:1em}
.at-rich h2{font-size:clamp(24px,3vw,34px);margin-top:1.4em}
.at-rich h3{font-size:20px;margin-top:1.3em}
.at-rich a{color:var(--color-primary-text);text-decoration:underline;text-underline-offset:3px}
.at-rich ul,.at-rich ol{padding-left:1.3em}
.at-rich ul{list-style:disc}.at-rich ol{list-style:decimal}
.at-rich blockquote{border-left:2px solid var(--color-primary);padding-left:1em;margin:0;font-style:italic}
.at-stats{display:grid;grid-template-columns:repeat(var(--at-cols,4),1fr);gap:0;border-top:1px solid #b9ad9d}
.at-stats>div{padding:28px 24px 8px 0}
.at-stats strong{display:block;font:600 clamp(36px,4vw,52px)/1 'Manrope',sans-serif;letter-spacing:-.06em;color:var(--color-primary-text)}
.at-stats span{display:block;font-weight:700;margin-top:10px}
.at-stats small{display:block;color:var(--at-muted);font-size:13px;margin-top:4px}
.at-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.at-card{background:var(--at-paper);border:1px solid var(--at-line);display:flex;flex-direction:column;transition:.25s}
.at-card:hover{transform:translateY(-4px);box-shadow:0 18px 30px rgba(41,37,31,.08)}
.at-card-img{aspect-ratio:3/2;overflow:hidden;background:#d9d0c5;display:block}
.at-card-img img{width:100%;height:100%;object-fit:cover;transition:transform .6s}
.at-card:hover .at-card-img img{transform:scale(1.04)}
.at-card-body{padding:22px 22px 24px;display:flex;flex-direction:column;flex:1}
.at-card-meta{display:flex;flex-wrap:wrap;gap:10px;align-items:center;font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:var(--at-muted);margin-bottom:10px}
.at-card-meta a{color:var(--color-primary-text);font-weight:800}
.at-card h3{font-size:18px;line-height:1.3;margin:0 0 10px}
.at-card p{font-size:13px;color:var(--at-muted);margin:0 0 16px}
.at-card-more{margin-top:auto;font-size:13px;font-weight:700;display:inline-flex;align-items:center;gap:10px;color:var(--color-primary-text)}
.at-center{text-align:center}
.at-more{display:flex;justify-content:center;margin-top:36px}

/* Logos */
.at-logos{display:grid;grid-template-columns:repeat(var(--at-cols,6),1fr);gap:0;padding:1px 0 0 1px}
.at-logos>*{background:var(--at-bg,#f7f5f0);display:flex;align-items:center;justify-content:center;padding:26px 20px;min-height:120px;border:1px solid var(--at-line);margin:-1px 0 0 -1px}
.at-logos img{max-height:62px;width:auto;object-fit:contain;filter:grayscale(1);opacity:.78;transition:.25s}
.at-logos>*:hover img{filter:none;opacity:1}

/* Galeria */
.at-gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.at-gallery a,.at-gallery figure{display:block;position:relative;overflow:hidden;aspect-ratio:4/3;margin:0;background:#d9d0c5}
.at-gallery img{width:100%;height:100%;object-fit:cover;transition:transform .6s}
.at-gallery a:hover img{transform:scale(1.04)}
.at-lightbox{position:fixed;inset:0;background:rgba(18,15,12,.94);display:none;align-items:center;justify-content:center;z-index:200;padding:24px}
.at-lightbox.is-aberto{display:flex}
.at-lightbox img{max-width:92vw;max-height:84vh;object-fit:contain}
.at-lightbox button{position:absolute;background:transparent;border:0;color:#fff;font-size:34px;width:52px;height:52px}
.at-lightbox .at-lb-fechar{top:14px;right:14px}
.at-lightbox .at-lb-ant{left:10px;top:50%;transform:translateY(-50%)}
.at-lightbox .at-lb-prox{right:10px;top:50%;transform:translateY(-50%)}

/* Formulários (contato e newsletter) */
.at-form{display:grid;gap:14px}
.at-form label{display:block;font-size:12px;font-weight:700;margin-bottom:6px;letter-spacing:.02em}
.at-input{width:100%;min-height:50px;padding:12px 14px;border:1px solid #cfc8bc;background:#fff;border-radius:var(--at-radius);font:inherit;font-size:15px;color:var(--at-ink)}
textarea.at-input{min-height:140px;resize:vertical}
.at-input:focus{border-color:var(--color-primary);outline:0;box-shadow:0 0 0 3px rgba(var(--color-primary-rgb),.15)}
.at-form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.at-contact{display:grid;grid-template-columns:.9fr 1.1fr;gap:56px;align-items:start}
.at-contact-cards{display:grid;gap:12px;margin-top:28px}
.at-contact-card{display:flex;gap:14px;align-items:flex-start;background:var(--at-card);padding:18px 20px;transition:.2s}
a.at-contact-card:hover{background:#e3dbce}
.at-contact-card svg{width:20px;height:20px;color:var(--color-primary-text);flex-shrink:0;margin-top:2px}
.at-contact-card strong{display:block;font-size:13px}
.at-contact-card span{display:block;font-size:13px;color:var(--at-muted)}
.at-note{font-size:12px;color:var(--at-muted)}
.at-map{margin-top:40px;aspect-ratio:16/6;background:#d9d0c5;position:relative}
.at-map iframe{position:absolute;inset:0;width:100%;height:100%;border:0}

/* Equipe e listas de páginas */
.at-team{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
.at-member{text-align:left}
.at-member-photo{aspect-ratio:3/4;overflow:hidden;background:#d9d0c5;margin-bottom:14px}
.at-member-photo img{width:100%;height:100%;object-fit:cover}
.at-member h3{font-size:17px;margin-bottom:4px}
.at-member small{color:var(--at-muted);font-size:13px}

/* Página interna */
.at-page-head{padding:70px 0 40px;border-bottom:1px solid var(--at-line)}
.at-page-head h1{font-size:clamp(36px,5vw,64px);margin-top:16px}
.at-page-head p{max-width:640px;color:var(--at-muted);margin-top:16px}
.at-breadcrumb{display:flex;gap:8px;flex-wrap:wrap;font-size:12px;color:var(--at-muted)}
.at-breadcrumb a:hover{color:var(--color-primary-text)}

/* Rodapé */
.at-footer{background:#24231f;color:#f7f0e6;padding:60px 0 28px}
.at-footer-grid{display:grid;grid-template-columns:1.3fr 1fr 1fr 1.2fr;gap:36px;padding-bottom:45px}
.at-footer h2{font-size:14px;letter-spacing:0;margin:0 0 14px;color:#fff;font-weight:700}
.at-footer p,.at-footer li,.at-footer a{font-size:13px;color:#c9c3b9;line-height:1.75}
.at-footer a:hover{color:#fff}
.at-footer ul{list-style:none;padding:0;margin:0}
.at-footer-logo img{max-height:56px;width:auto;margin-bottom:14px}
.at-social{display:flex;gap:10px;margin-top:16px}
.at-social a{width:40px;height:40px;border:1px solid rgba(255,255,255,.2);border-radius:50%;display:inline-flex;align-items:center;justify-content:center}
.at-social a:hover{background:#fff;color:#24231f}
.at-social svg{width:16px;height:16px}
.at-footer-news{display:flex;gap:8px;margin-top:12px}
.at-footer-news .at-input{min-height:46px;background:#2f2d28;border-color:#4a463f;color:#fff}
.at-footer-news .at-input::placeholder{color:#a8a195}
.at-footer-pages{display:flex;flex-wrap:wrap;gap:8px 22px;padding:20px 0;border-top:1px solid rgba(255,255,255,.12)}
.at-footer-bottom{border-top:1px solid rgba(255,255,255,.16);padding-top:22px;display:flex;justify-content:space-between;gap:20px}
.at-footer-bottom,.at-footer-bottom a{color:#b0a99d;font-size:12px}

/* Avisos e WhatsApp */
.at-flash{padding:14px 18px;margin:18px 0;font-weight:600;border:1px solid}
.at-flash--ok{background:#e9f5ee;color:#14532d;border-color:#b6dec5}
.at-flash--erro{background:#fbeaea;color:#7f1d1d;border-color:#f1c0c0}
.at-float-whatsapp{position:fixed;z-index:60;right:22px;bottom:20px;background:#1f7a4a;color:#fff!important;box-shadow:0 12px 35px rgba(0,0,0,.2);border-radius:100px;padding:14px 20px;font-size:13px;font-weight:700;display:inline-flex;align-items:center;gap:8px}
.at-float-whatsapp:hover{background:#1a6640}
.at-float-whatsapp svg{width:18px;height:18px}

@media(max-width:1050px){
  .at-links{gap:16px}.at-links>.at-btn{display:none}
  .at-hero-grid{grid-template-columns:45% 55%}
  .at-portfolio-grid{grid-template-columns:1fr 1fr}
  .at-services{grid-template-columns:repeat(2,1fr)}
  .at-statement-text,.at-statement--left .at-statement-text{padding:65px 40px}
  .at-footer-grid{grid-template-columns:1fr 1fr}
  .at-team{grid-template-columns:repeat(3,1fr)}
  .at-logos{--at-cols:4!important}
}
@media(max-width:860px){
  .at-media,.at-split,.at-contact{grid-template-columns:1fr;gap:36px}
  .at-media--left .at-media-frame,.at-split--left .at-split-media{order:0}
  .at-cards{grid-template-columns:1fr 1fr}
}
@media(max-width:720px){
  .at-root{font-size:15px}
  .at-wrap{width:calc(100% - 36px)}
  .at-nav{min-height:70px}
  .at-logo img{height:46px}
  .at-menu-toggle{display:inline-flex}
  .at-links{display:none;position:absolute;left:-18px;right:-18px;top:100%;background:var(--at-bg,#f7f5f0);padding:16px 24px 24px;box-shadow:0 15px 20px rgba(0,0,0,.06);flex-direction:column;align-items:flex-start;gap:4px;border-bottom:1px solid var(--at-line)}
  .at-links.is-aberto{display:flex}
  .at-links>.at-btn{display:inline-flex;margin-top:10px}
  .at-links>a:not(.at-btn),.at-dd>button{padding:12px 0;font-size:15px}
  .at-dd-menu{position:static;display:block;border:0;box-shadow:none;background:transparent;padding:0 0 0 14px;min-width:0}
  .at-hero{padding-top:18px}
  .at-hero-grid{grid-template-columns:1fr;min-height:0}
  .at-hero-copy{padding:35px 0}
  .at-hero-title{font-size:clamp(38px,11vw,62px);margin:18px 0}
  .at-hero-photo{min-height:370px;height:60vw}
  .at-hero-stamp{width:85px;height:85px}.at-hero-stamp strong{font-size:27px}
  .at-cred-bar{grid-template-columns:1fr 1fr}
  .at-cred-bar>div{padding:19px 18px;min-height:90px;border-bottom:1px solid #d8d1c5}
  .at-cred-bar>div:nth-child(2n){border-right:0}
  .at-section{padding:73px 0}.at-section--flush{padding:0}
  .at-process{padding:73px 0}
  .at-section-head{display:block}.at-section-head>p,.at-section-head>.at-head-text{margin-top:15px}
  .at-portfolio-grid{grid-template-columns:1fr 1fr;gap:10px;grid-auto-rows:180px}
  .at-project.is-big{grid-column:span 2;grid-row:span 1}
  .at-project-info{left:12px;bottom:13px}.at-project-info strong{font-size:13px}
  .at-projects-note{align-items:flex-start;flex-direction:column}
  .at-statement-grid{grid-template-columns:1fr}
  .at-statement-text,.at-statement--left .at-statement-text{padding:64px 24px}
  .at-statement--left .at-statement-image{order:0}
  .at-statement-image{min-height:300px;height:350px}
  .at-services{grid-template-columns:1fr 1fr;gap:10px}
  .at-service{min-height:190px;padding:23px 17px}.at-symbol{margin-bottom:29px}
  .at-process-grid{grid-template-columns:1fr 1fr;gap:20px}
  .at-cta-grid{align-items:flex-start;flex-direction:column}
  .at-footer-grid{grid-template-columns:1fr;gap:28px}
  .at-footer-bottom{flex-direction:column}
  .at-float-whatsapp{right:12px;bottom:12px}
  .at-stats{grid-template-columns:1fr 1fr}
  .at-cards,.at-gallery{grid-template-columns:1fr 1fr}
  .at-team{grid-template-columns:1fr 1fr}
  .at-logos{--at-cols:3!important}
  .at-form-row{grid-template-columns:1fr}
  .at-map{aspect-ratio:4/3}
}
@media(max-width:390px){
  .at-services,.at-portfolio-grid,.at-process-grid,.at-cards,.at-gallery{grid-template-columns:1fr}
  .at-project,.at-project.is-big{grid-column:span 1;height:230px}
}
@media(prefers-reduced-motion:reduce){.at-root *,.at-root *:before,.at-root *:after{scroll-behavior:auto!important;transition:none!important}}
</style>
