{# "Leia também": as 3 notícias visíveis marcadas mais recentes. Some quando não há nenhuma. #}
{% set featuredItems = featuredItems ?? news_featured(3) %}
{% if featuredItems is not empty %}
<section class="nt-card" aria-labelledby="nt-featured-title">
    <h2 class="nt-card__title" id="nt-featured-title">Leia também</h2>
    <ul class="nt-featured">
        {% for a in featuredItems %}
        <li>
            <a href="{{ path('pub_article_show', {slug: a.slug}) }}">{{ a.title }}</a>
            {% if a.coverImage %}<img src="{{ ('uploads/article/' ~ a.coverImage)|imagine_filter('news_square') }}" alt="" loading="lazy">{% endif %}
        </li>
        {% endfor %}
    </ul>
</section>
{% endif %}
