{% extends 'themes/noticias/base.html.twig' %}

{% set tz = 'America/Sao_Paulo' %}
{% set months = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'] %}

{% block title %}{{ article.title }} | {{ currentTenant.name }}{% endblock %}
{% block robots %}{% if article.sample %}<meta name="robots" content="noindex, follow">{% else %}{{ parent() }}{% endif %}{% endblock %}
{% block meta_description %}{% if article.summary %}<meta name="description" content="{{ article.summary|striptags|slice(0, 160) }}">{% endif %}{% endblock %}
{% block og_tags %}
    <meta property="og:site_name" content="{{ currentTenant.name }}">
    <meta property="og:type" content="article">
    <meta property="og:title" content="{{ article.title }}">
    {% if article.summary %}<meta property="og:description" content="{{ article.summary|striptags|slice(0, 200) }}">{% endif %}
    <meta property="og:url" content="{{ url('pub_article_show', {slug: article.slug}) }}">
    {% if article.coverImage %}<meta property="og:image" content="{{ absolute_url(asset('uploads/article/' ~ article.coverImage)) }}">{% endif %}
    <meta property="article:published_time" content="{{ article.publishedAt|date('c') }}">
{% endblock %}
{% block canonical %}<link rel="canonical" href="{{ url('pub_article_show', {slug: article.slug}) }}">{% endblock %}
{% block header_section %}{{ article.category ? article.category.name : '' }}{% endblock %}

{% block body %}
<div class="nt-container">
    <article class="nt-article">
        <header>
            {% if article.kicker %}<p class="nt-article__kicker">{{ article.kicker }}</p>{% endif %}
            <h1 class="nt-article__title">{{ article.title }}</h1>
            {% if article.summary %}<p class="nt-article__summary">{{ article.summary }}</p>{% endif %}
            {% include 'themes/noticias/_byline.html.twig' %}
            <p class="nt-article__date">
                <time datetime="{{ article.publishedAt|date('c') }}">{{ article.publishedAt|date('d/m/Y H\\hi', tz) }}</time>
                {%- set updated = article_updated_label(article) %}{% if updated %} · {{ updated }}{% endif %}
            </p>
        </header>

        {% if article.coverImage %}
        <figure class="nt-article__cover">
            <img src="{{ asset('uploads/article/' ~ article.coverImage) }}" alt="{{ article.coverCaption ?? article.title }}">
            {% if article.coverCaption or article.coverCredit %}
            <figcaption>
                {{- article.coverCaption -}}
                {%- if article.coverCaption and article.coverCredit %} — {% endif -%}
                {%- if article.coverCredit %}Foto: {{ article.coverCredit }}{% endif -%}
            </figcaption>
            {% endif %}
        </figure>
        {% endif %}

        {% if article.body %}
        <div class="nt-body">{{ article.body|raw }}</div>
        {% endif %}

        {% if article.videoId %}
        <figure class="nt-video">
            <iframe src="https://www.youtube-nocookie.com/embed/{{ article.videoId|e('url') }}" title="Vídeo: {{ article.title }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </figure>
        {% endif %}

        <p class="nt-article__end">
            {{ article.publishedAt|date('j', tz) }} de {{ months[article.publishedAt|date('n', tz) - 1] }} de {{ article.publishedAt|date('Y', tz) }} às {{ article.publishedAt|date('H:i', tz) }}
        </p>

        {% if next %}
        <nav class="nt-next" aria-label="Próxima notícia">
            <span class="nt-next__label">Próximo</span>
            <a href="{{ path('pub_article_show', {slug: next.slug}) }}">{{ next.title }}</a>
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
        </nav>
        {% endif %}

        {% include 'themes/noticias/_most_read.html.twig' with {thumbs: true} %}
    </article>
</div>
{% endblock %}
