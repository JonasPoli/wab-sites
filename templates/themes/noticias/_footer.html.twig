{% set tenantName = currentTenant ? currentTenant.name : '' %}
{% set dark = currentTenant ? is_dark_color(currentTenant.primaryColor) : true %}
<footer class="nt-footer">
    <div class="nt-container">
        <div class="nt-footer__top">
            <div class="nt-footer__brand">
                <a href="{{ path('pub_home') }}" class="nt-logo" aria-label="Página inicial de {{ tenantName }}">
                    {% if currentTenant and dark and currentTenant.darkLogo %}
                        <img src="{{ vich_uploader_asset(currentTenant, 'darkLogoFile') }}" alt="{{ tenantName }}" style="height:40px">
                    {% elseif currentTenant and currentTenant.logo %}
                        <span class="{{ dark ? 'nt-logo--pill' : '' }}" style="display:inline-flex"><img src="{{ vich_uploader_asset(currentTenant, 'logoFile') }}" alt="{{ tenantName }}" style="height:36px"></span>
                    {% else %}
                        {{ tenantName }}
                    {% endif %}
                </a>
                <a href="{{ path('pub_articles') }}">últimas notícias</a>
            </div>
            <div class="nt-footer__social">
                {% if currentTenant and currentTenant.facebookLink %}<a href="{{ currentTenant.facebookLink }}" target="_blank" rel="noopener" aria-label="Facebook"><i class="fa-brands fa-facebook" aria-hidden="true"></i></a>{% endif %}
                {% if currentTenant and currentTenant.instagramLink %}<a href="{{ currentTenant.instagramLink }}" target="_blank" rel="noopener" aria-label="Instagram"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a>{% endif %}
                {% if currentTenant and currentTenant.youtubeLink %}<a href="{{ currentTenant.youtubeLink }}" target="_blank" rel="noopener" aria-label="YouTube"><i class="fa-brands fa-youtube" aria-hidden="true"></i></a>{% endif %}
                {% if currentTenant and currentTenant.linkedinLink %}<a href="{{ currentTenant.linkedinLink }}" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fa-brands fa-linkedin" aria-hidden="true"></i></a>{% endif %}
                {% if currentTenant and currentTenant.whatsappLink %}<a href="{{ currentTenant.whatsappLink }}" target="_blank" rel="noopener" aria-label="WhatsApp"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i></a>{% endif %}
            </div>
        </div>
        <div class="nt-footer__bottom">
            <span>© {{ 'now'|date('Y') }} {{ tenantName }}</span>
            <ul class="nt-footer__links">
                {% for page in footerPages ?? [] %}
                    <li><a href="{{ path('pub_page_show', {slug: page.slug}) }}">{{ page.title|lower }}</a></li>
                {% endfor %}
                <li><a href="{{ path('journalist_signup') }}">seja um autor</a></li>
            </ul>
        </div>
    </div>
</footer>
