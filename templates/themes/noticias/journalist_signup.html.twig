{% extends 'themes/noticias/base.html.twig' %}

{% block title %}Seja um autor | {{ currentTenant.name }}{% endblock %}
{% block robots %}<meta name="robots" content="noindex, follow">{% endblock %}

{% block stylesheets %}
<style>
.nt-form-wrap { max-width: 720px; margin: 0 auto; padding-top: 32px; }
.nt-form-wrap h1 { margin: 0; font-size: 32px; color: var(--color-primary); }
.nt-form-wrap .nt-lead { color: var(--nt-gray); font-size: 16px; margin: 8px 0 24px; }
.nt-form { background: #fff; border: 1px solid #e6e6e6; border-radius: 12px; padding: 24px; display: grid; gap: 16px; }
.nt-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.nt-form label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 6px; color: #333; }
.nt-form .nt-req { color: #b91c1c; }
.nt-form input[type=text], .nt-form input[type=email], .nt-form input[type=password], .nt-form input[type=tel], .nt-form textarea, .nt-form input[type=file] {
    width: 100%; font: inherit; font-size: 16px; padding: 10px 12px; border: 1px solid #cfcfcf; border-radius: 8px; background: #fff; color: var(--nt-ink);
}
.nt-form textarea { min-height: 110px; resize: vertical; }
.nt-form input:focus, .nt-form textarea:focus { border-color: var(--color-primary); outline: 2px solid rgba(var(--color-primary-rgb), .2); }
.nt-form__hint { font-size: 12px; color: var(--nt-light); margin-top: 4px; }
.nt-form__check { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; color: #333; }
.nt-form__check input { margin-top: 3px; width: 18px; height: 18px; flex-shrink: 0; }
.nt-form__hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
.nt-form button { justify-self: start; background: var(--color-primary); color: var(--nt-on-primary); border: 0; border-radius: 8px; padding: 12px 22px; font: 700 15px var(--font-body); cursor: pointer; }
.nt-form-errors { background: #fdecec; border: 1px solid #f5c2c2; color: #7f1d1d; border-radius: 10px; padding: 12px 16px; margin-bottom: 16px; }
.nt-form-errors ul { margin: 0; padding-left: 18px; }
.nt-form-login { margin-top: 16px; font-size: 14px; color: var(--nt-gray); }
.nt-form-login a { color: var(--color-primary); font-weight: 700; }
@media (max-width: 640px) { .nt-form__row { grid-template-columns: 1fr; } }
</style>
{% endblock %}

{% block body %}
<div class="nt-container">
    <div class="nt-form-wrap">
        <h1>Seja um autor</h1>
        <p class="nt-lead">Jornalistas podem se cadastrar para publicar notícias no {{ currentTenant.name }}. A administração do portal analisa cada cadastro; depois da aprovação, você entra com o seu e-mail e a senha escolhida.</p>

        {% if errors is not empty %}
        <div class="nt-form-errors" role="alert">
            <ul>{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul>
        </div>
        {% endif %}

        <form class="nt-form" method="post" enctype="multipart/form-data" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token('journalist_signup') }}">
            <div class="nt-form__hp" aria-hidden="true">
                <label for="j-website">Site</label>
                <input type="text" id="j-website" name="website" tabindex="-1" autocomplete="off">
            </div>

            <div>
                <label for="j-name">Nome <span class="nt-req" aria-hidden="true">*</span></label>
                <input type="text" id="j-name" name="name" value="{{ data.name ?? '' }}" required autocomplete="name" maxlength="150">
            </div>
            <div class="nt-form__row">
                <div>
                    <label for="j-email">E-mail <span class="nt-req" aria-hidden="true">*</span></label>
                    <input type="email" id="j-email" name="email" value="{{ data.email ?? '' }}" required autocomplete="email">
                    <p class="nt-form__hint">Será o seu login.</p>
                </div>
                <div>
                    <label for="j-phone">Telefone</label>
                    <input type="tel" id="j-phone" name="phone" value="{{ data.phone ?? '' }}" autocomplete="tel" maxlength="40">
                </div>
            </div>
            <div class="nt-form__row">
                <div>
                    <label for="j-pass">Senha <span class="nt-req" aria-hidden="true">*</span></label>
                    <input type="password" id="j-pass" name="password" required minlength="8" autocomplete="new-password">
                    <p class="nt-form__hint">Mínimo de 8 caracteres.</p>
                </div>
                <div>
                    <label for="j-pass2">Confirme a senha <span class="nt-req" aria-hidden="true">*</span></label>
                    <input type="password" id="j-pass2" name="passwordConfirm" required minlength="8" autocomplete="new-password">
                </div>
            </div>
            <div class="nt-form__row">
                <div>
                    <label for="j-reg">Registro profissional</label>
                    <input type="text" id="j-reg" name="professionalRegistration" value="{{ data.professionalRegistration ?? '' }}" maxlength="60" placeholder="Ex.: MTb 12345">
                </div>
                <div>
                    <label for="j-outlet">Veículo onde atua</label>
                    <input type="text" id="j-outlet" name="outlet" value="{{ data.outlet ?? '' }}" maxlength="150">
                </div>
            </div>
            <div class="nt-form__row">
                <div>
                    <label for="j-city">Cidade</label>
                    <input type="text" id="j-city" name="city" value="{{ data.city ?? '' }}" maxlength="120" autocomplete="address-level2">
                </div>
                <div>
                    <label for="j-photo">Foto</label>
                    <input type="file" id="j-photo" name="photo" accept="image/*">
                    <p class="nt-form__hint">Opcional. Imagem de até 5 MB.</p>
                </div>
            </div>
            <div>
                <label for="j-bio">Minibio</label>
                <textarea id="j-bio" name="bio" maxlength="{{ bio_max }}">{{ data.bio ?? '' }}</textarea>
                <p class="nt-form__hint">Até {{ bio_max }} caracteres. Aparece na sua página de autor.</p>
            </div>
            <label class="nt-form__check" for="j-consent" style="font-weight:400">
                <input type="checkbox" id="j-consent" name="consent" value="1" {{ (data.consent ?? false) ? 'checked' }} required>
                <span>{{ consent_text }} <span class="nt-req" aria-hidden="true">*</span></span>
            </label>
            <button type="submit">Enviar cadastro</button>
        </form>
        <p class="nt-form-login">Já foi aprovado? <a href="{{ path('app_login') }}">Entre aqui</a>.</p>
    </div>
</div>
{% endblock %}
