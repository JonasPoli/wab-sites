<style>
/* ── Páginas de notícias (lista, notícia, autor, cadastro) ──
   Só tokens de cor (definidos em base.html.twig, com os valores do modo escuro). */
.nt-page { padding-top: 28px; }
.nt-layout { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 32px 40px; align-items: start; }
.nt-sidebar { display: flex; flex-direction: column; gap: 24px; position: sticky; top: 88px; }
.nt-page-head { padding: 8px 0 20px; border-bottom: 1px solid var(--nt-line); margin-bottom: 4px; }
.nt-page-head h1 { margin: 0; font-size: var(--nt-h1-size); line-height: 1.2; letter-spacing: -.045em; color: var(--nt-accent); font-weight: 700; }
.nt-page-head p { margin: 8px 0 0; color: var(--nt-gray); font-size: 15px; }
.nt-crumb { font-size: 13px; color: var(--nt-light); margin: 0 0 6px; }
.nt-crumb a { color: inherit; }
.nt-empty { padding: 40px 0; color: var(--nt-light); font-size: 16px; }

/* Busca */
.nt-search-form--page { margin-top: 16px; }
.nt-search-count { margin: 12px 0 0; font-size: 15px; color: var(--nt-gray); }
.nt-search-pages { margin: 20px 0 4px; }
.nt-search-pages ul { list-style: none; margin: 0; padding: 4px 0; }
.nt-search-pages li { padding: 8px 0; border-bottom: 1px solid var(--nt-card-sep); }
.nt-search-pages li:last-child { border-bottom: 0; }
.nt-search-pages a { color: var(--nt-accent); font-weight: 700; text-decoration: none; }
.nt-search-pages a:hover { text-decoration: underline; }

/* Item da lista */
.nt-item { display: grid; grid-template-columns: 228px minmax(0, 1fr); gap: 20px; padding: 22px 0; border-bottom: 1px solid var(--nt-line); }
.nt-item--nocover { grid-template-columns: minmax(0, 1fr); }
.nt-item__img img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 8px; background: var(--nt-img-ph); }
.nt-item__body { min-width: 0; }
.nt-kicker { margin: 0 0 4px; font-size: 16px; line-height: 1.1; font-weight: 600; letter-spacing: -.02em; color: var(--nt-strong); }
.nt-item__title { margin: 0; font-size: var(--nt-h2-size); line-height: 1.1; font-weight: 700; letter-spacing: -.035em; }
.nt-item__title a { color: var(--nt-accent); text-decoration: none; }
.nt-item__title a:hover { text-decoration: underline; }
.nt-item__summary { margin: 10px 0 0; color: var(--nt-text-2); font-size: 16px; line-height: 24px; letter-spacing: -.02em; }
.nt-related { list-style: none; margin: 8px 0 0; padding: 0; }
.nt-related li { position: relative; padding-left: 14px; font-size: 14px; line-height: 1.3; letter-spacing: -.015em; margin: 4px 0; }
.nt-related li::before { content: ''; position: absolute; left: 2px; top: .5em; width: 5px; height: 5px; border-radius: 50%; background: var(--color-secondary); }
.nt-related a { color: var(--nt-accent); text-decoration: none; }
.nt-related a:hover { text-decoration: underline; }
.nt-meta { margin: 8px 0 0; font-size: 12px; line-height: 18px; letter-spacing: -.01em; color: var(--nt-light); }
.nt-item--lead { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); padding-top: 4px; }
.nt-item--lead.nt-item--nocover { grid-template-columns: minmax(0, 1fr); }
.nt-more { display: block; text-align: center; margin: 24px 0 0; padding: 12px; border: 1px solid var(--nt-line); border-radius: 8px; background: var(--nt-card); color: var(--nt-accent); font-size: 14px; font-weight: 700; letter-spacing: -.015em; text-decoration: none; }
.nt-more:hover { border-color: var(--nt-accent); }

/* Cartões da barra lateral */
.nt-card { background: var(--nt-card); border: 1px solid var(--nt-card-line); border-radius: 10px; padding: 4px 16px 8px; }
/* Rótulo do tema: não segue o tamanho nem o peso do H2 da edição do tenant (regra global com !important) */
.nt-card__title { margin: 0 -16px 4px; padding: 12px 16px; font-size: 14px !important; line-height: 1.4; font-weight: 600 !important; letter-spacing: normal; color: var(--nt-strong); border-bottom: 1px solid var(--nt-card-sep); }
.nt-card__title strong { font-weight: 800; }
.nt-featured { list-style: none; margin: 0; padding: 0; }
.nt-featured li { display: grid; grid-template-columns: minmax(0, 1fr) 64px; gap: 12px; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--nt-card-sep); }
.nt-featured li:last-child { border-bottom: 0; }
.nt-featured a { color: var(--nt-accent); font-weight: 700; font-size: 16px; line-height: 1.1; letter-spacing: -.02em; text-decoration: none; }
.nt-featured a:hover { text-decoration: underline; }
.nt-featured img { width: 64px; height: 64px; object-fit: cover; border-radius: 8px; }
.nt-rank { list-style: none; margin: 0; padding: 0; }
.nt-rank li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 10px; align-items: start; padding: 12px 0; border-bottom: 1px solid var(--nt-card-sep); }
.nt-rank li:last-child { border-bottom: 0; }
.nt-rank--thumbs li { grid-template-columns: 28px minmax(0, 1fr) 128px; }
.nt-rank__n { font-size: 26px; font-weight: 300; line-height: 1; color: var(--nt-accent); opacity: .55; text-align: center; }
.nt-rank a { color: var(--nt-accent); font-weight: 700; font-size: 16px; line-height: 1.1; letter-spacing: -.02em; text-decoration: none; }
.nt-rank a:hover { text-decoration: underline; }
.nt-rank img { width: 128px; height: 72px; object-fit: cover; border-radius: 8px; }

/* Paginação */
.nt-pager { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 24px 0 0; font-size: 14px; }
.nt-pager a { color: var(--nt-accent); font-size: 14px; font-weight: 700; text-decoration: none; padding: 8px 12px; border: 1px solid var(--nt-line); border-radius: 8px; background: var(--nt-card); }
.nt-pager span { color: var(--nt-light); }

/* Página da notícia */
.nt-article { max-width: 648px; margin: 0 auto; padding-top: 32px; }
.nt-article__kicker { margin: 0 0 8px; font-size: 16px; line-height: 1.1; font-weight: 600; letter-spacing: -.02em; color: var(--nt-strong); }
.nt-article__title { margin: 0; font-size: var(--nt-h1-size); line-height: 1.2; font-weight: 700; letter-spacing: -.045em; color: var(--nt-title); }
.nt-article__summary { margin: 16px 0 0; font-size: 15px; line-height: 22px; font-weight: 400; letter-spacing: -.01em; color: var(--nt-gray); }
.nt-byline { margin: 24px 0 0; font-size: 14px; line-height: 20px; font-weight: 600; letter-spacing: -.01em; color: var(--nt-strong); }
.nt-byline a { color: var(--nt-accent); text-decoration: none; }
.nt-byline a:hover { text-decoration: underline; }
.nt-article__date { margin: 4px 0 0; font-size: 12px; line-height: 16px; color: var(--nt-light); }
.nt-article__cover { margin: 28px 0 0; }
.nt-article__cover img { width: 100%; border-radius: 10px; }
.nt-article__cover figcaption { margin-top: 8px; font-size: 12px; line-height: 1.1; letter-spacing: -.01em; color: var(--nt-light); }
.nt-body { margin-top: 28px; font-size: 18px; line-height: 28px; letter-spacing: -.015em; color: var(--nt-strong); overflow-wrap: anywhere; }
.nt-body p { margin: 0 0 32px; }
.nt-body h2 { font-size: var(--nt-h2-size); line-height: 1.167; font-weight: 700; letter-spacing: -.03em; margin: 40px 0 16px; color: var(--nt-title); }
.nt-body h3 { font-size: var(--nt-h3-size); line-height: 1.4; font-weight: 700; letter-spacing: -.03em; margin: 32px 0 12px; color: var(--nt-title); }
.nt-body strong, .nt-body b { color: var(--nt-accent); }
.nt-body a { color: var(--nt-accent); font-weight: 700; text-decoration: none; }
.nt-body a:hover { text-decoration: underline; }
.nt-body ol, .nt-body ul { margin: 0 0 32px; padding-left: 1.5em; }
.nt-body li { margin: 0 0 16px; font-size: 20px; line-height: 28px; letter-spacing: -.03em; }
.nt-body li[data-list="bullet"] { list-style-type: disc; }
.nt-body li[data-list="ordered"] { list-style-type: decimal; }
.nt-body blockquote { margin: 0 0 32px; padding: 4px 0 4px 20px; border-left: 4px solid var(--color-secondary); color: var(--nt-quote); font-size: 20px; line-height: 28px; font-weight: 700; letter-spacing: -.025em; font-style: normal; }
.nt-body img { border-radius: 8px; margin: 1em 0; }
.nt-body .ql-align-center { text-align: center; }
.nt-body .ql-align-right { text-align: right; }
.nt-body .ql-align-justify { text-align: justify; }
/* Vídeo do YouTube no fim do texto (largura da coluna, 16:9) */
.nt-video { margin: 28px 0 32px; aspect-ratio: 16 / 9; border-radius: 10px; overflow: hidden; background: var(--nt-img-ph); }
.nt-video iframe { display: block; width: 100%; height: 100%; border: 0; }
.nt-body + .nt-video { margin-top: 0; } /* o último parágrafo do texto já deixa 32 px */
.nt-article__end { margin: 32px 0 0; padding-top: 20px; border-top: 1px solid var(--nt-line); font-size: 13px; color: var(--nt-light); }
.nt-next { display: flex; justify-content: flex-end; align-items: center; gap: 10px; padding: 16px 0; border-bottom: 1px solid var(--nt-line); font-size: 14px; }
.nt-next__label { color: var(--nt-light); }
.nt-next a { color: var(--nt-ink); font-weight: 600; text-decoration: none; max-width: 70%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.nt-next a:hover { color: var(--nt-accent); }
.nt-next .bi { color: var(--nt-accent); font-size: 20px; }
.nt-article .nt-card { margin-top: 32px; }

/* Página do autor */
.nt-author { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 20px; align-items: center; padding: 8px 0 24px; border-bottom: 1px solid var(--nt-line); }
.nt-author--nophoto { grid-template-columns: minmax(0, 1fr); }
.nt-author img { width: 112px; height: 112px; border-radius: 50%; object-fit: cover; }
.nt-author h1 { margin: 0; font-size: var(--nt-h1-size); line-height: 1.2; font-weight: 700; letter-spacing: -.045em; color: var(--nt-accent); }
.nt-author__meta { margin: 4px 0 0; color: var(--nt-gray); font-size: 14px; }
.nt-author__bio { margin: 10px 0 0; color: var(--nt-strong); font-size: 15px; line-height: 1.55; }

@media (max-width: 860px) {
    .nt-layout { grid-template-columns: minmax(0, 1fr); }
    .nt-sidebar { position: static; }
}
@media (max-width: 767px) {
    .nt-item, .nt-item--lead { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    /* Títulos na proporção do g1 (40→28 e 24→20); !important para ganhar da regra global do tenant */
    h1, .nt-article__title, .nt-page-head h1, .nt-author h1 { font-size: calc(var(--nt-h1-size) * .7) !important; line-height: 1.143; letter-spacing: -.03em; }
    .nt-item__title { font-size: calc(var(--nt-h2-size) * 5 / 6) !important; letter-spacing: -.03em; }
    .nt-article__summary { margin-top: 12px; }
    .nt-byline { margin-top: 20px; }
    .nt-body p { margin-bottom: 28px; }
    .nt-body li { font-size: 18px; letter-spacing: -.025em; }
    .nt-body blockquote { font-size: 18px; line-height: 26px; letter-spacing: -.02em; }
    .nt-header__section { font-size: 24px; }
    .nt-rank--thumbs li { grid-template-columns: 28px minmax(0, 1fr) 88px; }
    .nt-rank img { width: 88px; height: 56px; }
    .nt-author { grid-template-columns: 80px minmax(0, 1fr); }
    .nt-author img { width: 80px; height: 80px; }
}
</style>
