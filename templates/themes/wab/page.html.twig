{% extends 'themes/wab/base.html.twig' %}

{% block title %}{{ page.seoTitle ?? page.title }}{% endblock %}

{% block meta_description %}
{% if page.seoDescription %}
<meta name="description" content="{{ page.seoDescription }}">
{% endif %}
{% endblock %}

{% block og_tags %}
{{ parent() }}
<meta property="og:type" content="website">
<meta property="og:title" content="{{ page.seoTitle ?? page.title }}">
{% endblock %}

{% block canonical %}<link rel="canonical" href="{{ app.request.uri }}">{% endblock %}

{% block body %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": {{ (page.seoTitle ?? page.title)|json_encode|raw }},
  "url": "{{ app.request.uri }}"
  {% if page.seoDescription %}, "description": {{ page.seoDescription|json_encode|raw }}{% endif %}
}
</script>

{# Page hero #}
{% if page.showTitle ?? true %}
<div class="page-hero">
    <div class="container">
        <h1>{{ page.title }}</h1>
    </div>
</div>
{% endif %}

{# Sections #}
{% for section in page.sections %}{% if section.active %}

{# ── Build background style ── #}
{% set sectionStyle = '' %}
{% set sectionClass = 'wab-section' %}
{% set isDark = false %}
{% if section.bgType in ['image', 'video', 'gradient'] %}
    {% set isDark = true %}
{% elseif section.bgType == 'color' and section.bgColor %}
    {% set isDark = is_dark_color(section.bgColor) %}
{% endif %}

{% if isDark %}
    {% set sectionClass = sectionClass ~ ' wab-section-dark' %}
{% endif %}

{# Detect if the section contains a banner block #}
{% set hasBanner = false %}
{% for block in section.blocks %}
    {% if block.type == 'banner' %}
        {% set hasBanner = true %}
    {% endif %}
{% endfor %}

{% if hasBanner %}
    {% set sectionClass = sectionClass ~ ' section-has-banner' %}
{% endif %}

{% if section.bgType == 'color' and section.bgColor %}
    {% set sectionStyle = 'background-color:' ~ section.bgColor %}
{% elseif section.bgType == 'gradient' and section.bgGradient %}
    {% set sectionStyle = 'background:linear-gradient(' ~ section.bgGradient ~ ')' %}
{% elseif section.bgType in ['image', 'video'] %}
    {% set sectionStyle = 'position:relative;overflow:hidden' %}
{% endif %}

<section id="section-{{ section.id }}" class="{{ sectionClass }}" style="{{ sectionStyle }}">
    {# Background image layer #}
    {% if section.bgType == 'image' and section.bgImage %}
    <div style="position:absolute;inset:0;background-image:url('{{ asset('uploads/section/bg/' ~ section.bgImage) }}');background-size:cover;background-position:{{ section.bgImagePosition }};opacity:{{ section.bgImageOpacity / 100 }};z-index:0;pointer-events:none"></div>
    {% endif %}
    
    {# Background video layer #}
    {% if section.bgType == 'video' and section.bgVideo %}
    <video autoplay muted loop playsinline style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0">
        <source src="{{ asset('uploads/section/video/' ~ section.bgVideo) }}" type="video/mp4">
    </video>
    {% if section.bgColor %}
    <div style="position:absolute;inset:0;background:{{ section.bgColor }};opacity:.5;z-index:1;pointer-events:none"></div>
    {% endif %}
    {% endif %}

    <div class="container" style="position:relative;z-index:2">
        {# Two-part colored title #}
        {% if (currentTenant.showSectionTitles ?? true) and (section.titlePart1 or section.titlePart2) %}
        <div class="section-two-tone-title reveal-up">
            {% if section.titlePart1 %}
                <span class="title-secondary">{{ section.titlePart1 }}</span>
            {% endif %}
            {% if section.titlePart2 %}
                <span class="title-primary">{{ section.titlePart2 }}</span>
            {% endif %}
        </div>
        {% endif %}

        {# Blocks #}
        {% for block in section.blocks %}
            {% include 'themes/wab/_block.html.twig' %}
        {% endfor %}
    </div>
</section>

{% endif %}{% endfor %}
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.page-hero {
    background: linear-gradient(135deg, var(--color-primary), color-mix(in srgb, var(--color-primary) 60%, var(--color-secondary)));
    color: white; padding: 5rem 0; text-align: center;
}
.page-hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 900; margin: 0; }
.wab-section { padding: 5rem 0; position: relative; }
.wab-section.section-has-banner { padding: 0 !important; }
.wab-section:nth-child(even) { background: #f8fafc; }

/* Dark mode overrides for section */
.wab-section-dark {
    background-color: #0f172a; /* Solid dark background fallback */
    color: #f1f5f9 !important;
}
.wab-section-dark h1, 
.wab-section-dark h2, 
.wab-section-dark h3, 
.wab-section-dark h4,
.wab-section-dark .section-heading { 
    color: #ffffff !important;
    background: none !important;
    -webkit-text-fill-color: initial !important;
}
.wab-section-dark p, 
.wab-section-dark .prose,
.wab-section-dark .wg-caption { 
    color: #cbd5e1 !important; 
}
.wab-section-dark .section-label {
    background: linear-gradient(135deg, rgba(var(--color-secondary-rgb),.25), rgba(var(--color-primary-rgb),.2)) !important;
    border-color: rgba(var(--color-secondary-rgb),.4) !important;
    color: var(--color-secondary) !important;
}
.wab-section-dark .title-secondary { color: #1a1c2e !important; }

.section-two-tone-title {
    display: flex; justify-content: center; margin-bottom: 3rem; overflow: hidden;
    border-radius: var(--radius); transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.section-two-tone-title:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
}
.title-secondary {
    background: var(--color-secondary); color: #1a1c2e;
    padding: 0.75rem 2rem; font-size: 1.4rem; font-weight: 800;
}
.title-primary {
    background: var(--color-primary); color: white;
    padding: 0.75rem 2rem; font-size: 1.4rem; font-weight: 800;
}

.zigzag-block {
    display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;
    max-width: 1100px; margin: 0 auto 4rem; padding: 0 1.5rem;
    transition: transform 0.4s ease;
}
.zigzag-block:hover {
    transform: translateY(-5px);
}
.zigzag-reverse .zigzag-img { order: 2; }
.zigzag-reverse .zigzag-text { order: 1; }
.zigzag-img-wrapper {
    overflow: hidden; border-radius: var(--radius);
    box-shadow: 0 12px 40px rgba(0,0,0,.1);
}
.zigzag-img img { 
    width: 100%; display: block;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.zigzag-block:hover .zigzag-img img {
    transform: scale(1.05) rotate(-1deg);
}
.zigzag-text h2 { font-size: 1.7rem; font-weight: 800; margin: 0.75rem 0 1rem; transition: color 0.3s; }
.zigzag-block:hover .zigzag-text h2 { color: var(--color-primary); }
.pre-label {
    display: inline-block; padding: 0.35rem 1rem; border-radius: 50px; margin-bottom: 0.75rem;
    background: color-mix(in srgb, var(--color-secondary) 25%, transparent);
    color: var(--color-primary); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em;
    transition: background 0.3s, transform 0.3s;
}
.zigzag-block:hover .pre-label {
    background: var(--color-secondary);
    transform: scale(1.05);
}

.wab-block { margin-bottom: 3rem; }
.wab-block:last-child { margin-bottom: 0; }

@media (max-width: 768px) {
    .zigzag-block { grid-template-columns: 1fr; gap: 2rem; }
    .zigzag-reverse .zigzag-img, .zigzag-reverse .zigzag-text { order: unset; }
    .section-two-tone-title { flex-direction: column; }
    .title-secondary, .title-primary { text-align: center; }
}
</style>
{% endblock %}
