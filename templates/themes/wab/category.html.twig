{% extends 'themes/wab/base.html.twig' %}
{% block title %}{{ category.name }}{% endblock %}
{% block meta_description %}{% if category.description %}<meta name="description" content="{{ category.description|striptags|slice(0,160) }}">{% endif %}{% endblock %}

{% block body %}
<div class="page-hero">
    <div class="container">
        {% if category.parent %}<span class="section-label"><span class="glow-dot"></span>{{ category.parent.name }}</span>{% endif %}
        {% if category.icon %}<div style="font-size:2.5rem;color:var(--color-secondary);margin-bottom:.75rem"><i class="{{ category.icon }}"></i></div>{% endif %}
        <h1>{{ category.name }}</h1>
        {% if category.description %}<p style="color:rgba(255,255,255,0.85);max-width:600px;margin:.75rem auto 0;font-size:1.05rem">{{ category.description }}</p>{% endif %}
    </div>
</div>

{# ── Páginas da categoria ── #}
{% if category.pages is defined and category.pages|length > 0 %}
<section class="wab-section">
    <div class="container">
        <h2 class="section-heading" style="margin-bottom:2.5rem;text-align:center">Páginas</h2>
        <div class="wab-subcat-pages">
            {% for page in category.pages %}
            <a href="{{ path('pub_page_show', {slug: page.slug}) }}" class="subcat-page-card">
                <div class="subcat-page-img-wrap">
                    {% if page.coverImage %}
                        <img src="{{ asset('uploads/page_cover/' ~ page.coverImage) }}" alt="{{ page.title }}" class="subcat-page-img" loading="lazy">
                    {% else %}
                        <div class="subcat-page-placeholder">
                            <i class="fa-solid fa-image"></i>
                        </div>
                    {% endif %}
                </div>
                <h3 class="subcat-page-title">{{ page.title }}</h3>
            </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

{# ── Seções da categoria ── #}
{% set undefinedSectionCount = 0 %}
{% for section in category.sections %}{% if section.active %}
{% set sectionStyle = '' %}
{% set sectionClass = 'wab-section' %}
{% set isDark = false %}
{% if section.bgType in ['image', 'video', 'gradient'] %}
    {% set isDark = true %}
{% elseif section.bgType == 'color' and section.bgColor %}
    {% set isDark = is_dark_color(section.bgColor) %}
{% endif %}

{% if isDark %}
    {% set sectionClass = sectionClass ~ ' wab-section-dark' %}
{% endif %}

{% set bgNotDefined = (section.bgType == 'none' or section.bgType is empty or (section.bgType == 'color' and not section.bgColor)) %}
{% if bgNotDefined %}
    {% set undefinedSectionCount = undefinedSectionCount + 1 %}
    {% if undefinedSectionCount % 2 == 1 %}
        {% set sectionClass = sectionClass ~ ' auto-bg-a' %}
    {% else %}
        {% set sectionClass = sectionClass ~ ' auto-bg-b' %}
    {% endif %}
{% endif %}

{% if section.bgType == 'color' and section.bgColor %}{% set sectionStyle = 'background-color:' ~ section.bgColor %}
{% elseif section.bgType == 'gradient' and section.bgGradient %}{% set sectionStyle = 'background:linear-gradient(' ~ section.bgGradient ~ ')' %}
{% elseif section.bgType in ['image','video'] %}{% set sectionStyle = 'position:relative;overflow:hidden' %}{% endif %}
<section id="section-{{ section.id }}" class="{{ sectionClass }}" style="{{ sectionStyle }}">
    {% if section.bgType == 'image' and section.bgImage %}<div style="position:absolute;inset:0;background-image:url('{{ asset('uploads/section/bg/' ~ section.bgImage) }}');background-size:cover;background-position:{{ section.bgImagePosition }};opacity:{{ section.bgImageOpacity/100 }};z-index:0;pointer-events:none"></div>{% endif %}
    <div class="container" style="position:relative;z-index:2">
        {% if (currentTenant.showSectionTitles ?? true) and (section.titlePart1 or section.titlePart2) %}
        <div class="section-two-tone-title reveal-up">
            {% if section.titlePart1 %}<span class="title-secondary">{{ section.titlePart1 }}</span>{% endif %}
            {% if section.titlePart2 %}<span class="title-primary">{{ section.titlePart2 }}</span>{% endif %}
        </div>
        {% endif %}
        {% for block in section.blocks %}{% include 'themes/wab/_block.html.twig' %}{% endfor %}
    </div>
</section>
{% endif %}{% endfor %}

{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.wab-subcat-pages {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem 2rem;
    align-items: stretch;
    background: transparent;
}
.subcat-page-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: transparent;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
}
.subcat-page-card:hover {
    transform: translateY(-8px);
    opacity: 1;
}
.subcat-page-img-wrap {
    width: 100%;
    height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    overflow: hidden;
    margin-bottom: 1.25rem;
}
.subcat-page-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    background: transparent;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.35s ease;
}
.subcat-page-card:hover .subcat-page-img {
    transform: scale(1.05);
    filter: drop-shadow(0 12px 24px rgba(0,0,0,0.18));
}
.subcat-page-placeholder {
    font-size: 3.5rem;
    color: var(--text-muted);
    opacity: 0.35;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}
.subcat-page-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
    line-height: 1.4;
    transition: color 0.3s ease;
}
.subcat-page-card:hover .subcat-page-title {
    color: var(--color-primary);
}
@media (max-width: 991px) {
    .wab-subcat-pages {
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem 1.5rem;
    }
    .subcat-page-img-wrap {
        height: 200px;
    }
}
@media (max-width: 600px) {
    .wab-subcat-pages {
        grid-template-columns: 1fr;
        gap: 2rem;
    }
    .subcat-page-img-wrap {
        height: 180px;
    }
}
</style>
{% endblock %}
