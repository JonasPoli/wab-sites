<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# ── SEO: title ── #}
    <title>{% block title %}{{ currentTenant ? currentTenant.name : 'WAB Brasil' }}{% endblock %} | WAB Brasil</title>

    {# ── SEO: meta description ── #}
    {% block meta_description %}{% endblock %}

    {# ── Open Graph ── #}
    {% block og_tags %}
    <meta property="og:site_name" content="{{ currentTenant ? currentTenant.name : 'WAB Brasil' }}">
    <meta property="og:type" content="website">
    {% endblock %}

    {# ── Twitter Card ── #}
    <meta name="twitter:card" content="summary_large_image">

    {# ── Canonical ── #}
    {% block canonical %}{% endblock %}

    {# ── Robots ── #}
    {% block robots %}<meta name="robots" content="index, follow">{% endblock %}

    {# ── Favicon ── #}
    {% if currentTenant and currentTenant.logo %}
        <link rel="icon" href="{{ vich_uploader_asset(currentTenant, 'logoFile') }}">
    {% endif %}

    {# Apply theme BEFORE paint to prevent flash #}
    {# ── Preconnect para CDNs ── #}
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
    <link rel="preconnect" href="https://unpkg.com">
    <link rel="dns-prefetch" href="https://unpkg.com">

    {# ── Swiper CSS (bloqueante — crítico para layout) ── #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

    {# ── Bootstrap Icons ── #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    {# ── AOS CSS ── #}
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css">

    {# ── FontAwesome 6 ── #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <script>
    (function(){
        var saved = localStorage.getItem('wab-theme') || 'auto';
        var dark = saved === 'auto'
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
            : saved === 'dark';
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        if (dark) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    })();
    </script>

    {# ── Tenant CSS custom properties ── #}
    {{ tenant_css_vars()|raw }}

    <style>
        html { scroll-behavior: smooth; }
        *, *::before, *::after { box-sizing: border-box; }
        :root {
            --font-sans: 'Inter', system-ui, sans-serif;
            --radius: 12px;
            --transition: 0.25s cubic-bezier(0.4,0,0.2,1);

            /* Light theme variables */
            --bg: #f8f9fc;
            --bg-alt: #f1f5f9;
            --bg-card: #ffffff;
            --bg-glass: rgba(255,255,255,0.95);
            --text: #1a1c2e;
            --text-muted: #6b7280;
            --border: rgba(0,0,0,.07);
            --header-bg: rgba(255,255,255,0.95);
        }

        [data-theme="dark"] {
            --bg: #0f172a;
            --bg-alt: #131625;
            --bg-card: #1e293b;
            --bg-glass: rgba(30,41,59,0.95);
            --text: #f1f5f9;
            --text-muted: #94a3b8;
            --border: rgba(255,255,255,.08);
            --header-bg: rgba(15,23,42,0.95);
        }

        body {
            font-family: var(--font-sans);
            margin: 0;
            background: var(--bg);
            color: var(--text);
            line-height: 1.7;
            transition: background .25s, color .25s;
        }
        a { color: var(--color-primary); text-decoration: none; }
        a:hover { opacity: 0.8; }
        img { max-width: 100%; height: auto; }

        /* Theme Toggle Button Style */
        #wab-theme-btn {
            display: inline-flex; align-items: center; gap: .4rem;
            padding: .4rem .9rem; border-radius: 50px; border: 1px solid var(--border);
            background: var(--bg-card); color: var(--text); font-size: .82rem;
            font-weight: 600; cursor: pointer; transition: all .2s; white-space: nowrap;
            margin-left: 0.5rem;
        }
        #wab-theme-btn:hover { border-color: var(--color-primary); }

        /* Utility */
        .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
        .btn {
            display: inline-flex; align-items: center; gap: 0.5rem;
            padding: 0.75rem 1.75rem; border-radius: 50px;
            font-weight: 600; font-size: 0.95rem; cursor: pointer;
            transition: all var(--transition); border: none;
        }
        .btn-primary {
            background: var(--color-primary); color: #fff;
        }
        .btn-primary:hover { opacity: 0.9; transform: translateY(-2px); box-shadow: 0 8px 25px rgba(var(--color-primary-rgb),.35); }
        .btn-outline {
            background: transparent; color: var(--color-primary);
            border: 2px solid var(--color-primary);
        }
        .btn-outline:hover { background: var(--color-primary); color: #fff; }

        /* Section headings */
        .section-title { text-align: center; margin-bottom: 3rem; }
        .section-title h2 {
            font-size: clamp(1.8rem, 4vw, 2.8rem);
            font-weight: 800;
            background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .section-title p { color: var(--text-muted); max-width: 600px; margin: 0.75rem auto 0; }

        /* Modern styled section titles & tags */
        .section-label {
            display: inline-flex; align-items: center; gap: .5rem;
            background: linear-gradient(135deg, rgba(var(--color-secondary-rgb),.15), rgba(var(--color-primary-rgb),.1));
            border: 1px solid rgba(var(--color-secondary-rgb),.3);
            color: var(--color-secondary); font-size: .75rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: .1em;
            padding: .35rem 1rem; border-radius: 50px; margin-bottom: 1.25rem;
        }
        .section-heading {
            font-size: clamp(1.8rem, 4vw, 3rem); font-weight: 900; line-height: 1.1;
            color: var(--text); margin-bottom: 1.5rem;
        }
        [data-theme="dark"] .section-heading {
            background: linear-gradient(135deg, #fff 0%, color-mix(in srgb, var(--color-secondary) 60%, #fff) 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .glow-dot {
            width: 6px; height: 6px; border-radius: 50%; background: var(--color-secondary);
            box-shadow: 0 0 12px var(--color-secondary);
            display: inline-block; margin-right: .5rem;
        }

        /* Flash messages */
        .flash { padding: 1rem 1.5rem; border-radius: var(--radius); margin: 1rem 0; font-weight: 500; }
        .flash-success { background: #d1fae5; color: #065f46; }
        .flash-error   { background: #fee2e2; color: #991b1b; }

        /* Animations */
        .reveal-up { opacity: 0; transform: translateY(30px); transition: opacity 0.8s ease-out, transform 0.8s ease-out; }
        .reveal-up.active { opacity: 1; transform: translateY(0); }
        .fade-in { opacity: 0; transition: opacity 1s ease-out; }
        .fade-in.active { opacity: 1; }
        .delay-100 { transition-delay: 100ms; }
        .delay-200 { transition-delay: 200ms; }
        .delay-300 { transition-delay: 300ms; }
        .scale-in { opacity: 0; transform: scale(0.95); transition: opacity 0.6s ease-out, transform 0.6s ease-out; }
        .scale-in.active { opacity: 1; transform: scale(1); }
    </style>

    {% block stylesheets %}{% endblock %}

    {# ── Google Analytics (GA4) ── #}
    {% if currentTenant and currentTenant.googleAnalyticsId %}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ currentTenant.googleAnalyticsId|e('html_attr') }}"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '{{ currentTenant.googleAnalyticsId|e('js') }}');
    </script>
    {% endif %}
</head>
<body>

{# ── HEADER ── #}
{% include 'themes/wab/_header.html.twig' %}

{# ── BODY ── #}
<main>
    {% for msg in app.flashes('contact_s') %}
        <div class="container"><div class="flash flash-success">{{ msg }}</div></div>
    {% endfor %}
    {% for msg in app.flashes('contact_f') %}
        <div class="container"><div class="flash flash-error">{{ msg }}</div></div>
    {% endfor %}
    {% block body %}{% endblock %}
</main>

{# ── FOOTER ── #}
{% include 'themes/wab/_footer.html.twig' %}

<!-- Global Scripts -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js" defer></script>

{% block javascripts %}{% endblock %}
<script>
// ── Theme Toggle Script ───────────────────────────────────────────────────────
const MODES = ['dark', 'light', 'auto'];
const MODE_LABELS = {
    dark:  '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px"><path d="M21 12.79A9 9 0 1111.21 3a7 7 0 0010 9.79z"/></svg> Escuro',
    light: '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg> Claro',
    auto:  '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px"><path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zm0 2v16a8 8 0 0 1 0-16z"/></svg> Auto'
};

function applyTheme(mode) {
    const dark = mode === 'auto'
        ? window.matchMedia('(prefers-color-scheme: dark)').matches
        : mode === 'dark';
    document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
    if (dark) {
        document.documentElement.classList.add('dark');
    } else {
        document.documentElement.classList.remove('dark');
    }
    localStorage.setItem('wab-theme', mode);
    const btn = document.getElementById('wab-theme-btn');
    if (btn) btn.innerHTML = MODE_LABELS[mode];
}

function cycleTheme() {
    const cur = localStorage.getItem('wab-theme') || 'auto';
    const next = MODES[(MODES.indexOf(cur) + 1) % MODES.length];
    applyTheme(next);
}

// Sync button label on load
document.addEventListener('DOMContentLoaded', () => {
    const cur = localStorage.getItem('wab-theme') || 'auto';
    const btn = document.getElementById('wab-theme-btn');
    if (btn) btn.innerHTML = MODE_LABELS[cur];

    // Init AOS animations
    setTimeout(function() {
        if (typeof AOS !== 'undefined') {
            AOS.init({ duration: 800, once: true, offset: 80 });
        }
    }, 100);
});

// Listen for system preference changes
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if ((localStorage.getItem('wab-theme') || 'auto') === 'auto') applyTheme('auto');
});

document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('active');
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.1, rootMargin: "0px 0px -50px 0px" });

    document.querySelectorAll('.reveal-up, .fade-in, .scale-in').forEach(el => observer.observe(el));
});
</script>
</body>
</html>

