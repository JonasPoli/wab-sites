{% set config = block.config ?? {} %}
{% set stats_list = [] %}
{% if config.stats is defined and config.stats is iterable %}
    {% for s in config.stats %}
        {% if s.number is defined and s.number %}
            {% set stats_list = stats_list|merge([{
                'number': s.number,
                'label': s.label ?? null,
                'description': s.description ?? null
            }]) %}
        {% endif %}
    {% endfor %}
{% endif %}

{% if stats_list|length == 0 %}
    {% for i in 1..4 %}
        {% set num = config['stat' ~ i ~ '_number'] ?? null %}
        {% if num %}
            {% set stats_list = stats_list|merge([{
                'number': num,
                'label': config['stat' ~ i ~ '_label'] ?? null,
                'description': config['stat' ~ i ~ '_description'] ?? null
            }]) %}
        {% endif %}
    {% endfor %}
{% endif %}

{% set has_stats = stats_list|length > 0 %}
{% if block.title or block.text or block.preTitle or has_stats %}
<div class="wab-block" style="padding: 5rem 0;">
    {% if block.preTitle %}
        <div style="text-align:center">
            <span class="section-label" style="color: var(--color-primary); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.9rem;">
                {{ block.preTitle }}
            </span>
        </div>
    {% endif %}
    {% if block.title %}
        <h2 class="section-heading" style="text-align:center; margin-bottom:1.25rem; font-size:clamp(2rem, 4vw, 2.75rem); font-weight:800; letter-spacing:-0.02em; color:var(--text); line-height: 1.1;">
            {{ block.title }}
        </h2>
    {% endif %}
    {% if block.text %}
        <p style="color:var(--text-muted); text-align:center; max-width:720px; margin:0 auto 3.5rem; font-size:1.05rem; line-height:1.6;">
            {{ block.text }}
        </p>
    {% endif %}
    
    {% if has_stats %}
    <div class="wab-stats" style="--columns: {{ stats_list|length }};">
        {% for s in stats_list %}
        <div class="stat-card">
            <div class="stat-num">{{ s.number }}</div>
            {% if s.label %}<div class="stat-lbl">{{ s.label }}</div>{% endif %}
            {% if s.description %}<div class="stat-desc">{{ s.description }}</div>{% endif %}
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
<style>
.wab-stats {
    display: grid;
    grid-template-columns: repeat(var(--columns, 4), 1fr);
    background: var(--bg-card, #ffffff);
    border: 1px solid var(--border);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.01);
    margin: 4rem auto 0;
    max-width: 42rem;
}
@media (min-width: 640px) {
    .wab-stats {
        margin-top: 5rem;
    }
}
@media (min-width: 1024px) {
    .wab-stats {
        margin-top: 6rem;
        max-width: 56rem;
    }
}
.stat-card {
    padding: 3.5rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}
.stat-card:not(:last-child) {
    border-right: 1px solid var(--border);
}
.stat-num {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--text);
    line-height: 1;
    margin-bottom: 0.75rem;
    letter-spacing: -0.03em;
}
.stat-lbl {
    font-weight: 500;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.4;
    max-width: 220px;
}
.stat-desc {
    color: var(--text-muted);
    font-size: 0.8rem;
    margin-top: 0.35rem;
    opacity: 0.75;
}
@media (max-width: 992px) {
    .wab-stats {
        grid-template-columns: repeat(2, 1fr);
    }
    .stat-card {
        border-right: none !important;
        border-bottom: 1px solid var(--border);
        padding: 3rem 1.5rem;
    }
    .stat-card:nth-child(odd) {
        border-right: 1px solid var(--border) !important;
    }
    .stat-card:nth-child(3), .stat-card:nth-child(4) {
        border-bottom: none;
    }
}
@media (max-width: 576px) {
    .wab-stats {
        grid-template-columns: 1fr;
    }
    .stat-card {
        border-right: none !important;
        border-bottom: 1px solid var(--border) !important;
        padding: 2.5rem 1.25rem;
    }
    .stat-card:last-child {
        border-bottom: none !important;
    }
}
</style>
{% endif %}
