{% set config = block.config ?? {} %}
{% set items_list = [] %}
{% if config.items is defined and config.items is iterable %}
    {% for it in config.items %}
        {% if it.title is defined and it.title %}
            {% set items_list = items_list|merge([{
                'icon': it.icon ?? null,
                'title': it.title,
                'text': it.text ?? null
            }]) %}
        {% endif %}
    {% endfor %}
{% endif %}

{% if items_list|length == 0 %}
    {% for i in 1..4 %}
        {% set title = config['item' ~ i ~ '_title'] ?? null %}
        {% if title %}
            {% set items_list = items_list|merge([{
                'icon': config['item' ~ i ~ '_icon'] ?? null,
                'title': title,
                'text': config['item' ~ i ~ '_text'] ?? null
            }]) %}
        {% endif %}
    {% endfor %}
{% endif %}

{% set has_items = items_list|length > 0 %}
{% if block.title or block.text or block.preTitle or has_items %}
<div class="wab-block" style="padding: 4rem 0;">
    {% if block.preTitle %}
        <div style="text-align:center">
            <span class="section-label" style="color: var(--color-primary); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.9rem;">
                {{ block.preTitle }}
            </span>
        </div>
    {% endif %}
    {% if block.title %}
        <h2 class="section-heading" style="text-align:center; margin-bottom:1.25rem; font-size:clamp(2rem, 4vw, 2.75rem); font-weight:800; letter-spacing:-0.02em; color:var(--text); line-height: 1.1;">
            {{ block.title }}
        </h2>
    {% endif %}
    {% if block.text %}
        <p style="color:var(--text-muted); text-align:center; max-width:720px; margin:0 auto 3.5rem; font-size:1.05rem; line-height:1.6;">
            {{ block.text }}
        </p>
    {% endif %}
    
    {% if has_items %}
    <div class="wab-blurbs4">
        {% for it in items_list %}
        <div class="b4-card">
            {% if it.icon %}
            <div class="b4-icon">
                <i class="{{ it.icon }}"></i>
            </div>
            {% endif %}
            <div class="b4-content">
                <h3 class="b4-title">{{ it.title }}</h3>
                {% if it.text %}<p class="b4-text">{{ it.text }}</p>{% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>
<style>
.wab-blurbs4 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem 2.5rem;
    margin: 4rem auto 0;
    max-width: 42rem;
}
@media (min-width: 640px) {
    .wab-blurbs4 {
        margin-top: 5rem;
    }
}
@media (min-width: 1024px) {
    .wab-blurbs4 {
        margin-top: 6rem;
        max-width: 56rem;
    }
}
.b4-card { display:flex; gap:1.25rem; align-items:flex-start; }
.b4-icon { width:48px; height:48px; background:linear-gradient(135deg, var(--color-primary), var(--color-secondary)); color:#fff; border-radius:12px; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:1.25rem; box-shadow: 0 4px 14px rgba(var(--color-primary-rgb),.2); }
.b4-content { flex:1; }
.b4-title { font-size:1.1rem; font-weight:700; color:var(--text); margin:0 0 0.4rem 0; line-height:1.3; }
.b4-text { color:var(--text-muted); font-size:0.95rem; line-height:1.6; margin:0; }
@media(max-width:768px){ .wab-blurbs4 { grid-template-columns:1fr; gap:2rem; } }
</style>
{% endif %}
